---
import type { CollectionEntry } from 'astro:content';
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import CookieBanner from '../components/CookieBanner.astro';
import Header from '../components/Header.astro';
import FormattedDate from '../components/FormattedDate.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import BackToTop from '../components/BackToTop.astro';
import CommentsSection from '../components/CommentsSection.astro';
import ExitIntentPopup from '../components/ExitIntentPopup.astro';
import SocialProofBar from '../components/SocialProofBar.astro';
import ArticleCTA from '../components/ArticleCTA.astro';
import { getAuthor } from '../data/authors';

type Props = CollectionEntry<'blog'>['data'] & { id?: string, audio?: string, audioTitle?: string };

const { title, description, pubDate, updatedDate, image, category, author, authorUrl, id, audio, audioTitle } = Astro.props;
const authorData = getAuthor(author || 'atlas');

// Get related posts (same category)
const allPosts = await getCollection('blog');
const relatedPosts = allPosts
  .filter(post => post.data.category === category && post.id !== id)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={title} description={description} />
		<meta property="og:type" content="article" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="twitter:card" content="summary_large_image" />
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "BlogPosting",
			headline: title,
			description: description,
			author: {
				"@type": "Person",
				name: author,
				url: authorUrl
			},
			publisher: {
				"@type": "Organization",
				name: "CC3PO",
				logo: {
					"@type": "ImageObject",
					url: "https://insights.cc3po.com/images/cc3po-logo.png"
				}
			},
			datePublished: pubDate,
			dateModified: updatedDate || pubDate,
			articleSection: category
		})} />
		<style>
			:root {
				--bg: #0a0a0b;
				--card: #141418;
				--text: #fff;
				--muted: #d4d4d8;
				--primary: #e94560;
				--accent: #4fc3f7;
				--grad: #e94560;
			}

			* { margin: 0; padding: 0; box-sizing: border-box; }

			body {
				font-family: Inter, system-ui, -apple-system, sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.7;
			}

			/* Article Header */
			.article-header {
				text-align: center;
				padding: 120px 24px 40px;
				max-width: 800px;
				margin: 0 auto;
			}

			.category-badge {
				display: inline-block;
				background: var(--grad);
				padding: 6px 16px;
				border-radius: 20px;
				font-size: 12px;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
				color: #fff;
				margin-bottom: 20px;
			}

			.article-title {
				font-size: clamp(32px, 5vw, 48px);
				font-weight: 800;
				line-height: 1.15;
				margin-bottom: 20px;
				background: linear-gradient(135deg, #fff, #e4e4e7);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				background-clip: text;
			}

			.article-excerpt {
				font-size: 18px;
				color: #d4d4d8;
				line-height: 1.6;
				margin-bottom: 24px;
			}

			/* Author Block */
			.author-block {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 16px;
				padding: 20px;
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(255,255,255,.06);
				border-radius: 16px;
				margin: 0 auto 40px;
				max-width: fit-content;
			}

			.author-link-block {
				display: flex;
				align-items: center;
				gap: 16px;
				text-decoration: none;
				transition: all 0.2s;
			}

			.author-link-block:hover {
				opacity: 0.85;
			}

			.author-avatar {
				width: 48px;
				height: 48px;
				border-radius: 50%;
				background: var(--grad);
				display: flex;
				align-items: center;
				justify-content: center;
				font-size: 20px;
				font-weight: 700;
				color: #fff;
			}

			.author-info {
				text-align: left;
			}

			.author-name {
				font-size: 15px;
				font-weight: 600;
				color: #fff;
			}

			.author-title {
				font-size: 13px;
				color: #d4d4d8;
			}

			.article-meta {
				display: flex;
				align-items: center;
				justify-content: center;
				gap: 16px;
				flex-wrap: wrap;
				color: #d4d4d8;
				font-size: 14px;
			}
			.audio-narration {
				background: linear-gradient(135deg, #1a1535, #0f2a3a);
				border: 1px solid rgba(107, 53, 255, 0.4);
				border-radius: 16px;
				padding: 16px 20px;
				margin-bottom: 24px;
				box-shadow: 0 0 20px rgba(107, 53, 255, 0.1);
				max-width: 100%;
				overflow: hidden;
			}
			.audio-label {
				font-size: 14px;
				color: #4fc3f7;
				font-weight: 600;
				margin-bottom: 8px;
				display: flex;
				align-items: center;
				gap: 6px;
			}
			.audio-icon {
				font-size: 18px;
			}
			audio {
				width: 100%;
				border-radius: 12px;
				outline: none;
			}

			.meta-divider {
				width: 4px;
				height: 4px;
				border-radius: 50%;
				background: #52525b;
			}

			/* Hero Image */
			.hero-image-wrapper {
				max-width: 1200px;
				margin: 0 auto 60px;
				padding: 0 24px;
			}

			.hero-image {
				width: 100%;
				border-radius: 20px;
				overflow: hidden;
			}

			.hero-image img {
				width: 100%;
				height: auto;
				display: block;
			}

			/* Article Content */
			.article-container {
				display: flex;
				gap: 60px;
				max-width: 1200px;
				margin: 0 auto;
				padding: 0 24px 80px;
				overflow-x: hidden;
			}

			.article-content {
				flex: 1;
				max-width: 720px;
				min-width: 0;
				overflow-x: hidden;
			}

			/* Social Share Sidebar */
			.social-sidebar {
				position: sticky;
				top: 120px;
				width: 60px;
				height: fit-content;
			}

			.social-shade {
				display: flex;
				flex-direction: column;
				gap: 12px;
			}

			.social-btn {
				width: 44px;
				height: 44px;
				border-radius: 12px;
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(255,255,255,.06);
				display: flex;
				align-items: center;
				justify-content: center;
				color: #d4d4d8;
				cursor: pointer;
				transition: all 0.2s;
			}

			.social-btn:hover {
				background: rgba(107,53,255,.1);
				border-color: rgba(107,53,255,.3);
				color: #e94560;
				transform: translateY(-2px);
			}

			.social-btn.whatsapp:hover {
				background: rgba(37,211,102,.1);
				border-color: rgba(37,211,102,.3);
				color: #25d366;
			}

			.social-btn.reddit:hover {
				background: rgba(255,69,0,.1);
				border-color: rgba(255,69,0,.3);
				color: #ff4500;
			}

			/* Prose Styles */
			.prose {
				color: #d4d4d8;
				font-size: 17px;
				line-height: 1.8;
				overflow-x: hidden;
				word-break: break-word;
			}

			.prose p {
				margin-bottom: 24px;
			}

			.prose h2 {
				font-size: 28px;
				font-weight: 700;
				color: #fff;
				margin: 48px 0 20px;
				padding-bottom: 12px;
				border-bottom: 1px solid rgba(255,255,255,.06);
			}

			.prose h3 {
				font-size: 22px;
				font-weight: 600;
				color: #fff;
				margin: 36px 0 16px;
			}

			.prose a {
				color: #4fc3f7;
				text-decoration: none;
				border-bottom: 1px solid rgba(0,210,255,.3);
				transition: border-color 0.2s;
			}

			.prose a:hover {
				border-color: #4fc3f7;
			}

			.prose ul, .prose ol {
				margin: 20px 0;
				padding-left: 28px;
			}

			.prose li {
				margin-bottom: 12px;
			}

			.prose blockquote {
				border-left: 4px solid var(--primary);
				padding: 20px 24px;
				margin: 28px 0;
				background: linear-gradient(135deg, rgba(107,53,255,.05), rgba(0,210,255,.05));
				border-radius: 0 12px 12px 0;
				font-style: italic;
			}

			.prose blockquote p {
				margin: 0;
				color: #d4d4d8;
			}

			.prose code {
				background: rgba(107,53,255,.1);
				padding: 3px 8px;
				border-radius: 6px;
				font-size: 15px;
				color: #4fc3f7;
			}

			.prose pre {
				background: #141418;
				padding: 20px;
				border-radius: 12px;
				overflow-x: auto;
				margin: 24px 0;
				border: 1px solid rgba(255,255,255,.06);
				max-width: 100%;
				white-space: pre-wrap;
				word-break: break-all;
			}

			.prose pre code {
				background: none;
				padding: 0;
				color: #d4d4d8;
			}

			.prose img {
				width: 100%;
				border-radius: 12px;
				margin: 24px 0;
			}

			/* Author Bio Footer */
			.author-bio-footer {
				margin: 60px 0 40px;
				padding: 32px;
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(107,53,255,.15);
				border-radius: 20px;
			}

			.author-bio-content {
				display: flex;
				gap: 20px;
				align-items: flex-start;
			}

			.author-bio-avatar {
				width: 72px;
				height: 72px;
				border-radius: 12px;
				overflow: hidden;
				background: transparent;
				display: flex;
				align-items: center;
				justify-content: center;
				flex-shrink: 0;
			}
			
			.author-bio-avatar img {
				width: 100%;
				height: 100%;
				object-fit: cover;
			}

			.author-bio-text h4 {
				font-size: 18px;
				font-weight: 700;
				margin-bottom: 8px;
			}

			.author-bio-text p {
				font-size: 15px;
				color: #d4d4d8;
				line-height: 1.6;
				margin-bottom: 16px;
			}

			.author-links {
				display: flex;
				gap: 16px;
			}

			.author-links a {
				color: #e94560;
				text-decoration: none;
				font-size: 14px;
				font-weight: 500;
			}

			.author-links a:hover {
				color: #4fc3f7;
			}

			/* Related Posts */
			.related-posts {
				margin-top: 60px;
				padding-top: 40px;
				border-top: 1px solid rgba(255,255,255,.06);
			}

			.related-posts h3 {
				font-size: 20px;
				font-weight: 700;
				margin-bottom: 24px;
				display: flex;
				align-items: center;
				gap: 12px;
			}

			.related-posts h3::after {
				content: '';
				flex: 1;
				height: 1px;
				background: linear-gradient(90deg, rgba(107,53,255,.3), transparent);
			}

			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 20px;
			}

			.related-card {
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(255,255,255,.06);
				border-radius: 14px;
				overflow: hidden;
				transition: all 0.3s;
			}

			.related-card:hover {
				border-color: rgba(107,53,255,.3);
				transform: translateY(-4px);
			}

			.related-card a {
				text-decoration: none;
				display: block;
				padding: 20px;
			}

			.related-card span {
				font-size: 12px;
				color: #e94560;
				font-weight: 600;
				text-transform: uppercase;
				letter-spacing: 0.5px;
			}

			.related-card h4 {
				font-size: 15px;
				font-weight: 600;
				color: #fff;
				margin-top: 8px;
				line-height: 1.4;
			}

			/* Back Link */
			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 12px 20px;
				background: rgba(255,255,255,.05);
				border: 1px solid rgba(255,255,255,.08);
				border-radius: 12px;
				color: #d4d4d8;
				text-decoration: none;
				font-size: 14px;
				font-weight: 500;
				margin-bottom: 24px;
				transition: all 0.2s;
			}

			.back-link:hover {
				background: rgba(107,53,255,.1);
				border-color: rgba(107,53,255,.3);
				color: #fff;
			}

			/* Responsive */
			@media (max-width: 1024px) {
				.social-sidebar {
					display: none;
				}
			}

			@media (max-width: 768px) {
				.article-header {
					padding: 80px 16px 24px;
				}

				.article-title {
					font-size: 24px;
				}

				.author-block {
					flex-direction: column;
					text-align: center;
					padding: 16px;
				}

				.author-meta {
					flex-direction: column;
					gap: 8px;
				}

				.meta-divider {
					display: none;
				}

				.author-info {
					text-align: center;
				}

				.article-container {
					padding: 0 16px 60px;
					gap: 0;
				}

				.article-content {
					max-width: 100%;
					overflow-x: hidden;
				}

				.prose {
					font-size: 16px;
					max-width: 100%;
					overflow-x: hidden;
					word-break: break-word;
				}

				.prose pre {
					max-width: 100%;
					overflow-x: auto;
					white-space: pre-wrap;
					word-break: break-all;
				}

				.audio-narration {
					max-width: 100%;
					overflow: hidden;
				}

				.audio-narration audio {
					max-width: 100%;
				}

				.hero-image-wrapper {
					padding: 0 8px 32px;
					max-width: 100%;
					overflow: hidden;
				}

				.hero-image img {
					border-radius: 12px;
				}

				/* Larger touch targets on mobile */
				.social-btn {
					width: 48px;
					height: 48px;
				}

				.author-bio-footer {
					padding: 20px 16px;
					border-radius: 12px;
				}

				.author-bio-content {
					flex-direction: column;
					align-items: center;
					text-align: center;
				}

				.related-grid {
					grid-template-columns: 1fr;
				}

				/* Larger tap targets for links on mobile */
				.prose a {
					padding: 2px 0;
				}

				.back-link {
					padding: 16px 24px;
					font-size: 15px;
				}

				.category-badge {
					padding: 6px 14px;
					font-size: 12px;
				}

				.related-card a {
					padding: 16px;
				}
			}
		</style>
	</head>

	<body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
		<BackToTop />
		<ExitIntentPopup />
		<Header />

		<main id="main-content">
		<header class="article-header">
			<span class="category-badge">{category}</span>
			<h1 class="article-title">{title}</h1>
			<p class="article-excerpt">{description}</p>

			<div class="author-block">
				<a href={`/village/${authorData.id}/`} class="author-link-block">
					<div class="author-avatar"><img src={authorData.photo} alt={authorData.name} style="width: 100%; height: 100%; object-fit: cover; border-radius: 50%;" /></div>
					<div class="author-info">
						<div class="author-name">{authorData.name} {authorData.emoji}</div>
						<div class="author-title">{authorData.role} • CC3PO Village</div>
					</div>
				</a>
			</div>

			<div class="article-meta">
				<FormattedDate date={pubDate} />
				<div class="meta-divider"></div>
				<span>CC3PO Insights</span>
			</div>
		</header>

		<!-- Social Proof Bar -->
		<SocialProofBar 
			readLabel="business owners read this today"
			readingTime={Math.ceil((title + ' ' + description).split(/\s+/).length / 200) + ' min'}
			category={category}
		/>

		{audio && (
			<div class="audio-narration">
				<div class="audio-label"><span class="audio-icon">♪</span> Listen to {authorData.name} {authorData.emoji} narrate this article</div>
				<audio controls preload="metadata" style="width: 100%; border-radius: 12px; margin-top: 8px;">
					<source src={audio} type="audio/mpeg" />
					Your browser does not support audio.
				</audio>
			</div>
		)}

		{image && (
			<div class="hero-image-wrapper">
				<div class="hero-image">
					<img 
						src={image.startsWith('/') ? image : image} 
						srcset={image.endsWith('.png') ? `${image.replace('.png', '.webp')} 800w, ${image} 1200w` : undefined}
						sizes="(max-width: 768px) 100vw, 1200px"
						alt={title} 
						width="1200" 
						height="630" 
						loading="lazy" 
					/>
				</div>
			</div>
		)}

		<div class="article-container">
			<!-- Social Share Sidebar -->
			<aside class="social-sidebar">
				<div class="social-share">
					<a 
						href={`https://twitter.com/intent/tweet?text=${encodeURIComponent(title)}&url=${encodeURIComponent(Astro.url)}`}
						target="_blank"
						class="social-btn"
						aria-label="Share on Twitter"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"></path>
						</svg>
					</a>
					<a 
						href={`https://www.linkedin.com/shareArticle?mini=true&url=${encodeURIComponent(Astro.url)}&title=${encodeURIComponent(title)}`}
						target="_blank"
						class="social-btn"
						aria-label="Share on LinkedIn"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path>
							<rect x="2" y="9" width="4" height="12"></rect>
							<circle cx="4" cy="4" r="2"></circle>
						</svg>
					</a>
					<a 
						href={`https://www.facebook.com/sharer/sharer.php?u=${encodeURIComponent(Astro.url)}`}
						target="_blank"
						class="social-btn"
						aria-label="Share on Facebook"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path>
						</svg>
					</a>
					<a 
						href={`https://wa.me/?text=${encodeURIComponent(title + ' — ' + Astro.url)}`}
						target="_blank"
						class="social-btn whatsapp"
						aria-label="Share on WhatsApp"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
						</svg>
					</a>
					<a 
						href={`https://reddit.com/submit?url=${encodeURIComponent(Astro.url)}&title=${encodeURIComponent(title)}`}
						target="_blank"
						class="social-btn reddit"
						aria-label="Share on Reddit"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor">
							<path d="M12 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0zm5.01 4.744c.688 0 1.25.562 1.25 1.25 0 .688-.562 1.25-1.25 1.25a1.25 1.25 0 0 1-1.25-1.25c0-.688.562-1.25 1.25-1.25zm-4.69 2.662a5.895 5.895 0 0 1 4.273 1.862 4.754 4.754 0 0 1 1.873-.393c.735 0 1.414.178 1.98.473a3.863 3.863 0 0 0-2.248 3.502c0 2.168 1.733 4.238 4.51 4.238-.22.516-.545.992-.975 1.402a5.413 5.413 0 0 1-3.665 1.372c-1.57 0-2.998-.613-4.073-1.625a5.413 5.413 0 0 1-4.073 1.625 5.413 5.413 0 0 1-3.665-1.372c-.43-.41-.755-.886-.975-1.402 2.777 0 4.51-2.07 4.51-4.238a3.863 3.863 0 0 0-2.248-3.502c.566-.295 1.245-.473 1.98-.473a4.754 4.754 0 0 1 1.873.393 5.895 5.895 0 0 1 4.273-1.862z"/>
						</svg>
					</a>
					<a 
						href={`mailto:?subject=${encodeURIComponent(title)}&body=${encodeURIComponent(`Check out this article: ${Astro.url}`)}`}
						class="social-btn"
						aria-label="Share via Email"
					>
						<svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
							<path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
							<polyline points="22,6 12,13 2,6"></polyline>
						</svg>
					</a>
				</div>
			</aside>

			<article class="article-content" id="article-content">
				<a href="/signal/" class="back-link">← Back to Signal</a>

				<div class="prose" id="prose-content">
					<slot />
				</div>

				<!-- Author Bio Footer -->
				<div class="author-bio-footer">
					<div class="author-bio-content">
						<div class="author-bio-avatar">
							<img src={authorData.photo} alt={authorData.name} style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" />
						</div>
						<div class="author-bio-text">
							<h4>About {authorData.name} {authorData.emoji}</h4>
							<p><em>"{authorData.quote}"</em></p>
							<p>{authorData.bio} — {authorData.role}, CC3PO Village.</p>
							<div class="author-links">
								<a href={`/village/${authorData.id}/`} target="_blank" rel="noopener">More from {authorData.name} →</a>
								<a href="/village/" target="_blank" rel="noopener">Meet the Village →</a>
							</div>
						</div>
					</div>
				</div>

				<!-- Newsletter Signup -->
				<NewsletterSignup variant="inline" />

				<!-- Related Posts -->
				{relatedPosts.length > 0 && (
					<div class="related-posts">
						<h3>Related Articles</h3>
						<div class="related-grid">
							{relatedPosts.map(post => (
								<article class="related-card">
									<a href={`/blog/${post.id}/`}>
										<span>{post.data.category}</span>
										<h4>{post.data.title}</h4>
									</a>
								</article>
							))}
						</div>
					</div>
				)}

				<!-- Action CTA -->
				<ArticleCTA variant="scan" />

				<!-- Comments Section -->
				<CommentsSection postSlug={id || ''} postTitle={title} />
			</article>
		</div>

		</main>
		<Footer />
		<CookieBanner />
	</body>
</html>