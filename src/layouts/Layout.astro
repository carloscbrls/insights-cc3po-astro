---
import '../styles/global.css';

const { title = 'CC3PO — Compliance & Business Tools' } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="CC3PO — ADA/WCAG compliance monitoring, AI voice agents, and business tools for trades and service businesses." />
    <title>{title}</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  </head>
  <body class="bg-[#08080d] text-gray-200 font-sans antialiased min-h-screen flex flex-col">
    <!-- Navigation -->
    <header class="border-b border-gray-800">
      <nav class="max-w-6xl mx-auto px-4 py-4 flex items-center justify-between">
        <a href="/" class="text-xl font-bold text-white tracking-tight">
          CC<span class="text-emerald-400">3</span>PO
        </a>
        <div class="flex items-center gap-6 text-sm">
          <a href="/" class="text-gray-400 hover:text-white transition">Home</a>
          <a href="/agency/" class="text-gray-400 hover:text-white transition">Agency</a>
          <div class="relative group">
            <button class="text-gray-400 hover:text-white transition flex items-center gap-1">
              Products
              <svg class="w-3 h-3 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7"/></svg>
            </button>
            <div class="absolute left-0 top-full mt-1 w-56 bg-[#0f0f1a] border border-gray-800 rounded-lg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all duration-200 z-50">
              <div class="py-2">
                <a href="/products/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">All Products</a>
                <div class="border-t border-gray-800 my-1"></div>
                <a href="/products/shield/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Compliance Shield</a>
                <a href="/products/shield-pro/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Compliance Shield Pro</a>
                <a href="/products/compliance-pack/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Compliance Pack</a>
                <a href="/products/badge/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Compliance Badge</a>
                <a href="/products/voice-agent/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">AI Voice Agent</a>
                <a href="/products/visible-ai/" class="block px-4 py-2 text-sm text-emerald-400 hover:text-white hover:bg-gray-800/50 transition">VisibleAI 🆕</a>
                <a href="/products/website-monitoring/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Website Monitoring</a>
                <a href="/products/quote-generator/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Quote Generator</a>
                <a href="/products/scan/" class="block px-4 py-2 text-sm text-gray-400 hover:text-white hover:bg-gray-800/50 transition">Free Business Scan</a>
                <div class="border-t border-gray-800 my-1"></div>
                <a href="/products/disclose-shield/" class="block px-4 py-2 text-sm text-amber-400 hover:text-white hover:bg-gray-800/50 transition">DiscloseShield 🆕</a>
              </div>
            </div>
          </div>
          <a href="/products/scan/" class="text-gray-400 hover:text-white transition">Free Scan</a>
          <a href="https://partners.cc3po.com" class="text-gray-400 hover:text-white transition">Partners</a>
          <a href="https://sign.cc3po.com" class="text-gray-400 hover:text-white transition">Sign In</a>
        </div>
      </nav>
    </header>

    <!-- Main Content -->
    <main class="flex-1">
      <slot />
    </main>

    <!-- Footer -->
    <footer class="border-t border-gray-800 bg-[#0a0a12]">
      <div class="max-w-6xl mx-auto px-4 py-12">
        <div class="grid grid-cols-1 md:grid-cols-4 gap-8">
          <div>
            <h3 class="text-lg font-bold text-white mb-4">CC<span class="text-emerald-400">3</span>PO</h3>
            <p class="text-sm text-gray-500">Compliance, voice AI, and business tools for trades and service businesses.</p>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Compliance</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/products/shield/" class="text-gray-500 hover:text-emerald-400 transition">Compliance Shield</a></li>
              <li><a href="/products/shield-pro/" class="text-gray-500 hover:text-emerald-400 transition">Compliance Shield Pro</a></li>
              <li><a href="/products/compliance-pack/" class="text-gray-500 hover:text-emerald-400 transition">Compliance Pack</a></li>
              <li><a href="/products/badge/" class="text-gray-500 hover:text-emerald-400 transition">Compliance Badge</a></li>
              <li><a href="/products/scan/" class="text-gray-500 hover:text-emerald-400 transition">Free Business Scan</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Business Tools</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/products/voice-agent/" class="text-gray-500 hover:text-emerald-400 transition">AI Voice Agent</a></li>
              <li><a href="/products/website-monitoring/" class="text-gray-500 hover:text-emerald-400 transition">Website Monitoring</a></li>
              <li><a href="/products/quote-generator/" class="text-gray-500 hover:text-emerald-400 transition">Quote Generator</a></li>
              <li><a href="https://partners.cc3po.com" class="text-gray-500 hover:text-emerald-400 transition">Partner Program</a></li>
              <li><a href="https://sign.cc3po.com" class="text-gray-500 hover:text-emerald-400 transition">Signature Portal</a></li>
            </ul>
          </div>
          <div>
            <h4 class="text-sm font-semibold text-gray-400 uppercase tracking-wider mb-3">Company</h4>
            <ul class="space-y-2 text-sm">
              <li><a href="/" class="text-gray-500 hover:text-emerald-400 transition">Home</a></li>
              <li><a href="/agency/" class="text-gray-500 hover:text-emerald-400 transition">Agency</a></li>
              <li><a href="/products/" class="text-gray-500 hover:text-emerald-400 transition">All Products</a></li>
            </ul>
          </div>
        </div>
        <div class="border-t border-gray-800 mt-8 pt-8 text-center text-sm text-gray-600">
          &copy; 2026 CC3PO. All rights reserved.
        </div>
      </div>
    </footer>
  </body>
</html>
