---
export interface Props {
  src: string;
  agentName: string;
  agentEmoji: string;
}

const { src, agentName, agentEmoji } = Astro.props;
---

<div class="audio-player-wrap">
  <div class="audio-label">
    <span>{agentEmoji}</span>
    <span>Hear {agentName} introduce themselves</span>
  </div>
  <audio controls class="audio-player" preload="metadata">
    <source src={src} type="audio/mpeg" />
    Your browser doesn't support audio playback.
  </audio>
</div>

<style>
  .audio-player-wrap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin: 0 auto 32px;
    max-width: 400px;
  }
  .audio-label {
    font-size: 0.85rem;
    color: #a1a1aa;
    display: flex;
    align-items: center;
    gap: 8px;
  }
  .audio-player {
    width: 100%;
    height: 40px;
    border-radius: 8px;
    background: #141418;
  }
  .audio-player::-webkit-media-controls-panel {
    background: #1a1a20;
  }
</style>