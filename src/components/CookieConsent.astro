<div id="cookie-consent" class="cookie-banner" role="dialog" aria-label="Cookie consent" aria-describedby="cookie-text">
  <p id="cookie-text" class="cookie-text">
    We use <strong>privacy-first analytics only</strong> — no tracking cookies, no personal data sold.
    <a href="/privacy/" class="cookie-link">Learn more</a>
  </p>
  <div class="cookie-buttons">
    <button id="cookie-accept" class="cookie-btn cookie-btn-primary" aria-label="Accept cookies">Got it</button>
  </div>
</div>

<style>
  .cookie-banner {
    position: fixed;
    bottom: 0;
    left: 0;
    right: 0;
    background: #141418;
    border-top: 1px solid rgba(255,255,255,0.1);
    padding: 16px 24px;
    display: none;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    z-index: 9999;
    box-shadow: 0 -4px 20px rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
  }

  .cookie-text {
    color: #d4d4d8;
    font-size: 14px;
    line-height: 1.5;
    flex: 1;
  }

  .cookie-link {
    color: #4fc3f7;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }

  .cookie-buttons {
    display: flex;
    gap: 10px;
    flex-shrink: 0;
  }

  .cookie-btn {
    padding: 10px 20px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s;
    min-height: 44px;
    display: flex;
    align-items: center;
  }

  .cookie-btn-primary {
    background: #e94560;
    color: #fff;
    border: none;
  }

  .cookie-btn-primary:hover {
    background: #d13d55;
  }

  @media (max-width: 640px) {
    .cookie-banner {
      flex-direction: column;
      padding: 16px;
      gap: 12px;
    }
    .cookie-buttons {
      width: 100%;
    }
    .cookie-btn {
      justify-content: center;
      flex: 1;
    }
  }
</style>

<script>
if (!localStorage.getItem('cookie-consent')) {
  document.getElementById('cookie-consent').style.display = 'flex';
}
document.getElementById('cookie-accept').addEventListener('click', function() {
  localStorage.setItem('cookie-consent', 'accepted');
  document.getElementById('cookie-consent').style.display = 'none';
});
</script>