---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  featuredPost: CollectionEntry<'blog'>;
  latestPosts: CollectionEntry<'blog'>[];
}

const { featuredPost, latestPosts } = Astro.props;
---

<section class="blog-hero">
  <!-- Featured Post -->
  <div class="featured-post">
    <a href={`/blog/${featuredPost.id}/`} class="featured-link">
      <div class="featured-image-wrapper">
        {featuredPost.data.heroImage && (
          <Image 
            class="featured-image" 
            width={1200} 
            height={600} 
            src={featuredPost.data.heroImage} 
            alt={featuredPost.data.title} 
            loading="eager"
          />
        )}
        <div class="featured-overlay">
          <span class="featured-badge">Featured</span>
          <h1>{featuredPost.data.title}</h1>
          <p class="featured-excerpt">{featuredPost.data.description}</p>
          <span class="featured-cta">Read Article →</span>
        </div>
      </div>
    </a>
  </div>

  <!-- Latest Posts Horizontal Scroll -->
  <div class="latest-section">
    <div class="latest-header">
      <h2>Latest Signal</h2>
      <a href="/blog" class="view-all">View all →</a>
    </div>
    <div class="latest-scroll">
      {latestPosts.slice(0, 4).map((post) => (
        <article class="latest-card">
          <a href={`/blog/${post.id}/`}>
            <div class="latest-image-wrapper">
              {post.data.heroImage && (
                <Image 
                  class="latest-image" 
                  width={400} 
                  height={225} 
                  src={post.data.heroImage} 
                  alt={post.data.title}
                  loading="lazy"
                />
              )}
              <span class="latest-category">{post.data.category}</span>
            </div>
            <div class="latest-content">
              <h3>{post.data.title}</h3>
              <span class="read-time">{Math.ceil(post.body?.length / 1000) || 5} min read</span>
            </div>
          </a>
        </article>
      ))}
    </div>
  </div>

  <!-- Newsletter CTA -->
  <div class="hero-newsletter">
    <div class="newsletter-content">
      <h3>Catch the Signal</h3>
      <p>Join 1,000+ business owners catching signals that matter.</p>
    </div>
    <form class="newsletter-form" action="/api/subscribe" method="POST">
      <input type="email" name="email" placeholder="Enter your email" required />
      <button type="submit" aria-label="Subscribe to newsletter">Subscribe</button>
    </form>
  </div>
</section>

<style>
  .blog-hero {
    padding: 100px 24px 40px;
    max-width: 1400px;
    margin: 0 auto;
  }

  /* Featured Post */
  .featured-post {
    margin-bottom: 40px;
  }

  .featured-link {
    text-decoration: none;
    display: block;
  }

  .featured-image-wrapper {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    aspect-ratio: 21 / 9;
    min-height: 400px;
  }

  .featured-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .featured-link:hover .featured-image {
    transform: scale(1.03);
  }

  .featured-overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      180deg,
      rgba(10, 10, 11, 0) 0%,
      rgba(10, 10, 11, 0.6) 50%,
      rgba(10, 10, 11, 0.95) 100%
    );
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 48px;
    color: #fff;
  }

  .featured-badge {
    display: inline-block;
    background: linear-gradient(135deg, #6b35ff, #00d2ff);
    padding: 6px 14px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    width: fit-content;
    margin-bottom: 16px;
  }

  .featured-overlay h1 {
    font-size: clamp(28px, 4vw, 48px);
    font-weight: 800;
    line-height: 1.2;
    margin-bottom: 12px;
    max-width: 800px;
  }

  .featured-excerpt {
    font-size: clamp(15px, 1.5vw, 18px);
    color: #a1a1aa;
    max-width: 600px;
    margin-bottom: 20px;
    line-height: 1.6;
  }

  .featured-cta {
    color: #00d2ff;
    font-weight: 600;
    font-size: 15px;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    transition: gap 0.2s;
  }

  .featured-link:hover .featured-cta {
    gap: 12px;
  }

  /* Latest Posts Section */
  .latest-section {
    margin-bottom: 40px;
  }

  .latest-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 24px;
  }

  .latest-header h2 {
    font-size: 24px;
    font-weight: 700;
    color: #fff;
  }

  .view-all {
    color: #6b35ff;
    text-decoration: none;
    font-size: 14px;
    font-weight: 500;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: gap 0.2s;
  }

  .view-all:hover {
    gap: 8px;
  }

  .latest-scroll {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }

  .latest-card {
    background: linear-gradient(145deg, #141418, #0f0f11);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    overflow: hidden;
    transition: all 0.3s ease;
  }

  .latest-card:hover {
    transform: translateY(-4px);
    border-color: rgba(107, 53, 255, 0.3);
    box-shadow: 0 12px 40px rgba(107, 53, 255, 0.15);
  }

  .latest-card a {
    text-decoration: none;
    display: block;
  }

  .latest-image-wrapper {
    position: relative;
    aspect-ratio: 16 / 9;
    overflow: hidden;
  }

  .latest-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
  }

  .latest-card:hover .latest-image {
    transform: scale(1.05);
  }

  .latest-category {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(107, 53, 255, 0.9);
    padding: 4px 10px;
    border-radius: 12px;
    font-size: 11px;
    font-weight: 600;
    color: #fff;
  }

  .latest-content {
    padding: 16px;
  }

  .latest-content h3 {
    font-size: 15px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 8px;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .read-time {
    font-size: 12px;
    color: #71717a;
  }

  /* Newsletter CTA */
  .hero-newsletter {
    background: linear-gradient(135deg, rgba(107, 53, 255, 0.1), rgba(0, 210, 255, 0.05));
    border: 1px solid rgba(107, 53, 255, 0.2);
    border-radius: 20px;
    padding: 32px 40px;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 40px;
  }

  .newsletter-content h3 {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
  }

  .newsletter-content p {
    font-size: 14px;
    color: #a1a1aa;
    max-width: 400px;
  }

  .newsletter-form {
    display: flex;
    gap: 12px;
    min-width: 320px;
  }

  .newsletter-form input {
    flex: 1;
    padding: 14px 20px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 14px;
    transition: border-color 0.2s;
  }

  .newsletter-form input:focus {
    outline: none;
    border-color: #6b35ff;
  }

  .newsletter-form input::placeholder {
    color: #71717a;
  }

  .newsletter-form button {
    padding: 14px 28px;
    border-radius: 12px;
    background: linear-gradient(135deg, #6b35ff, #00d2ff);
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .newsletter-form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(107, 53, 255, 0.4);
  }

  /* Responsive */
  @media (max-width: 1200px) {
    .latest-scroll {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 768px) {
    .blog-hero {
      padding: 90px 16px 32px;
    }

    .featured-image-wrapper {
      aspect-ratio: 16 / 10;
      min-height: 300px;
    }

    .featured-overlay {
      padding: 24px;
    }

    .latest-scroll {
      grid-template-columns: 1fr;
    }

    .hero-newsletter {
      flex-direction: column;
      text-align: center;
      gap: 24px;
      padding: 24px;
    }

    .newsletter-form {
      width: 100%;
      min-width: auto;
      flex-direction: column;
    }
  }
</style>
