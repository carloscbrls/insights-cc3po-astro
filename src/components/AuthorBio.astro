---
/**
 * AuthorBio.astro
 * Author photo, name, bio, social links
 * Link to author archive
 * Call to action for more posts
 */

interface Props {
	name: string;
	bio?: string;
	avatar?: string;
	twitter?: string;
	linkedin?: string;
	url?: string;
}

const {
	name = 'Carlos Cabrales',
	bio = 'IT Consultant and AI Systems Architect with 15+ years of experience. Former Tesla AI team member who helped train Autopilot. Now helping small businesses leverage AI and automation to scale efficiently.',
	avatar = 'https://cc3po.com/wp-content/uploads/2025/04/carlos-cabrales-iii-scaled.jpg',
	twitter,
	linkedin = 'https://www.linkedin.com/in/carloscabrales',
	url = 'https://cc3po.com'
} = Astro.props;

const initials = name.split(' ').map(n => n[0]).join('').slice(0, 2);
---

<div class="author-bio">
	<div class="author-avatar">
		{avatar ? (
			<img src={avatar} alt={name} />
		) : (
			<span class="avatar-initials">{initials}</span>
		)}
	</div>
	<div class="author-content">
		<h4 class="author-name">{name}</h4>
		<p class="author-description">{bio}</p>
		<div class="author-links">
			{twitter && (
				<a href={twitter} target="_blank" rel="noopener noreferrer" class="author-link" aria-label="Twitter">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
					</svg>
					<span>Twitter</span>
				</a>
			)}
			{linkedin && (
				<a href={linkedin} target="_blank" rel="noopener noreferrer" class="author-link" aria-label="LinkedIn">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor">
						<path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/>
					</svg>
					<span>LinkedIn</span>
				</a>
			)}
			{url && (
				<a href={url} class="author-link view-all" aria-label="View all posts">
					<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
						<path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
						<polyline points="17 21 17 13 7 13 7 21"/>
						<polyline points="7 3 7 8 15 8"/>
					</svg>
					<span>View all posts</span>
				</a>
			)}
		</div>
	</div>
</div>

<style>
	.author-bio {
		display: flex;
		gap: 20px;
		padding: 24px;
		background: linear-gradient(145deg, #141418, #0f0f11);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 16px;
		margin: 40px 0;
	}

	.author-avatar {
		flex-shrink: 0;
		width: 80px;
		height: 80px;
		border-radius: 12px;
		overflow: hidden;
		background: linear-gradient(135deg, #6b35ff, #00d2ff);
		display: flex;
		align-items: center;
		justify-content: center;
	}

	.author-avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
	}

	.avatar-initials {
		font-size: 24px;
		font-weight: 700;
		color: #fff;
	}

	.author-content {
		flex: 1;
	}

	.author-name {
		font-size: 18px;
		font-weight: 700;
		color: #fff;
		margin-bottom: 8px;
	}

	.author-description {
		font-size: 14px;
		color: #a1a1aa;
		line-height: 1.6;
		margin-bottom: 12px;
	}

	.author-links {
		display: flex;
		flex-wrap: wrap;
		gap: 12px;
	}

	.author-link {
		display: inline-flex;
		align-items: center;
		gap: 6px;
		padding: 6px 12px;
		background: rgba(255, 255, 255, 0.03);
		border-radius: 8px;
		color: #a1a1aa;
		text-decoration: none;
		font-size: 13px;
		transition: all 0.2s ease;
	}

	.author-link:hover {
		background: rgba(107, 53, 255, 0.15);
		color: #fff;
	}

	.author-link.view-all {
		background: rgba(107, 53, 255, 0.1);
		color: #6b35ff;
	}

	.author-link.view-all:hover {
		background: rgba(107, 53, 255, 0.2);
		color: #7c44ff;
	}

	@media (max-width: 640px) {
		.author-bio {
			flex-direction: column;
			align-items: center;
			text-align: center;
			padding: 20px;
		}

		.author-avatar {
			width: 64px;
			height: 64px;
		}

		.author-links {
			justify-content: center;
		}
	}
</style>