---
import { getCollection } from 'astro:content';

interface Props {
  activeCategory?: string;
}

const { activeCategory = 'All' } = Astro.props;

// Get all posts and extract unique categories
const posts = await getCollection('blog');
const categories = ['All', ...new Set(posts.map(post => post.data.category).filter(Boolean))];

// Get post count per category
const categoryCounts = categories.reduce((acc, cat) => {
  if (cat === 'All') {
    acc[cat] = posts.length;
  } else {
    acc[cat] = posts.filter(post => post.data.category === cat).length;
  }
  return acc;
}, {} as Record<string, number>);
---

<nav class="category-nav">
  <div class="category-scroll">
    {categories.map((category) => (
      <a 
        href={category === 'All' ? '/blog/' : `/blog/category/${category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')}`}
        class={`category-tab ${activeCategory === category ? 'active' : ''}`}
      >
        {category}
        <span class="count">{categoryCounts[category]}</span>
      </a>
    ))}
  </div>
</nav>

<style>
  .category-nav {
    position: sticky;
    top: 70px;
    z-index: 100;
    background: linear-gradient(180deg, #0a0a0b 0%, rgba(10, 10, 11, 0.95) 100%);
    backdrop-filter: blur(20px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
    padding: 16px 24px;
  }

  .category-scroll {
    display: flex;
    gap: 8px;
    max-width: 1280px;
    margin: 0 auto;
    overflow-x: auto;
    scrollbar-width: none;
    -ms-overflow-style: none;
    padding-bottom: 4px;
  }

  .category-scroll::-webkit-scrollbar {
    display: none;
  }

  .category-tab {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 10px 18px;
    border-radius: 24px;
    font-size: 14px;
    font-weight: 500;
    color: #d4d4d8;
    text-decoration: none;
    background: rgba(255, 255, 255, 0.03);
    border: 1px solid rgba(255, 255, 255, 0.06);
    transition: all 0.2s ease;
    white-space: nowrap;
  }

  .category-tab:hover {
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    border-color: rgba(107, 53, 255, 0.3);
  }

  .category-tab.active {
    background: linear-gradient(135deg, rgba(107, 53, 255, 0.2), rgba(0, 210, 255, 0.1));
    border-color: rgba(107, 53, 255, 0.5);
    color: #fff;
  }

  .category-tab .count {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    color: #d4d4d8;
  }

  .category-tab.active .count {
    background: rgba(107, 53, 255, 0.3);
    color: #fff;
  }

  @media (max-width: 768px) {
    .category-nav {
      padding: 12px 16px;
    }

    .category-tab {
      padding: 8px 14px;
      font-size: 14px;
    }
  }
</style>