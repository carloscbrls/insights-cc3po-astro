---
/**
 * TableOfContents.astro
 * Auto-generated from H2/H3 headings with sticky sidebar and active highlighting
 * Shows if 4+ headings
 * Client-side heading extraction from rendered content
 */
---

<div class="toc" id="toc-component" style="display: none;">
	<div class="toc-header">
		<span class="toc-icon">📋</span>
		<span class="toc-title">Table of Contents</span>
	</div>
	<nav class="toc-nav">
		<ul id="toc-list">
			<!-- Dynamically populated -->
		</ul>
	</nav>
</div>

<style>
	.toc {
		position: sticky;
		top: 80px;
		max-width: 280px;
		max-height: calc(100vh - 100px);
		overflow-y: auto;
		background: linear-gradient(145deg, #141418, #0f0f11);
		border: 1px solid rgba(255, 255, 255, 0.06);
		border-radius: 12px;
		padding: 16px;
	}

	.toc-header {
		display: flex;
		align-items: center;
		gap: 8px;
		margin-bottom: 12px;
		padding-bottom: 10px;
		border-bottom: 1px solid rgba(255, 255, 255, 0.06);
	}

	.toc-icon {
		font-size: 14px;
	}

	.toc-title {
		font-size: 13px;
		font-weight: 600;
		color: #fff;
	}

	.toc-nav ul {
		list-style: none;
		padding: 0;
		margin: 0;
	}

	.toc-item {
		margin-bottom: 4px;
	}

	.toc-item a {
		display: block;
		padding: 6px 10px;
		font-size: 12px;
		color: #d4d4d8;
		text-decoration: none;
		border-radius: 6px;
		transition: all 0.2s ease;
		border-left: 2px solid transparent;
	}

	.toc-item a:hover {
		color: #fff;
		background: rgba(107, 53, 255, 0.1);
		border-left-color: #e94560;
	}

	.toc-item a.active {
		color: #e94560;
		background: rgba(107, 53, 255, 0.15);
		border-left-color: #e94560;
	}

	.toc-level-3 {
		padding-left: 12px;
	}

	.toc-level-3 a {
		font-size: 11px;
		padding-left: 8px;
	}

	@media (max-width: 1024px) {
		.toc {
			display: none !important;
		}
	}
</style>

<script>
	// Extract headings from rendered content
	function extractHeadings(): Array<{id: string; text: string; level: number}> {
		const prose = document.getElementById('prose-content');
		if (!prose) return [];
		
		const headings: Array<{id: string; text: string; level: number}> = [];
		const elements = prose.querySelectorAll('h2, h3');
		
		elements.forEach((el) => {
			// Generate ID if not present
			if (!el.id) {
				const text = el.textContent || '';
				el.id = text
					.toLowerCase()
					.replace(/[^a-z0-9]+/g, '-')
					.replace(/(^-|-$)/g, '');
			}
			
			headings.push({
				id: el.id,
				text: el.textContent || '',
				level: parseInt(el.tagName.substring(1))
			});
		});
		
		return headings;
	}
	
	// Build TOC HTML
	function buildTOC(headings: Array<{id: string; text: string; level: number}>): string {
		return headings.map(h => {
			const levelClass = h.level === 3 ? 'toc-level-3' : '';
			return `<li class="toc-item ${levelClass}"><a href="#${h.id}" data-heading-id="${h.id}">${h.text}</a></li>`;
		}).join('');
	}
	
	// Update active heading on scroll
	function updateActiveHeading() {
		const scrollPos = window.scrollY + 150;
		const tocLinks = document.querySelectorAll('.toc-item a[data-heading-id]');
		
		// Find all headings in the document
		const headings = Array.from(document.querySelectorAll('.prose h2[id], .prose h3[id]'));
		
		// Find the current active heading
		let activeId: string | null = null;
		for (const heading of headings) {
			const el = heading as HTMLElement;
			if (el.offsetTop <= scrollPos) {
				activeId = el.id;
			}
		}
		
		// Update active state
		tocLinks.forEach((link) => {
			const href = link.getAttribute('data-heading-id');
			if (href === activeId) {
				link.classList.add('active');
			} else {
				link.classList.remove('active');
			}
		});
	}
	
	// Initialize TOC
	function initTOC() {
		const headings = extractHeadings();
		const tocComponent = document.getElementById('toc-component');
		const tocList = document.getElementById('toc-list');
		
		// Only show if 4+ headings
		if (headings.length >= 4 && tocComponent && tocList) {
			tocList.innerHTML = buildTOC(headings);
			tocComponent.style.display = 'block';
			
			// Set up scroll listener for active state
			window.addEventListener('scroll', updateActiveHeading);
			updateActiveHeading();
		}
	}
	
	// Run on page load and after Astro navigation
	document.addEventListener('DOMContentLoaded', initTOC);
	document.addEventListener('astro:page-load', initTOC);
</script>