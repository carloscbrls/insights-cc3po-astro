---
import { getCollection } from 'astro:content';
import SearchWidget from './SearchWidget.astro';
import NewsletterSignup from './NewsletterSignup.astro';
import FormattedDate from './FormattedDate.astro';

// Get all posts and categories
const posts = await getCollection('blog');
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];

// Get post count per category
const categoryCounts = categories.reduce((acc, cat) => {
  acc[cat] = posts.filter(post => post.data.category === cat).length;
  return acc;
}, {} as Record<string, number>);

// Get popular posts (sort by date for now - can be enhanced with view counts later)
const popularPosts = posts
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 5);
---

<aside class="blog-sidebar">
  <!-- Search Widget -->
  <SearchWidget />

  <!-- Categories List -->
  <div class="sidebar-section">
    <h4 class="section-title">Categories</h4>
    <ul class="category-list">
      {categories.map((category) => (
        <li>
          <a href={`/blog/category/${category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and')}`}>
            <span class="category-name">{category}</span>
            <span class="category-count">{categoryCounts[category]}</span>
          </a>
        </li>
      ))}
    </ul>
  </div>

  <!-- Newsletter Signup -->
  <NewsletterSignup variant="sidebar" />

  <!-- Popular Posts -->
  <div class="sidebar-section">
    <h4 class="section-title">Popular Posts</h4>
    <ul class="popular-posts">
      {popularPosts.map((post, index) => (
        <li class="popular-post-item">
          <a href={`/blog/${post.id}/`}>
            <span class="post-number">{String(index + 1).padStart(2, '0')}</span>
            <div class="post-info">
              <span class="post-title">{post.data.title}</span>
              <span class="post-meta">{post.data.category} • <FormattedDate date={post.data.pubDate} /></span>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</aside>

<style>
  .blog-sidebar {
    width: 320px;
    flex-shrink: 0;
  }

  .sidebar-section {
    background: linear-gradient(145deg, #141418, #0f0f11);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 20px;
    margin-bottom: 24px;
  }

  .section-title {
    font-size: 16px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 16px;
    padding-bottom: 12px;
    border-bottom: 1px solid rgba(255, 255, 255, 0.06);
  }

  /* Category List */
  .category-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .category-list li {
    margin-bottom: 4px;
  }

  .category-list li:last-child {
    margin-bottom: 0;
  }

  .category-list a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 10px 12px;
    border-radius: 10px;
    text-decoration: none;
    color: #a1a1aa;
    font-size: 14px;
    transition: all 0.2s;
  }

  .category-list a:hover {
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
  }

  .category-name {
    font-weight: 500;
  }

  .category-count {
    background: rgba(255, 255, 255, 0.1);
    padding: 2px 8px;
    border-radius: 10px;
    font-size: 12px;
    font-weight: 600;
    color: #a1a1aa;
    min-width: 28px;
    text-align: center;
  }

  .category-list a:hover .category-count {
    background: rgba(107, 53, 255, 0.2);
    color: #fff;
  }

  /* Popular Posts */
  .popular-posts {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .popular-post-item {
    margin-bottom: 12px;
  }

  .popular-post-item:last-child {
    margin-bottom: 0;
  }

  .popular-post-item a {
    display: flex;
    gap: 12px;
    text-decoration: none;
    padding: 8px;
    border-radius: 10px;
    transition: background 0.2s;
  }

  .popular-post-item a:hover {
    background: rgba(255, 255, 255, 0.05);
  }

  .post-number {
    font-size: 20px;
    font-weight: 800;
    color: #e94560;
    line-height: 1;
    opacity: 0.6;
    width: 32px;
    flex-shrink: 0;
  }

  .post-info {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .post-title {
    font-size: 14px;
    font-weight: 500;
    color: #fff;
    line-height: 1.4;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .post-meta {
    font-size: 12px;
    color: #a1a1aa;
  }

  .post-meta :global(time) {
    color: #a1a1aa;
  }

  @media (max-width: 1024px) {
    .blog-sidebar {
      width: 100%;
    }
  }
</style>
