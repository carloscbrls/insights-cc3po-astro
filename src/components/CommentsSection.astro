---
interface Props {
  postSlug: string;
  postTitle: string;
}

const { postSlug, postTitle } = Astro.props;

// Giscus config — uses GitHub Discussions as backend
// Repo: carloscbrls/insights-cc3po-astro
// Category: Announcements (or General)
const GISCUS_REPO = "carloscbrls/insights-cc3po-astro";
const GISCUS_REPO_ID = ""; // Will be set after GitHub setup
const GISCUS_CATEGORY = "Announcements";
const GISCUS_CATEGORY_ID = ""; // Will be set after GitHub setup
const GISCUS_MAPPING = "pathname";
const GISCUS_THEME = "dark_dimmed";
const GISCUS_LANG = "en";
const GISCUS_LOADING = "lazy";
---

<section class="comments-section" id="comments">
  <h3>Join the Discussion</h3>
  <p class="comments-intro">Have thoughts on this article? Share them below. Comments are powered by GitHub Discussions.</p>
  
  <div class="giscus-container">
    <div class="giscus"></div>
  </div>
  
  <noscript>
    <p>Enable JavaScript to view and post comments.</p>
  </noscript>
</section>

<style>
  .comments-section {
    margin-top: 48px;
    padding-top: 40px;
    border-top: 1px solid rgba(255,255,255,0.06);
  }
  
  .comments-section h3 {
    font-size: 22px;
    font-weight: 700;
    margin-bottom: 8px;
    color: var(--text);
  }
  
  .comments-intro {
    font-size: 14px;
    color: var(--muted);
    margin-bottom: 24px;
    line-height: 1.6;
  }
  
  .giscus-container {
    border-radius: 16px;
    overflow: hidden;
  }
  
  /* Giscus iframe styling adjustments */
  .giscus-container :global(.giscus) {
    max-width: 100%;
  }
  
  .giscus-container :global(.giscus-frame) {
    width: 100%;
    border: none;
  }
  
  .noscript-fallback p {
    color: var(--muted);
    font-size: 14px;
    text-align: center;
    padding: 24px;
  }
  
  @media (max-width: 640px) {
    .comments-section {
      margin-top: 32px;
      padding-top: 24px;
    }
  }
</style>

<script is:inline define:vars={{ GISCUS_REPO, GISCUS_MAPPING, GISCUS_THEME, GISCUS_LANG, GISCUS_LOADING, postSlug }}>
  // Giscus — GitHub Discussions-powered comments
  // Setup: Go to https://giscus.app to generate your config
  // 1. Create a GitHub repo for discussions (or use the blog repo)
  // 2. Enable Discussions in repo settings
  // 3. Install giscus app: https://github.com/apps/giscus
  // 4. Get your repoId and categoryId from https://giscus.app
  
  const giscusScript = document.createElement('script');
  giscusScript.src = 'https://giscus.app/client.js';
  giscusScript.setAttribute('data-repo', 'carloscbrls/insights-cc3po-astro');
  giscusScript.setAttribute('data-repo-id', 'R_kgDOSI05sA');
  giscusScript.setAttribute('data-category', 'Announcements');
  giscusScript.setAttribute('data-category-id', 'DIC_kwDOSI05sM4C8_pA');
  giscusScript.setAttribute('data-mapping', 'pathname');
  giscusScript.setAttribute('data-strict', '0');
  giscusScript.setAttribute('data-reactions-enabled', '1');
  giscusScript.setAttribute('data-emit-metadata', '0');
  giscusScript.setAttribute('data-input-position', 'top');
  giscusScript.setAttribute('data-theme', 'dark_dimmed');
  giscusScript.setAttribute('data-lang', 'en');
  giscusScript.setAttribute('data-loading', 'lazy');
  giscusScript.setAttribute('crossorigin', 'anonymous');
  giscusScript.setAttribute('async', '');
  
  document.querySelector('.giscus-container').appendChild(giscusScript);
</script>