---
/**
 * ArticleCTA.astro
 * Premium call-to-action block at end of articles
 * Drives compliance scans, newsletter, or custom actions
 */
interface Props {
  variant?: 'scan' | 'newsletter' | 'consult' | 'custom';
  title?: string;
  description?: string;
  buttonText?: string;
  buttonUrl?: string;
  secondaryText?: string;
  secondaryUrl?: string;
}

const {
  variant = 'scan',
  title,
  description,
  buttonText,
  buttonUrl,
  secondaryText,
  secondaryUrl
} = Astro.props;

const configs = {
  scan: {
    title: 'Is Your Website Compliant?',
    description: 'Run a free 60-second scan and find out exactly where your site stands on ADA/WCAG compliance. No signup required.',
    buttonText: 'Scan My Website Free →',
    buttonUrl: 'https://audit.cc3po.com',
    secondaryText: 'Learn about Living Compliance →',
    secondaryUrl: 'https://cc3po.com/services',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 12l2 2 4-4"/><circle cx="12" cy="12" r="10"/></svg>`,
    gradient: 'linear-gradient(135deg, #e94560, #6b35ff)',
  },
  newsletter: {
    title: 'Get Weekly Insights',
    description: 'Join 1,000+ business owners getting our latest AI and automation strategies. No spam, unsubscribe anytime.',
    buttonText: 'Subscribe Free →',
    buttonUrl: '#newsletter',
    secondaryText: 'Already a subscriber?',
    secondaryUrl: '#',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><polyline points="22,6 12,13 2,6"/></svg>`,
    gradient: 'linear-gradient(135deg, #6b35ff, #4fc3f7)',
  },
  consult: {
    title: 'Need Expert Help?',
    description: 'Book a free 15-minute consultation. We\'ll audit your site, identify compliance gaps, and show you exactly what to fix.',
    buttonText: 'Book Free Consultation →',
    buttonUrl: 'https://cc3po.com/contact',
    secondaryText: 'See our services →',
    secondaryUrl: 'https://cc3po.com/services',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>`,
    gradient: 'linear-gradient(135deg, #4fc3f7, #10b981)',
  },
  custom: {
    title: title || 'Take Action',
    description: description || '',
    buttonText: buttonText || 'Learn More →',
    buttonUrl: buttonUrl || '#',
    secondaryText: secondaryText || '',
    secondaryUrl: secondaryUrl || '#',
    icon: `<svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>`,
    gradient: 'linear-gradient(135deg, #e94560, #6b35ff)',
  },
};

const config = configs[variant];
---

<div class="article-cta" data-variant={variant}>
  <div class="cta-glow"></div>
  
  <div class="cta-content">
    <div class="cta-icon" set:html={config.icon} />
    <h3 class="cta-title">{config.title}</h3>
    <p class="cta-description">{config.description}</p>
    
    <div class="cta-actions">
      <a href={config.buttonUrl} class="cta-button" target={config.buttonUrl.startsWith('http') ? '_blank' : undefined} rel={config.buttonUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>
        {config.buttonText}
      </a>
      {config.secondaryText && (
        <a href={config.secondaryUrl} class="cta-secondary" target={config.secondaryUrl.startsWith('http') ? '_blank' : undefined} rel={config.secondaryUrl.startsWith('http') ? 'noopener noreferrer' : undefined}>
          {config.secondaryText}
        </a>
      )}
    </div>
    
    <div class="cta-trust">
      <span class="trust-item">🔒 Free</span>
      <span class="trust-item">⚡ 60 seconds</span>
      <span class="trust-item">📊 Real results</span>
    </div>
  </div>
</div>

<style>
  .article-cta {
    position: relative;
    background: linear-gradient(145deg, #1a1a1f, #141418);
    border: 1px solid rgba(107,53,255,0.25);
    border-radius: 24px;
    padding: 36px;
    margin: 40px 0;
    overflow: hidden;
    text-align: center;
  }

  .cta-glow {
    position: absolute;
    top: -50%;
    left: -50%;
    width: 200%;
    height: 200%;
    background: radial-gradient(ellipse at center, rgba(107,53,255,0.08) 0%, transparent 70%);
    pointer-events: none;
  }

  .cta-content {
    position: relative;
    z-index: 1;
  }

  .cta-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 64px;
    height: 64px;
    border-radius: 20px;
    background: linear-gradient(135deg, rgba(107,53,255,0.2), rgba(233,69,96,0.2));
    color: #e94560;
    margin-bottom: 20px;
  }

  .cta-icon :global(svg) {
    width: 32px;
    height: 32px;
  }

  .cta-title {
    font-size: 24px;
    font-weight: 800;
    color: #fff;
    margin-bottom: 12px;
    line-height: 1.3;
  }

  .cta-description {
    font-size: 15px;
    color: #a1a1aa;
    line-height: 1.7;
    margin-bottom: 24px;
    max-width: 480px;
    margin-left: auto;
    margin-right: auto;
  }

  .cta-actions {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 12px;
    margin-bottom: 20px;
  }

  .cta-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 16px 36px;
    background: v-bind(config.gradient);
    background: linear-gradient(135deg, #e94560, #6b35ff);
    color: #fff;
    border: none;
    border-radius: 14px;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    letter-spacing: 0.01em;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 30px rgba(107,53,255,0.4);
  }

  .cta-secondary {
    font-size: 13px;
    color: #71717a;
    text-decoration: none;
    transition: color 0.2s;
  }

  .cta-secondary:hover {
    color: #e94560;
  }

  .cta-trust {
    display: flex;
    justify-content: center;
    gap: 16px;
    flex-wrap: wrap;
  }

  .trust-item {
    font-size: 12px;
    color: #71717a;
  }

  @media (max-width: 640px) {
    .article-cta {
      padding: 24px 20px;
      margin: 28px 0;
      border-radius: 20px;
    }

    .cta-title {
      font-size: 20px;
    }

    .cta-button {
      width: 100%;
      padding: 14px 24px;
    }
  }
</style>