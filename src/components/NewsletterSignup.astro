---
interface Props {
  variant?: 'sidebar' | 'inline' | 'compact';
}

const { variant = 'sidebar' } = Astro.props;
---

{variant === 'sidebar' && (
  <div class="newsletter-widget sidebar" id="newsletter-sidebar">
    <div class="newsletter-icon">📧</div>
    <h4>Catch the Signal</h4>
    <p>Get AI automation strategies and WordPress tips delivered to your inbox every week.</p>
    <form class="newsletter-form" data-newsletter-form="sidebar">
      <input type="email" name="email" placeholder="Enter your email" required />
      <button type="submit" aria-label="Subscribe to newsletter">Subscribe</button>
    </form>
    <div class="newsletter-success" style="display:none;">
      <div class="newsletter-icon">✅</div>
      <h4>You're in!</h4>
      <p>Check your inbox for your free compliance scan link.</p>
    </div>
    <span class="newsletter-microcopy">🔒 No spam. Unsubscribe anytime.</span>
  </div>
)}

{variant === 'inline' && (
  <div class="newsletter-widget inline" id="newsletter-inline">
    <div class="newsletter-content">
      <h4>Catch the Signal</h4>
      <p>Join 1,000+ business owners catching signals that matter.</p>
    </div>
    <form class="newsletter-form" data-newsletter-form="inline">
      <label for="newsletter-email-inline" class="sr-only">Enter your email</label>
      <input type="email" name="email" id="newsletter-email-inline" placeholder="Enter your email" required />
      <button type="submit" aria-label="Subscribe to newsletter">Subscribe</button>
    </form>
    <div class="newsletter-success" style="display:none;">
      <h4>✅ Welcome to the Signal!</h4>
      <p>Check your inbox for your free compliance scan link.</p>
    </div>
  </div>
)}

{variant === 'compact' && (
  <div class="newsletter-widget compact" id="newsletter-compact">
    <h4>Subscribe for Updates</h4>
    <form class="newsletter-form" data-newsletter-form="compact">
      <label for="newsletter-email-compact" class="sr-only">Your email address</label>
      <input type="email" name="email" id="newsletter-email-compact" placeholder="Your email" required />
      <button type="submit" aria-label="Subscribe">→</button>
    </form>
    <div class="newsletter-success" style="display:none;">
      <h4>✅ You're in!</h4>
    </div>
  </div>
)}

<style>
  /* Sidebar variant */
  .newsletter-widget.sidebar {
    background: linear-gradient(135deg, rgba(107, 53, 255, 0.1), rgba(0, 210, 255, 0.05));
    border: 1px solid rgba(107, 53, 255, 0.2);
    border-radius: 16px;
    padding: 24px;
    text-align: center;
    margin-bottom: 24px;
  }

  .newsletter-widget.sidebar .newsletter-icon {
    font-size: 32px;
    margin-bottom: 12px;
  }

  .newsletter-widget.sidebar h4 {
    font-size: 18px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 8px;
  }

  .newsletter-widget.sidebar p {
    font-size: 14px;
    color: #d4d4d8;
    margin-bottom: 16px;
    line-height: 1.5;
  }

  /* Inline variant */
  .newsletter-widget.inline {
    background: linear-gradient(135deg, rgba(107, 53, 255, 0.08), rgba(0, 210, 255, 0.05));
    border: 1px solid rgba(107, 53, 255, 0.15);
    border-radius: 20px;
    padding: 32px 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 40px;
    margin: 40px 0;
  }

  .newsletter-widget.inline .newsletter-content h4 {
    font-size: 22px;
    font-weight: 700;
    color: #fff;
    margin-bottom: 6px;
  }

  .newsletter-widget.inline .newsletter-content p {
    font-size: 14px;
    color: #d4d4d8;
  }

  /* Compact variant */
  .newsletter-widget.compact {
    background: linear-gradient(145deg, #141418, #0f0f11);
    border: 1px solid rgba(255, 255, 255, 0.06);
    border-radius: 16px;
    padding: 16px;
    margin-bottom: 24px;
  }

  .newsletter-widget.compact h4 {
    font-size: 14px;
    font-weight: 600;
    color: #fff;
    margin-bottom: 12px;
  }

  /* Form styles (shared) */
  .newsletter-form {
    display: flex;
    gap: 10px;
  }

  .sidebar .newsletter-form {
    flex-direction: column;
  }

  .inline .newsletter-form {
    min-width: 280px;
    flex: 1;
  }

  .compact .newsletter-form {
    gap: 8px;
  }

  .newsletter-form input {
    flex: 1;
    padding: 12px 16px;
    border-radius: 12px;
    border: 1px solid rgba(255, 255, 255, 0.1);
    background: rgba(255, 255, 255, 0.05);
    color: #fff;
    font-size: 16px;
    transition: border-color 0.2s;
    min-height: 44px;
  }

  .newsletter-form input:focus {
    outline: none;
    border-color: #e94560;
  }

  .newsletter-form input::placeholder {
    color: #d4d4d8;
  }

  .newsletter-form button {
    padding: 12px 24px;
    border-radius: 12px;
    background: #c7364f;
    color: #fff;
    font-weight: 600;
    font-size: 14px;
    border: none;
    cursor: pointer;
    transition: transform 0.2s, box-shadow 0.2s;
    white-space: nowrap;
  }

  .newsletter-form button:hover {
    transform: translateY(-2px);
    box-shadow: 0 8px 20px rgba(107, 53, 255, 0.4);
  }

  .compact .newsletter-form button {
    padding: 10px 16px;
    font-size: 18px;
  }

  .newsletter-microcopy {
    display: block;
    font-size: 14px;
    color: #d4d4d8;
    margin-top: 12px;
  }

  /* Success state */
  .newsletter-success {
    text-align: center;
    padding: 8px 0;
  }

  .newsletter-success h4 {
    color: #10b981 !important;
    font-size: 16px;
    margin-bottom: 4px;
  }

  .newsletter-success p {
    color: #8b949e !important;
    font-size: 13px;
    margin: 0;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .newsletter-widget.inline {
      flex-direction: column;
      text-align: center;
      padding: 24px;
      gap: 24px;
    }

    .inline .newsletter-form {
      min-width: auto;
      width: 100%;
      flex-direction: column;
    }
  }
</style>

<script>
  document.querySelectorAll('[data-newsletter-form]').forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = (form.querySelector('input[type="email"]') as HTMLInputElement).value;
      const button = form.querySelector('button') as HTMLButtonElement;
      const originalText = button.textContent;
      const widget = form.closest('.newsletter-widget') as HTMLElement;
      const successEl = widget?.querySelector('.newsletter-success') as HTMLElement;

      button.textContent = 'Sending...';
      button.disabled = true;

      try {
        const resp = await fetch('https://scanner.cc3po.com/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, source: 'blog' })
        });
        const data = await resp.json();

        if (data.success) {
          (form as HTMLElement).style.display = 'none';
          if (successEl) successEl.style.display = 'block';
        } else {
          alert(data.error || 'Something went wrong. Please try again.');
          button.textContent = originalText;
          button.disabled = false;
        }
      } catch {
        alert('Network error. Please try again.');
        button.textContent = originalText;
        button.disabled = false;
      }
    });
  });
</script>