---
// Email subscribe capture — posts to the same newsletter endpoint the
// cc3po.com homepage capture ("Get the Signal") uses.
interface Props {
  source?: string;
  heading?: string;
}
const { source = 'insights-article-end', heading = 'Get the Signal' } = Astro.props;
---

<aside class="subscribe-capture" data-subscribe-capture>
  <h2 class="subscribe-capture-title">{heading}</h2>
  <p class="subscribe-capture-copy">
    One email a week — the newest CC3PO Insights post plus one practical fix
    for your business. No spam, unsubscribe anytime.
  </p>
  <form class="subscribe-capture-form" data-source={source}>
    <label class="subscribe-capture-label">Email address</label>
    <input type="email" name="email" required placeholder="you@company.com" autocomplete="email" />
    <button type="submit">Subscribe</button>
  </form>
  <p class="subscribe-capture-msg" role="status" aria-live="polite"></p>
</aside>

<style>
  .subscribe-capture {
    margin: 2.5rem 0;
    padding: 1.75rem;
    border: 1px solid rgba(201, 162, 76, 0.35);
    border-radius: 18px;
    background: rgba(201, 162, 76, 0.06);
    text-align: center;
  }
  .subscribe-capture-title {
    margin: 0 0 0.5rem;
    font-size: 1.4rem;
  }
  .subscribe-capture-copy {
    margin: 0 auto 1.25rem;
    max-width: 34rem;
    opacity: 0.85;
  }
  .subscribe-capture-form {
    display: flex;
    gap: 0.6rem;
    justify-content: center;
    flex-wrap: wrap;
  }
  .subscribe-capture-label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .subscribe-capture-form input {
    flex: 1 1 240px;
    max-width: 320px;
    min-height: 44px;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    border: 1px solid rgba(255, 255, 255, 0.18);
    background: rgba(255, 255, 255, 0.05);
    color: inherit;
    font-size: 16px;
  }
  .subscribe-capture-form button {
    min-height: 44px;
    padding: 0.65rem 1.4rem;
    border: 0;
    border-radius: 10px;
    background: #c9a24c;
    color: #111;
    font-weight: 700;
    cursor: pointer;
  }
  .subscribe-capture-msg {
    margin: 0.8rem 0 0;
    min-height: 1.2em;
    font-size: 0.95rem;
  }
</style>

<script>
  document.querySelectorAll('.subscribe-capture-form').forEach((form) => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const wrap = form.closest('[data-subscribe-capture]');
      const msg = wrap?.querySelector('.subscribe-capture-msg');
      const input = form.querySelector('input[type="email"]') as HTMLInputElement;
      const btn = form.querySelector('button[type="submit"]') as HTMLButtonElement;
      if (!input || !btn) return;
      btn.disabled = true;
      if (msg) msg.textContent = 'Subscribing…';
      try {
        const res = await fetch('https://scanner.cc3po.com/api/newsletter-subscribe', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email: input.value, source: form.getAttribute('data-source') || 'insights' }),
        });
        if (!res.ok) throw new Error('subscribe failed');
        if (msg) msg.textContent = "You're in — watch your inbox for this week's Signal.";
        form.reset();
      } catch {
        if (msg) msg.textContent = 'Something went wrong. Please try again.';
      } finally {
        btn.disabled = false;
      }
    });
  });
</script>
