const totalAlbums = albums.length;
const totalTracks = '113+';
const totalPlays = '20,000+';
---

<Layout title="Music Projects — CC3PO | 12 Albums, 113+ Tracks, Real Stories">

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 pt-28 pb-16">
    <div class="text-center mb-12">
      <div class="album-tag" style="margin-bottom: 24px;">
        🎵 {totalAlbums} Albums · {totalTracks} Tracks · {totalPlays} Plays
      </div>
      <h1 class="f-serif" style="font-size: clamp(2.4rem, 6vw, 3.6rem); font-weight: 600; letter-spacing: -0.01em; line-height: 1.1; color: var(--brand-paper); margin: 0 0 20px;">
        The Music of CC3PO
      </h1>
      <p style="font-size: 1.125rem; line-height: 1.7; color: rgba(255,255,255,0.65); max-width: 42rem; margin: 0 auto;">
        {artist.realName}. {artist.location}. Bilingual storyteller who code-switches between Spanish and English because some truths only land in one language.
        <br/>Every lyric, every edit, every emotional heartbeat — <span style="color: var(--brand-paper); font-weight: 600;">mine</span>.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <a href={artist.soundcloud} target="_blank" rel="noopener" class="cc-btn-primary" style="text-decoration: none;">
          Listen on SoundCloud
        </a>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-4">
      {[
        { num: totalAlbums, label: 'Albums' },
        { num: totalTracks, label: 'Tracks' },
        { num: totalPlays, label: 'Plays' },
        { num: artist.followers, label: 'Followers' },
      ].map((s) => (
        <div style="background: var(--brand-surface-dark); border: 1px solid rgba(255,255,255,0.09); border-radius: 14px; padding: 22px 16px; text-align: center;">
          <div class="f-serif" style="font-size: 2rem; font-weight: 600; color: var(--brand-gold); line-height: 1.1;">{s.num}</div>
          <div style="font-size: 13.5px; color: rgba(255,255,255,0.55); margin-top: 4px;">{s.label}</div>
        </div>
      ))}
    </div>
  </section>

  <!-- Featured releases — doors to the music site -->
  <section class="max-w-6xl mx-auto px-4 pb-16">
    <div class="cc-section-label">Start Listening</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">The latest from the catalog</h2>
      <hr class="folio-rule" />
    </div>
    <div class="release-grid">
      {featured.map((r) => (
        <a class="release-card" href={r.href} target="_blank" rel="noopener">
          <span class="release-cover"><img src={r.cover} alt={r.coverAlt} width="500" height="500" loading="lazy" /></span>
          <span class="release-body">
            <span class="release-title">{r.title}</span>
            <span class="folio-meta">{r.meta}</span>
            <span class="release-line">{r.line}</span>
            <span class="release-door">Listen on the music site <span class="folio-arrow" aria-hidden="true">→</span></span>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Album Grid -->
  <section class="max-w-6xl mx-auto px-4 pb-20">
    <div class="cc-section-label">The Shelf</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">The 12 albums</h2>
      <hr class="folio-rule" />
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {albums.map((album) => (
        <article class="album-card">
          <div class="album-cover">
            <img src={album.coverImg} alt={album.coverAlt} width="500" height="500" loading="lazy" />
          </div>
          <div class="album-body">
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 10px;">
              <span class="album-tag">{album.tag}</span>
              <span class="album-year">{album.year}</span>
            </div>
            <h3 class="album-title">{album.title}</h3>
            <p class="album-genre">{album.genre}</p>
            <p class="album-desc">{album.description}</p>
            {album.story && (
              <div class="album-story">
                <p class="album-story-label">The Story</p>
                <p>{album.story}</p>
              </div>
            )}
            {album.topTracks.length > 0 && (
              <div class="album-tracks">
                <p class="album-tracks-label">Key Tracks</p>
                <ul>
                  {album.topTracks.map((track) => (
                    <li>
                      <span class="note" aria-hidden="true">♪</span> {track.name}
                      {track.plays && <span class="plays">{track.plays.toLocaleString()} plays</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}
            <div class="album-foot">
              <span class="album-meta">{album.tracks ? album.tracks + ' tracks' : 'Album'}{album.duration ? ' · ' + album.duration : ''}</span>
              <a href={album.soundcloud} target="_blank" rel="noopener" class="album-listen">Listen <span class="folio-arrow" aria-hidden="true">→</span></a>
            </div>
          </div>
        </article>
      ))}
    </div>

    <!-- The Healing Arc -->
    <div style="background: var(--brand-surface-dark); border: 1px solid rgba(255,255,255,0.09); border-radius: 18px; padding: clamp(26px, 5vw, 48px); margin-top: 72px;">
      <div class="text-center" style="margin-bottom: 32px;">
        <div class="album-tag" style="margin-bottom: 16px;">
          🧬 The Healing Arc
        </div>
        <h2 class="f-serif" style="font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; color: var(--brand-paper); margin: 0 0 12px;">
          Twelve Albums. One Documented Life.
        </h2>
        <p style="color: rgba(255,255,255,0.6); line-height: 1.7; max-width: 42rem; margin: 0 auto;">
          Read in order, the catalog isn't a collection of songs — it's a healing process made audible. From the confession to the rebirth, each album is a chapter in the same story.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {arc.map((chapter, i) => (
          <div style="display: flex; align-items: flex-start; gap: 14px; background: rgba(255,255,255,0.04); border: 1px solid rgba(255,255,255,0.09); border-radius: 12px; padding: 16px;">
            <div class="folio-medallion" style="margin: 0; width: 38px; height: 38px; font-size: 1rem; flex-shrink: 0;" aria-hidden="true">
              {i + 1}
            </div>
            <div>
              <div class="album-story-label" style="margin-bottom: 2px;">{chapter.step}</div>
              <div style="font-size: 0.9rem; color: rgba(255,255,255,0.75);">{chapter.album}</div>
            </div>
          </div>
        ))}
      </div>
      <div style="margin-top: 28px; background: rgba(230,165,15,0.07); border: 1px solid rgba(230,165,15,0.26); border-radius: 12px; padding: 16px 20px; text-align: center;">
        <p style="margin: 0; font-size: 14.5px; line-height: 1.65; color: rgba(255,255,255,0.78);">
          <strong>The most-played songs</strong> are the ones about being the villain, the immigrant's "I can't fail," the plea for more time, the moment you notice, the things never said, the hallway dad, and steady love. <span style="color: var(--brand-paper);">The confession. The roots. The quiet.</span>
        </p>
      </div>
    </div>

    <!-- Writing DNA Section -->
    <div style="background: var(--brand-surface-dark); border: 1px solid rgba(255,255,255,0.09); border-radius: 18px; padding: clamp(26px, 5vw, 48px); margin-top: 40px;">
      <h2 class="f-serif" style="font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; color: var(--brand-paper); margin: 0 0 24px;">
        The CC3PO Writing DNA
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="f-gold" style="font-size: 1.05rem; font-weight: 600; margin: 0 0 12px;">Voice & Delivery</h3>
          <ul style="list-style: none; margin: 0; padding: 0;">
            <li class="dna-item">Half-spoken, half-sung — conversational, not melodic</li>
            <li class="dna-item">Confessional tone — like reading a private journal</li>
            <li class="dna-item">Vulnerable but not weak — raw honesty, never pity-seeking</li>
            <li class="dna-item">Bilingual code-switching — Spanish for emotional weight</li>
          </ul>
        </div>
        <div>
          <h3 class="f-gold" style="font-size: 1.05rem; font-weight: 600; margin: 0 0 12px;">Lyrical Patterns</h3>
          <ul style="list-style: none; margin: 0; padding: 0;">
            <li class="dna-item">Specific detail over abstract emotion</li>
            <li class="dna-item">Self-correction mid-thought</li>
            <li class="dna-item">Admission of contradiction</li>
            <li class="dna-item">Bilingual gut-punch refrains</li>
            <li class="dna-item">Anti-hero narration — owning labels, rejecting narratives</li>
            <li class="dna-item">Everyday imagery — phone, scrolling, driving</li>
          </ul>
        </div>
      </div>
      <div style="margin-top: 28px; background: rgba(230,165,15,0.07); border: 1px solid rgba(230,165,15,0.26); border-radius: 12px; padding: 16px 20px;">
        <p style="margin: 0; font-size: 14.5px; line-height: 1.65; color: rgba(255,255,255,0.78);">
          <strong>Production:</strong> AI-assisted tools co-create some instrumentals. <strong>Every lyric, edit, and emotional heartbeat is mine.</strong> Real voice. Real stories.
        </p>
      </div>
    </div>

  <style>
    .dna-item {
      font-size: 14.5px;
      line-height: 1.6;
      color: rgba(255,255,255,0.62);
      padding: 4px 0 4px 24px;
      position: relative;
    }
    .dna-item::before {
      content: '✦';
      position: absolute;
      left: 0;
      top: 7px;
      font-size: 12px;
      color: var(--brand-gold);
    }
  </style>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <h2 class="f-serif" style="font-size: clamp(1.6rem, 4vw, 2.1rem); font-weight: 600; color: var(--brand-paper); margin: 0 0 12px;">
        Hear the Story
      </h2>
      <p style="color: rgba(255,255,255,0.6); margin: 0 0 28px;">
        {totalAlbums} albums. {totalTracks} tracks. One voice that refused to stay quiet.
      </p>
      <a href={artist.soundcloud} target="_blank" rel="noopener" class="cc-btn-primary" style="text-decoration: none;">
        Listen on SoundCloud
      </a>
    </div>
  </section>
</Layout>
