---
import Layout from '../layouts/Layout.astro';

const artist = {
  name: 'CC3PO',
  realName: 'Carlos Cabrales III',
  location: 'Lathrop, California',
  bio: 'Independent storyteller. Bilingual code-switcher. Every lyric, edit, and emotional heartbeat is mine.',
  soundcloud: 'https://soundcloud.com/carlos-cabrales-iii',
  followers: '1,591',
  totalPlays: '20,000+',
  totalTracks: 113,
};

// The Healing Arc — the narrative spine of the catalog
const arc = [
  { step: 'The Confession', album: 'No More Guilt' },
  { step: 'The Clarity', album: 'Life in Awareness' },
  { step: 'The Roots', album: 'Todavía Aquí' },
  { step: 'The Invisible Wound', album: 'Survival: Quiet Erosion' },
  { step: 'The Service', album: 'Emotional Support' },
  { step: 'The Faith', album: 'Raíces del Ritmo' },
  { step: 'The Love', album: 'Built in the Quiet' },
  { step: 'The Therapy', album: 'Dos Duelos' },
  { step: 'The Stillness', album: 'Light From a Small Screen' },
  { step: 'The Aftermath', album: 'Echoes They Left Behind' },
  { step: 'The Systems', album: 'Seven Layers Deep' },
  { step: 'The Rebirth', album: 'YO (I AM CC3PO)' },
];

const albums = [
  {
    title: 'Todavía Aquí',
    genre: 'Latin · Reggaetón',
    year: '2026',
    tracks: 11,
    duration: '36:40',
    likes: 1,
    cover: '🎵',
    accent: 'from-amber-500 to-red-600',
    border: 'border-amber-500/30',
    tag: 'Latin',
    tagColor: 'bg-amber-500/20 text-amber-400',
    description: 'Still here. A Latin album that refuses to disappear — reggaetón oscuro, corrido tumbado, and bilingual anthems about survival, heritage, and the weight of staying when leaving was easier.',
    story: '"Todavía Aquí" translates to "Still Here." That\'s the whole thesis. This is the immigrant story, told in Spanish because that\'s the only language it lands in — growing up in poverty after migrating from Latin America. "Así Era" (2,935 plays) is the #2 track in the entire catalog. The album is dedicated to those who learned to resist early, carried more than their share, and are still here.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/todavia-aqui',
    topTracks: [
      { name: 'Así Era', plays: 2935 },
      { name: 'Lo Que Nunca Dije', plays: 2552 },
      { name: 'No Puedo Fallar', plays: 2446 },
      { name: 'Mirando Desde Afuera', plays: 2423 },
    ],
  },
  {
    title: 'No More Guilt',
    genre: 'Hip-Hop & Rap',
    year: '2025',
    tracks: 12,
    duration: '42:30',
    likes: 4,
    cover: '⚡',
    accent: 'from-yellow-400 to-orange-600',
    border: 'border-yellow-500/30',
    tag: 'Hip-Hop',
    tagColor: 'bg-yellow-500/20 text-yellow-400',
    description: 'The confession they didn\'t want to hear. Defiant hip-hop about refusing guilt that was never yours to carry — fatherhood, survival, and the audacity to stop apologizing.',
    story: 'Guilt is the quietest prison. This album is the key. "No More Guilt" doesn\'t deny mistakes — it denies owning someone else\'s narrative about them. Every bar is a boundary drawn in permanent ink. This is where the catalog begins — and it\'s the rawest. "I\'ve Been the Villain in Your Story Too Long" is the #1 track in the entire catalog at 4,909 plays: the anti-hero owning the label and rejecting it at the same time.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/no-more-guilt',
    topTracks: [
      { name: 'I\'ve Been the Villain in Your Story Too Long', plays: 4909 },
      { name: 'No More Guilt', plays: 774 },
    ],
  },
  {
    title: 'When Everything\'s Out of Control',
    genre: 'Hip-Hop & Rap · Confessional',
    year: '2026',
    tracks: 10,
    duration: null,
    likes: null,
    cover: '🔥',
    accent: 'from-orange-500 to-red-600',
    border: 'border-orange-500/30',
    tag: 'Hip-Hop',
    tagColor: 'bg-orange-500/20 text-orange-400',
    description: 'When the world stops making sense, you make your own. Confessional bars about fatherhood, hustle, and refusing to be defined by chaos.',
    story: 'This album was born in the moments between crises — when the phone stops ringing, when the kids are asleep, when you finally get to think. "Hallway Dad" alone has 2,584 plays because every parent who\'s ever paced a hallway at 3am knows that feeling.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/when-everythings-out-of-control',
    topTracks: [
      { name: 'Hallway Dad', plays: 2584 },
      { name: 'I\'ve Been the Villain in Your Story Too Long', plays: 4909 },
      { name: 'Voicemail', plays: 3 },
    ],
  },
  {
    title: 'Built in the Quiet',
    genre: 'Pop · Introspective',
    year: '2026',
    tracks: 11,
    duration: '38:58',
    likes: 1,
    cover: '🧱',
    accent: 'from-emerald-400 to-teal-600',
    border: 'border-emerald-500/30',
    tag: 'Pop',
    tagColor: 'bg-emerald-500/20 text-emerald-400',
    description: 'Building something from nothing — pop anthems about quiet persistence and the architecture of a life under construction.',
    story: 'The loudest thing CC3PO ever made is about silence. "Built in the Quiet" maps the unseen hours — the 5am grind, the silent sacrifice, the foundation nobody praises because it\'s underground. But nothing stands without it. Released for Valentine\'s Day, this is the counterpoint to No More Guilt: where that album was about release, this one is about commitment. "Love is not loud. Love is intentional. Love is chosen. Still choosing you."',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/built-in-the-quiet',
    topTracks: [
      { name: 'Build With Me', plays: 2323 },
      { name: 'Every Day I Choose You', plays: 1427 },
      { name: 'What I Unlearned', plays: 1389 },
    ],
  },
  {
    title: 'Light From a Small Screen',
    genre: 'Indie Folk · Acoustic',
    year: '2026',
    tracks: 3,
    duration: '10:38',
    likes: 1,
    cover: '💻',
    accent: 'from-blue-400 to-cyan-600',
    border: 'border-blue-500/30',
    tag: 'Indie',
    tagColor: 'bg-blue-500/20 text-blue-400',
    description: 'Intimate indie folk — the glow of a phone screen in a dark room, the quiet weight of staying, the light that comes from paying attention.',
    story: 'Three tracks, ten minutes, one truth: the smallest light matters. This EP was recorded in the glow of a phone screen — the same screen that divides us, but also the one that connects a father working late to his kids\' goodnight texts. "Five More Minutes" (2,500 plays) is the catalog\'s most-played track alongside "Así Era" — the universal plea for just a little more time. This is the most-reposted album in the catalog.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/light-from-a-small-screen',
    topTracks: [
      { name: 'Five More Minutes', plays: 2500 },
      { name: 'The Room Looked the Same', plays: 2395 },
      { name: 'Nothing Unusual', plays: 1530 },
    ],
  },
  {
    title: 'Dos Duelos',
    genre: 'Reggaetón · Latin Trap',
    year: '2026',
    tracks: 9,
    duration: '38:24',
    likes: null,
    cover: '⚔️',
    accent: 'from-purple-500 to-pink-600',
    border: 'border-purple-500/30',
    tag: 'Latin',
    tagColor: 'bg-purple-500/20 text-purple-400',
    description: 'Two griefs, two languages, one truth — reggaetón oscuro meets bilingual heartbreak and ancestral weight.',
    story: '"Dos Duelos" means "Two Griefs." One for what was lost, one for what was never given. This album holds both — in Spanish when the pain is too sharp for English, and in English when the clarity cuts too deep for Spanish. "No es un álbum sobre infidelidad. Es un álbum sobre silencio." (It\'s not an album about infidelity. It\'s an album about silence.) Dark, intimate, minimalist reggaetón. Fractured masculinity. Truth without theater. "Aquí no hay moraleja. Solo consecuencias." (No moral here. Only consequences.)',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/dos-duelos',
    topTracks: [
      { name: 'Por Dentro Muerto', plays: 2151 },
      { name: 'Se Cayó El Teatro', plays: 1510 },
      { name: 'Cel Boca Abajo', plays: 1461 },
    ],
  },
  {
    title: 'Survival: Quiet Erosion',
    genre: 'Pop · Lo-Fi · Emotional',
    year: '2026',
    tracks: 10,
    duration: null,
    likes: null,
    cover: '🌫️',
    accent: 'from-gray-400 to-slate-600',
    border: 'border-gray-500/30',
    tag: 'Pop',
    tagColor: 'bg-gray-500/20 text-gray-400',
    description: 'The slow fade that no one names — lo-fi pop about erosion, endurance, and the tiny adjustments that keep you alive.',
    story: 'Survival isn\'t always dramatic. Sometimes it\'s the thousand small surrenders that add up to still being here. "Quiet Erosion" is the soundtrack to the moments nobody posts about — the slow, unglamorous persistence of staying. A concept album about emotional survival: the slow, often invisible loss of self in psychologically controlling environments — not through violence, but through small adjustments, quiet apologies, and learned silence. "This is not an album about winning. It\'s about staying."',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/survival-quiet-erosion',
    topTracks: [
      { name: 'The Moment You Notice', plays: 2438 },
      { name: 'Quiet Adjustments', plays: 2026 },
    ],
  },
  {
    title: 'YO (I AM CC3PO)',
    genre: 'Reggaetón · Identity · Declaration',
    year: '2026',
    tracks: 9,
    duration: null,
    likes: null,
    cover: '🪞',
    accent: 'from-red-500 to-rose-700',
    border: 'border-red-500/30',
    tag: 'Reggaetón',
    tagColor: 'bg-red-500/20 text-red-400',
    description: 'The declaration album. I AM — not I was, not I might be. A bilingual manifesto of identity, self-definition, and the refusal to be categorized.',
    story: '"YO" — "I" in Spanish, the most powerful word in any language. This is the album where CC3PO stops explaining and starts declaring. Every track is an "I am" statement. Bilingual, unapologetic, permanent. Released Aug 8, 2026, this is the newest and most personal album — the story of transformation from childhood trauma, mental health struggles, and physical/emotional weight, to rebirth 3 months after a life-changing bariatric surgery. "New Body, Same Soul" is the thesis. "Si tú también estás transformando tu vida, este álbum es contigo." (If you\'re also transforming your life, this album is with you.)',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/yo-i-am-cc3po',
    topTracks: [
      { name: 'Paso a Paso', plays: 264 },
      { name: 'Hábitos Viejos', plays: 257 },
      { name: 'War in the Mirror', plays: 241 },
      { name: 'New Body, Same Soul', plays: 198 },
    ],
  },
  {
    title: 'Raíces Del Ritmo',
    genre: 'Spiritual Latin Hip-Hop · Ancestral',
    year: '2026',
    tracks: 9,
    duration: null,
    likes: 3,
    cover: '🌿',
    accent: 'from-green-500 to-lime-600',
    border: 'border-green-500/30',
    tag: 'Latin',
    tagColor: 'bg-green-500/20 text-green-400',
    description: 'Roots of rhythm — spiritual Latin hip-hop connecting ancestry, migration, and the pulse that survives everything.',
    story: 'Before the beat, there was the heartbeat. "Raíces Del Ritmo" traces the rhythm back — through migration, through sacrifice, through the songs your grandmother hummed that you didn\'t understand until you were old enough to need them. "This isn\'t just music. It\'s documentation." — of faith, mentorship, and purpose through lived experience. Part of the ongoing work through Raíces Digitales (raicesdigitales.cc3po.com).',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/raices-del-ritmo',
    topTracks: [
      { name: 'Cuando Te Toque', plays: 274 },
      { name: 'Rosas en Ruinas', plays: 222 },
      { name: 'Lo Que Dejamos', plays: 219 },
    ],
  },
  {
    title: 'Life in Awareness',
    genre: 'Pop · Reflective · Spoken Word',
    year: '2026',
    tracks: 9,
    duration: null,
    likes: 1,
    cover: '👁️',
    accent: 'from-indigo-400 to-violet-600',
    border: 'border-indigo-500/30',
    tag: 'Pop',
    tagColor: 'bg-indigo-500/20 text-indigo-400',
    description: 'Waking up is the hardest part — reflective pop and spoken word about choosing awareness over comfort.',
    story: 'Awareness is expensive. It costs you your illusions. "Life in Awareness" is about paying that price willingly — seeing the room clearly, even when what you see hurts. Because the alternative is worse. "This album is about living inside the truth once you can\'t unsee it. Not coming out. Not breaking down. Not healing yet. Just existing with clarity."',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/life-in-awareness',
    topTracks: [
      { name: 'Not Leaving, Not Staying', plays: 2247 },
      { name: 'Acceptance Without Relief', plays: 1391 },
      { name: 'I Still Show Up', plays: 235 },
    ],
  },
  {
    title: 'Echoes They Left Behind',
    genre: 'Indie · Atmospheric · Haunting',
    year: '2026',
    tracks: 3,
    duration: null,
    likes: 2,
    cover: '👻',
    accent: 'from-slate-400 to-zinc-600',
    border: 'border-slate-500/30',
    tag: 'Indie',
    tagColor: 'bg-slate-500/20 text-slate-400',
    description: 'The ghosts of what was — atmospheric indie about the echoes people leave when they go.',
    story: 'People leave. But they don\'t leave nothing. They leave echoes — in the way you hold your coffee, in the phrase you catch yourself saying, in the silence where their laugh used to be. This album lives in those echoes. The companion to Light From a Small Screen: where that album was the stillness, this one is the aftermath — the moment everything broke, the empty rooms, and the echoes that remain. It\'s the sound of absence made audible.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/echoes-they-left-behind',
    topTracks: [
      { name: 'Empty Rooms', plays: 358 },
      { name: 'Echoes They Left Behind', plays: 319 },
      { name: 'The Moment Everything Broke', plays: 286 },
    ],
  },
  {
    title: 'Seven Layers Deep',
    genre: 'Educational · Concept · OSI Model',
    year: '2026',
    tracks: 9,
    duration: null,
    likes: 2,
    cover: '📚',
    accent: 'from-cyan-400 to-blue-600',
    border: 'border-cyan-500/30',
    tag: 'Educational',
    tagColor: 'bg-cyan-500/20 text-cyan-400',
    description: 'The OSI model, turned into music — 7 layers, 7 songs, one unforgettable way to learn networking.',
    story: 'CC3PO works in IT by day. This is what happens when a network engineer makes music about the network. Seven layers, seven tracks, and suddenly you understand the OSI model because it\'s stuck in your head. Education was never supposed to slap this hard. "Strong systems thinking isn\'t about having every answer, but about knowing where to start and how to move forward." The closing track is designed to be replayed under pressure as a reminder that when things break, the answer isn\'t guessing — it\'s structure. This is CC3PO\'s philosophy in musical form: clarity replaces panic.',
    soundcloud: 'https://soundcloud.com/carlos-cabrales-iii/sets/seven-layers-deep',
    topTracks: [
      { name: 'OSI Speed Run (Seven Layers in One Breath)', plays: 1406 },
      { name: 'Presentation (Encryption, Format)', plays: 224 },
      { name: 'Physical (Layer One)', plays: 214 },
    ],
  },
];

const totalAlbums = albums.length;
const totalTracks = '113+';
const totalPlays = '20,000+';
---

<Layout title="Music Projects — CC3PO | 12 Albums, 113+ Tracks, Real Stories">

  <!-- Hero -->
  <section class="max-w-6xl mx-auto px-4 pt-28 pb-16">
    <div class="text-center mb-12">
      <div class="inline-flex items-center gap-2 bg-orange-500/10 border border-orange-500/30 text-orange-400 text-sm font-semibold px-4 py-1.5 rounded-full mb-6">
        🎵 {totalAlbums} Albums · {totalTracks} Tracks · {totalPlays} Plays
      </div>
      <h1 class="text-4xl md:text-6xl font-extrabold text-white mb-4" style="-webkit-text-fill-color: white;">
        The Music of CC3PO
      </h1>
      <p class="text-lg md:text-xl text-gray-400 max-w-2xl mx-auto" style="-webkit-text-fill-color: #94a3b8;">
        {artist.realName}. {artist.location}. Bilingual storyteller who code-switches between Spanish and English because some truths only land in one language.
        <br/>Every lyric, every edit, every emotional heartbeat — <span class="text-white font-semibold">mine</span>.
      </p>
      <div class="flex flex-wrap gap-3 justify-center mt-8">
        <a href={artist.soundcloud} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-400 text-white font-semibold px-6 py-3 rounded-lg transition">
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor"><path d="M1.175 12.225c-.051 0-.094.046-.101.1l-.233 2.154.233 2.105c.007.058.05.098.101.098.05 0 .09-.04.099-.098l.255-2.105-.27-2.154c-.009-.06-.05-.1-.1-.1zm-.899.828l-.199 1.425.2 1.364c.008.05.044.09.09.09.049 0 .085-.04.094-.09l.226-1.364-.226-1.425c-.009-.05-.045-.09-.094-.09-.046 0-.082.04-.09.09zm1.83-1.227c-.063 0-.115.05-.12.114l-.216 2.538.216 2.463c.005.06.057.108.12.108.061 0 .11-.048.117-.108l.242-2.463-.242-2.538c-.008-.064-.056-.114-.117-.114zm1.812-.432c-.076 0-.137.06-.142.138l-.2 2.97.2 2.89c.005.075.066.133.142.133.075 0 .136-.058.142-.133l.225-2.89-.225-2.97c-.006-.078-.067-.138-.142-.138zm1.8-.252c-.088 0-.16.07-.166.16l-.185 3.222.185 3.107c.006.088.078.156.166.156.087 0 .158-.068.165-.156l.208-3.107-.208-3.222c-.007-.09-.078-.16-.165-.16zm1.81-.096c-.1 0-.18.08-.186.182l-.17 3.318.17 3.22c.006.1.087.18.187.18.098 0 .178-.08.185-.18l.19-3.22-.19-3.318c-.007-.102-.087-.182-.185-.182zm1.818.078c-.11 0-.198.09-.204.2l-.155 3.24.155 3.19c.006.11.094.198.204.198.108 0 .196-.088.203-.198l.172-3.19-.172-3.24c-.007-.11-.095-.2-.203-.2zm1.808-.345c-.12 0-.217.097-.223.218l-.14 3.585.14 3.472c.006.12.103.215.223.215.118 0 .215-.095.222-.215l.155-3.472-.155-3.585c-.007-.12-.104-.218-.222-.218zm1.812-.156c-.13 0-.236.106-.242.236l-.125 3.741.125 3.727c.006.13.112.236.242.236.128 0 .233-.106.24-.236l.14-3.727-.14-3.741c-.007-.13-.112-.236-.24-.236zm1.803.052c-.14 0-.253.114-.258.254l-.11 3.69.11 3.716c.005.14.118.253.258.253.14 0 .25-.113.257-.253l.122-3.716-.122-3.69c-.007-.14-.117-.254-.257-.254zm1.808.3c-.15 0-.27.12-.277.27l-.095 3.39.095 3.442c.007.15.127.27.277.27.148 0 .267-.12.276-.27l.105-3.442-.105-3.39c-.009-.15-.128-.27-.276-.27zm1.804-.378c-.16 0-.287.127-.294.288l-.08 3.768.08 3.854c.007.16.134.287.294.287.158 0 .283-.127.292-.287l.088-3.854-.088-3.768c-.009-.16-.134-.288-.292-.288zm1.815.044c-.17 0-.303.137-.31.307l-.064 3.724.064 3.907c.007.17.14.303.31.303.168 0 .3-.133.308-.303l.07-3.907-.07-3.724c-.008-.17-.14-.307-.308-.307zm3.695 1.003c-.24 0-.433.19-.438.432l-.037 2.628.037 2.716c.005.24.198.432.438.432.24 0 .432-.192.437-.432l.04-2.716-.04-2.628c-.005-.242-.197-.432-.437-.432z"/></svg>
          Listen on SoundCloud
        </a>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-16">
      <div class="bg-[#0f0f1a] border border-white/10 rounded-xl p-6 text-center">
        <div class="text-3xl md:text-4xl font-extrabold text-white" style="-webkit-text-fill-color: white;">{totalAlbums}</div>
        <div class="text-sm text-gray-400 mt-1">Albums</div>
      </div>
      <div class="bg-[#0f0f1a] border border-white/10 rounded-xl p-6 text-center">
        <div class="text-3xl md:text-4xl font-extrabold text-white" style="-webkit-text-fill-color: white;">{totalTracks}</div>
        <div class="text-sm text-gray-400 mt-1">Tracks</div>
      </div>
      <div class="bg-[#0f0f1a] border border-white/10 rounded-xl p-6 text-center">
        <div class="text-3xl md:text-4xl font-extrabold text-white" style="-webkit-text-fill-color: white;">{totalPlays}</div>
        <div class="text-sm text-gray-400 mt-1">Plays</div>
      </div>
      <div class="bg-[#0f0f1a] border border-white/10 rounded-xl p-6 text-center">
        <div class="text-3xl md:text-4xl font-extrabold text-white" style="-webkit-text-fill-color: white;">{artist.followers}</div>
        <div class="text-sm text-gray-400 mt-1">Followers</div>
      </div>
    </div>
  </section>

  <!-- Album Grid -->
  <section class="max-w-6xl mx-auto px-4 pb-20">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
      {albums.map((album) => (
        <div class={`bg-[#0f0f1a] border ${album.border} rounded-xl overflow-hidden hover:border-emerald-500/50 transition group`}>
          <!-- Album Header -->
          <div class={`bg-gradient-to-br ${album.accent} p-6 relative`}>
            <div class="text-5xl mb-2">{album.cover}</div>
            <span class={`inline-block ${album.tagColor} text-xs font-bold px-2 py-1 rounded-full`}>{album.tag}</span>
            <div class="absolute top-4 right-4 text-white/70 text-sm font-mono">{album.year}</div>
          </div>
          <!-- Album Info -->
          <div class="p-6">
            <h3 class="text-xl font-bold text-white mb-1" style="-webkit-text-fill-color: white;">{album.title}</h3>
            <p class="text-sm text-gray-500 mb-3">{album.genre}</p>
            <p class="text-sm text-gray-400 mb-4">{album.description}</p>

            {album.story && (
              <div class="mb-4 p-3 bg-white/5 border border-white/10 rounded-lg">
                <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider mb-1">The Story</div>
                <p class="text-sm text-gray-300">{album.story}</p>
              </div>
            )}

            {album.topTracks.length > 0 && (
              <div class="mb-4">
                <div class="text-xs font-semibold text-gray-500 uppercase tracking-wider mb-2">Key Tracks</div>
                <ul class="space-y-1">
                  {album.topTracks.map((track) => (
                    <li class="text-sm text-gray-300 flex items-center gap-2">
                      <span class="text-emerald-400">♪</span> {track.name}
                      {track.plays && <span class="text-xs text-gray-500 ml-auto">{track.plays.toLocaleString()} plays</span>}
                    </li>
                  ))}
                </ul>
              </div>
            )}

            <div class="flex items-center justify-between">
              <div class="text-xs text-gray-500">{album.tracks ? album.tracks + ' tracks' : 'Album'}{album.duration ? ' · ' + album.duration : ''}</div>
              <a href={album.soundcloud} target="_blank" rel="noopener" class="text-sm text-orange-400 hover:text-orange-300 font-medium transition">
                Listen →
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>

    <!-- The Healing Arc -->
    <div class="mt-20 bg-[#0f0f1a] border border-white/10 rounded-xl p-8 md:p-12">
      <div class="text-center mb-8">
        <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/30 text-emerald-400 text-sm font-semibold px-4 py-1.5 rounded-full mb-4">
          🧬 The Healing Arc
        </div>
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-3" style="-webkit-text-fill-color: white;">
          Twelve Albums. One Documented Life.
        </h2>
        <p class="text-gray-400 max-w-2xl mx-auto">
          Read in order, the catalog isn't a collection of songs — it's a healing process made audible. From the confession to the rebirth, each album is a chapter in the same story.
        </p>
      </div>
      <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-4">
        {arc.map((chapter, i) => (
          <div class="flex items-start gap-3 p-4 bg-white/5 border border-white/10 rounded-lg hover:border-emerald-500/40 transition">
            <div class="flex-shrink-0 w-8 h-8 rounded-full bg-emerald-500/20 border border-emerald-500/40 text-emerald-400 flex items-center justify-center text-sm font-bold">
              {i + 1}
            </div>
            <div>
              <div class="text-xs font-semibold text-emerald-400 uppercase tracking-wider">{chapter.step}</div>
              <div class="text-sm text-gray-300 mt-0.5">{chapter.album}</div>
            </div>
          </div>
        ))}
      </div>
      <div class="mt-8 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg text-center">
        <p class="text-sm text-emerald-300">
          <strong>The most-played songs</strong> are the ones about being the villain, the immigrant's "I can't fail," the plea for more time, the moment you notice, the things never said, the hallway dad, and steady love. <span class="text-white">The confession. The roots. The quiet.</span>
        </p>
      </div>
    </div>

    <!-- Writing DNA Section -->
    <div class="mt-20 bg-[#0f0f1a] border border-white/10 rounded-xl p-8 md:p-12">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-6" style="-webkit-text-fill-color: white;">
        The CC3PO Writing DNA
      </h2>
      <div class="grid md:grid-cols-2 gap-8">
        <div>
          <h3 class="text-lg font-semibold text-emerald-400 mb-3">Voice & Delivery</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li>✦ Half-spoken, half-sung — conversational, not melodic</li>
            <li>✦ Confessional tone — like reading a private journal</li>
            <li>✦ Vulnerable but not weak — raw honesty, never pity-seeking</li>
            <li>✦ Bilingual code-switching — Spanish for emotional weight</li>
          </ul>
        </div>
        <div>
          <h3 class="text-lg font-semibold text-emerald-400 mb-3">Lyrical Patterns</h3>
          <ul class="space-y-2 text-sm text-gray-400">
            <li>✦ Specific detail over abstract emotion</li>
            <li>✦ Self-correction mid-thought</li>
            <li>✦ Admission of contradiction</li>
            <li>✦ Bilingual gut-punch refrains</li>
            <li>✦ Anti-hero narration — owning labels, rejecting narratives</li>
            <li>✦ Everyday imagery — phone, scrolling, driving</li>
          </ul>
        </div>
      </div>
      <div class="mt-8 p-4 bg-emerald-500/10 border border-emerald-500/30 rounded-lg">
        <p class="text-sm text-emerald-300">
          <strong>Production:</strong> AI-assisted tools co-create some instrumentals. <strong>Every lyric, edit, and emotional heartbeat is mine.</strong> Real voice. Real stories.
        </p>
      </div>
    </div>

    <!-- CTA -->
    <div class="mt-16 text-center">
      <h2 class="text-2xl md:text-3xl font-bold text-white mb-4" style="-webkit-text-fill-color: white;">
        Hear the Story
      </h2>
      <p class="text-gray-400 mb-8">
        {totalAlbums} albums. {totalTracks} tracks. One voice that refused to stay quiet.
      </p>
      <a href={artist.soundcloud} target="_blank" rel="noopener" class="inline-flex items-center gap-2 bg-orange-500 hover:bg-orange-400 text-white font-semibold px-8 py-3 rounded-lg transition">
        Listen on SoundCloud
      </a>
    </div>
  </section>
</Layout>