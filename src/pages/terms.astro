---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = "Terms of Service | CC3PO Insights";
const description = "Terms of Service for CC3PO Insights blog and content.";
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} />
  <style>
    .legal-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 100px 24px 60px;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #d4d4d8;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      padding: 10px 20px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      margin-bottom: 24px;
      transition: all 0.2s;
    }
    .back-link:hover { background: rgba(107,53,255,.1); border-color: rgba(107,53,255,.3); color: #fff; }
    .legal-page h1 {
      color: #e94560;
      font-size: clamp(28px, 5vw, 32px);
      margin-bottom: 8px;
    }
    .legal-page .last-updated {
      color: #888;
      font-size: 14px;
      margin-bottom: 40px;
    }
    .legal-page section { margin-bottom: 32px; }
    .legal-page h2 {
      color: #fafafa;
      font-size: 20px;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    .legal-page p, .legal-page li {
      color: #d4d4d8;
      line-height: 1.8;
    }
    .legal-page ul {
      margin-left: 24px;
      margin-bottom: 12px;
    }
    .legal-page li { margin-bottom: 8px; }
    .legal-page a {
      color: #4fc3f7;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .legal-page a:hover { color: #e94560; }
    .legal-page strong { color: #fafafa; }
    .legal-divider {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    @media (max-width: 768px) {
      .legal-page {
        padding: 80px 16px 60px;
      }
      .legal-page h1 { font-size: 24px; }
      .legal-page h2 { font-size: 18px; }
    }
  </style>
</head>
<body style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: #0a0a0b; color: #fafafa; line-height: 1.6; margin: 0; padding: 0; overflow-x: hidden;">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content" class="legal-page">
    <a href="/" class="back-link">← Back to Blog</a>
    
    <h1>Terms of Service</h1>
    <p class="last-updated">Last Updated: April 23, 2026</p>
    
    <section>
      <h2>1. Acceptance of Terms</h2>
      <p>By accessing and using CC3PO Insights (the blog and content at insights.cc3po.com), you accept and agree to be bound by these Terms of Service.</p>
    </section>
    
    <section>
      <h2>2. Content Use</h2>
      <p>All content on this blog is provided for informational and educational purposes. You may:</p>
      <ul>
        <li>Read and share individual articles with attribution</li>
        <li>Apply the knowledge to your own projects</li>
        <li>Link to specific articles from your own content</li>
      </ul>
      <p>You may not:</p>
      <ul>
        <li>Reproduce entire articles without permission</li>
        <li>Remove copyright or attribution notices</li>
        <li>Use content for commercial training without license</li>
      </ul>
    </section>
    
    <section>
      <h2>3. Intellectual Property</h2>
      <p>All content is owned by CC3PO unless otherwise stated. This includes:</p>
      <ul>
        <li>Articles, guides, and tutorials</li>
        <li>Images, graphics, and code examples</li>
        <li>Logos and branding elements</li>
      </ul>
    </section>
    
    <section>
      <h2>4. Disclaimer</h2>
      <p>Content is provided "as is" without warranty. We make no guarantees about:</p>
      <ul>
        <li>Accuracy or completeness of information</li>
        <li>Results from implementing guidance</li>
        <li>Current relevance of technical details</li>
      </ul>
      <p><strong>Always verify information before implementation.</strong></p>
    </section>
    
    <section>
      <h2>5. Contact Information</h2>
      <p>For questions about these Terms of Service:</p>
      <ul>
        <li>Email: <a href="mailto:legal@cc3po.com">legal@cc3po.com</a></li>
        <li>Main Site: <a href="https://cc3po.com">cc3po.com</a></li>
      </ul>
    </section>
    
    <div class="legal-divider">
      <a href="/" class="back-link">← Back to Blog</a>
    </div>
  </main>
  <Footer />
</body>
</html>