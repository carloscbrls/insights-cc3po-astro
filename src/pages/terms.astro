---
import Layout from '../layouts/Layout.astro';

const title = "Terms of Service | CC3PO Insights";
const description = "Terms of Service for CC3PO Insights blog and content.";
---

<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
</head>
<body style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: #0a0a0b; color: #fafafa; line-height: 1.6; margin: 0; padding: 0;">
  <div style="max-width: 800px; margin: 0 auto; padding: 40px 24px;">
    <a href="/" style="color: #e94560; text-decoration: none; font-weight: 600; margin-bottom: 24px; display: inline-block;">← Back to Blog</a>
    
    <h1 style="color: #e94560; font-size: 32px; margin-bottom: 8px;">Terms of Service</h1>
    <p style="color: #888; font-size: 14px; margin-bottom: 40px;">Last Updated: April 23, 2026</p>
    
    <section style="margin-bottom: 32px;">
      <h2 style="color: #1a1a2e; font-size: 20px; margin-top: 32px; margin-bottom: 12px;">1. Acceptance of Terms</h2>
      <p style="color: #4a4a5a; line-height: 1.8;">By accessing and using CC3PO Insights (the blog and content at insights.cc3po.com), you accept and agree to be bound by these Terms of Service.</p>
    </section>
    
    <section style="margin-bottom: 32px;">
      <h2 style="color: #1a1a2e; font-size: 20px; margin-top: 32px; margin-bottom: 12px;">2. Content Use</h2>
      <p style="color: #4a4a5a; line-height: 1.8;">All content on this blog is provided for informational and educational purposes. You may:</p>
      <ul style="color: #4a4a5a; line-height: 1.8; margin-left: 24px;">
        <li>Read and share individual articles with attribution</li>
        <li>Apply the knowledge to your own projects</li>
        <li>Link to specific articles from your own content</li>
      </ul>
      <p style="color: #4a4a5a; line-height: 1.8; margin-top: 12px;">You may not:</p>
      <ul style="color: #4a4a5a; line-height: 1.8; margin-left: 24px;">
        <li>Reproduce entire articles without permission</li>
        <li>Remove copyright or attribution notices</li>
        <li>Use content for commercial training without license</li>
      </ul>
    </section>
    
    <section style="margin-bottom: 32px;">
      <h2 style="color: #1a1a2e; font-size: 20px; margin-top: 32px; margin-bottom: 12px;">3. Intellectual Property</h2>
      <p style="color: #4a4a5a; line-height: 1.8;">All content is owned by CC3PO unless otherwise stated. This includes:</p>
      <ul style="color: #4a4a5a; line-height: 1.8; margin-left: 24px;">
        <li>Articles, guides, and tutorials</li>
        <li>Images, graphics, and code examples</li>
        <li>Logos and branding elements</li>
      </ul>
    </section>
    
    <section style="margin-bottom: 32px;">
      <h2 style="color: #1a1a2e; font-size: 20px; margin-top: 32px; margin-bottom: 12px;">4. Disclaimer</h2>
      <p style="color: #4a4a5a; line-height: 1.8;">Content is provided "as is" without warranty. We make no guarantees about:</p>
      <ul style="color: #4a4a5a; line-height: 1.8; margin-left: 24px;">
        <li>Accuracy or completeness of information</li>
        <li>Results from implementing guidance</li>
        <li>Current relevance of technical details</li>
      </ul>
      <p style="color: #4a4a5a; line-height: 1.8;"><strong>Always verify information before implementation.</strong></p>
    </section>
    
    <section style="margin-bottom: 32px;">
      <h2 style="color: #1a1a2e; font-size: 20px; margin-top: 32px; margin-bottom: 12px;">5. Contact Information</h2>
      <p style="color: #4a4a5a; line-height: 1.8;">For questions about these Terms of Service:</p>
      <ul style="color: #4a4a5a; line-height: 1.8; margin-left: 24px;">
        <li>Email: <a href="mailto:legal@cc3po.com" style="color: #e94560; text-decoration: none;">legal@cc3po.com</a></li>
        <li>Main Site: <a href="https://cc3po.com" style="color: #e94560; text-decoration: none;">cc3po.com</a></li>
      </ul>
    </section>
    
    <div style="margin-top: 48px; padding-top: 24px; border-top: 1px solid rgba(107, 53, 255, 0.1);">
      <a href="/" style="color: #e94560; text-decoration: none;">← Back to Blog</a>
    </div>
  </div>
</body>
</html>