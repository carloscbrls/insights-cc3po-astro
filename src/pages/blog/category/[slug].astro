---
import { getCollection } from 'astro:content';
import BaseHead from '../../../components/BaseHead.astro';
import Footer from '../../../components/Footer.astro';
import Header from '../../../components/Header.astro';
import PostCard from '../../../components/PostCard.astro';
import CategoryNav from '../../../components/CategoryNav.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
  
  return categories.map(category => ({
    params: { slug: category.toLowerCase().replace(/\s+/g, '-').replace(/&/g, 'and') },
    props: { category }
  }));
}

const { category } = Astro.props;
const { slug } = Astro.params;

// Get all posts for this category
const allPosts = await getCollection('blog');
const posts = allPosts
  .filter(post => post.data.category === category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

const SITE_TITLE = `${category} — CC3PO Insights`;
const SITE_DESCRIPTION = `${category} articles from CC3PO Insights — strategies, systems, and signals worth acting on.`;
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a0b;
        --card: #141418;
        --text: #fff;
        --muted: #d4d4d8;
        --primary: #e94560;
        --accent: #4fc3f7;
      }
      
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: Inter, system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
      }

      .category-hero {
        text-align: center;
        padding: 120px 24px 40px;
        max-width: 800px;
        margin: 0 auto;
      }

      .category-badge {
        display: inline-block;
        background: linear-gradient(135deg, #e94560, #8b5cf6);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.5px;
        color: #fff;
        margin-bottom: 16px;
      }

      .category-title {
        font-size: clamp(32px, 5vw, 48px);
        font-weight: 800;
        line-height: 1.15;
        margin-bottom: 16px;
        background: linear-gradient(135deg, #fff, #e4e4e7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .category-count {
        font-size: 18px;
        color: #d4d4d8;
        margin-bottom: 8px;
      }

      .category-description {
        font-size: 16px;
        color: #d4d4d8;
        line-height: 1.6;
      }

      .main-container {
        max-width: 1280px;
        margin: 0 auto;
        padding: 40px 24px 80px;
      }

      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
      }

      .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 20px;
        background: rgba(255,255,255,.05);
        border: 1px solid rgba(255,255,255,.08);
        border-radius: 12px;
        color: #d4d4d8;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        margin-bottom: 24px;
        transition: all 0.2s;
      }

      .back-link:hover {
        background: rgba(107,53,255,.1);
        border-color: rgba(107,53,255,.3);
        color: #fff;
      }

      @media (max-width: 768px) {
        .category-hero {
          padding: 100px 16px 24px;
        }

        .main-container {
          padding: 24px 16px 60px;
        }

        .posts-grid {
          grid-template-columns: 1fr;
        }
      }
    </style>
  </head>
  <body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    
    <header class="category-hero">
      <span class="category-badge">{category}</span>
      <h1 class="category-title">{category}</h1>
      <p class="category-count">{posts.length} article{posts.length !== 1 ? 's' : ''}</p>
    </header>

    <CategoryNav activeCategory={category} />

    <main id="main-content" class="main-container">
      <a href="/blog/" class="back-link">← Back to All Signals</a>
      <div class="posts-grid">
        {posts.map((post) => (
          <PostCard post={post} />
        ))}
      </div>
    </div>

    <Footer />
  </body>
</html>