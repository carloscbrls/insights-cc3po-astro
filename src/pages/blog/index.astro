---
import { Image } from 'astro:assets';
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';

const SITE_TITLE = 'CC3PO Insights - Expert Strategies for AI Automation & WordPress';
const SITE_DESCRIPTION = 'Expert strategies for AI automation, WordPress mastery, and scalable business systems. Daily insights from our AI village.';

const posts = (await getCollection('blog')).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
		<meta property="og:title" content={SITE_TITLE} />
		<meta property="og:description" content={SITE_DESCRIPTION} />
		<meta property="og:type" content="website" />
		<meta property="twitter:card" content="summary_large_image" />
		<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
		<style>
			:root {
				--bg: #0a0a0b;
				--card: #141418;
				--text: #fff;
				--muted: #a1a1aa;
				--primary: #6b35ff;
				--accent: #00d2ff;
				--grad: linear-gradient(135deg, #6b35ff, #00d2ff);
			}
			* { margin: 0; padding: 0; box-sizing: border-box; }
			body {
				font-family: Inter, system-ui, sans-serif;
				background: var(--bg);
				color: var(--text);
				line-height: 1.6;
			}
			.hero {
				min-height: 42vh;
				display: flex;
				flex-direction: column;
				align-items: center;
				justify-content: center;
				text-align: center;
				padding: 110px 24px 40px;
				background: radial-gradient(ellipse 80% 60% at 50% 0%, rgba(107,53,255,.15), transparent),
				            radial-gradient(ellipse 50% 40% at 85% 85%, rgba(0,210,255,.08), transparent),
				            linear-gradient(180deg, rgba(13,13,15,.98), #0a0a0b);
			}
			.hero h1 {
				font-size: clamp(34px, 5vw, 54px);
				font-weight: 800;
				background: linear-gradient(135deg, #fff, #a78bfa, #00d2ff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
				margin-bottom: 14px;
			}
			.hero p {
				font-size: clamp(15px, 2vw, 18px);
				color: var(--muted);
				max-width: 580px;
				margin-bottom: 24px;
			}
			.hero-stats {
				display: flex;
				gap: 24px;
				justify-content: center;
				flex-wrap: wrap;
			}
			.hero-stat {
				text-align: center;
				padding: 10px 20px;
				background: rgba(107,53,255,.1);
				border-radius: 12px;
				border: 1px solid rgba(107,53,255,.15);
			}
			.hero-stat .number {
				font-size: 20px;
				font-weight: 700;
				color: var(--primary);
			}
			.hero-stat .label {
				font-size: 11px;
				color: var(--muted);
				margin-top: 4px;
			}
			.trust-bar {
				background: linear-gradient(135deg, rgba(107,53,255,.05), rgba(0,210,255,.05));
				border-top: 1px solid rgba(255,255,255,.05);
				border-bottom: 1px solid rgba(255,255,255,.05);
				padding: 18px 24px;
				margin: 0 24px;
				border-radius: 14px;
				display: flex;
				justify-content: center;
				gap: 32px;
				flex-wrap: wrap;
			}
			.trust-item { text-align: center; }
			.trust-item span {
				font-size: 24px;
				font-weight: 700;
				background: linear-gradient(135deg, #6b35ff, #00d2ff);
				-webkit-background-clip: text;
				-webkit-text-fill-color: transparent;
			}
			.trust-item p {
				font-size: 11px;
				color: #a1a1aa;
				margin: 4px 0 0;
			}
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: center;
				max-width: 1280px;
				margin: 0 auto;
				padding: 36px 24px 0;
			}
			.section-header h2 { font-size: clamp(22px, 3vw, 32px); font-weight: 700; }
			.posts-grid {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
				gap: 22px;
				max-width: 1280px;
				margin: 0 auto;
				padding: 30px 24px;
			}
			.post {
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(255,255,255,.06);
				border-radius: 18px;
				overflow: hidden;
				transition: all 0.3s;
			}
			.post:hover {
				transform: translateY(-5px);
				border-color: rgba(107,53,255,.3);
				box-shadow: 0 18px 35px rgba(107,53,255,.12);
			}
			.post-image-container {
				position: relative;
				overflow: hidden;
				height: 180px;
			}
			.post-image {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s;
			}
			.post:hover .post-image { transform: scale(1.05); }
			.post-category {
				position: absolute;
				top: 10px;
				left: 10px;
				background: var(--grad);
				padding: 5px 12px;
				border-radius: 18px;
				font-size: 10px;
				font-weight: 600;
				color: #fff;
				z-index: 2;
			}
			.post-content { padding: 18px; }
			.post h3 {
				font-size: 16px;
				font-weight: 600;
				margin-bottom: 8px;
				line-height: 1.3;
			}
			.post h3 a { color: #fff; text-decoration: none; }
			.post h3 a:hover { color: var(--accent); }
			.post p { color: var(--muted); font-size: 13px; margin-bottom: 14px; }
			.post-meta {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding-top: 14px;
				border-top: 1px solid rgba(255,255,255,.06);
			}
			.post-meta span { color: #71717a; font-size: 11px; }
			.post-meta a {
				color: var(--primary);
				font-size: 12px;
				font-weight: 500;
				text-decoration: none;
			}
			.cta-section {
				background: linear-gradient(135deg, rgba(107,53,255,.08), rgba(0,210,255,.08));
				border: 1px solid rgba(107,53,255,.15);
				border-radius: 26px;
				padding: 44px;
				text-align: center;
				margin: 36px auto;
				max-width: 1200px;
			}
			.cta-section h3 { font-size: 24px; font-weight: 700; margin-bottom: 12px; }
			.cta-trust {
				display: flex;
				gap: 24px;
				justify-content: center;
				flex-wrap: wrap;
				margin-bottom: 20px;
			}
			.cta-trust-item { text-align: center; }
			.cta-trust-item span { font-size: 22px; font-weight: 700; color: var(--primary); }
			.cta-trust-item p { font-size: 11px; color: #a1a1aa; }
			.cta-section > p {
				color: var(--muted);
				font-size: 14px;
				margin-bottom: 22px;
				max-width: 480px;
				margin-left: auto;
				margin-right: auto;
			}
			.cta-buttons { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
			.cta-btn {
				display: inline-flex;
				align-items: center;
				gap: 8px;
				padding: 12px 28px;
				border-radius: 26px;
				font-size: 14px;
				font-weight: 600;
				text-decoration: none;
			}
			.cta-btn.primary { background: var(--grad); color: #fff; }
			.cta-btn.secondary {
				background: rgba(255,255,255,.05);
				border: 1px solid rgba(255,255,255,.1);
				color: #fff;
			}
			.testimonials {
				background: rgba(255,255,255,.02);
				border-radius: 18px;
				padding: 28px;
				margin: 24px auto;
				max-width: 1280px;
			}
			.testimonials h4 {
				font-size: 15px;
				font-weight: 600;
				margin-bottom: 18px;
				color: #fff;
			}
			.testimonial-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
				gap: 16px;
			}
			.testimonial {
				background: rgba(107,53,255,.05);
				border-radius: 12px;
				padding: 18px;
				text-align: left;
				border: 1px solid rgba(107,53,255,.1);
			}
			.testimonial-content {
				font-size: 13px;
				color: var(--muted);
				margin-bottom: 12px;
				font-style: italic;
			}
			.testimonial-author { display: flex; align-items: center; gap: 10px; }
			.testimonial-avatar {
				width: 36px;
				height: 36px;
				border-radius: 50%;
				background: var(--grad);
				display: flex;
				align-items: center;
				justify-content: center;
				font-weight: 700;
				font-size: 14px;
				color: #fff;
			}
			.testimonial-info { text-align: left; }
			.testimonial-name { font-size: 13px; font-weight: 600; color: #fff; }
			.testimonial-title { font-size: 11px; color: var(--muted); }
			.newsletter {
				background: linear-gradient(145deg, #141418, #0f0f11);
				border: 1px solid rgba(255,255,255,.06);
				border-radius: 22px;
				padding: 36px;
				margin: 36px auto;
				max-width: 900px;
				text-align: center;
			}
			.newsletter h3 { font-size: 22px; font-weight: 700; margin-bottom: 8px; }
			.newsletter > p { color: var(--muted); font-size: 13px; margin-bottom: 20px; }
			.newsletter-form {
				display: flex;
				gap: 12px;
				justify-content: center;
				flex-wrap: wrap;
				max-width: 450px;
				margin: 0 auto;
			}
			.newsletter-form input {
				flex: 1;
				min-width: 220px;
				padding: 12px 18px;
				border-radius: 26px;
				border: 1px solid rgba(255,255,255,.1);
				background: rgba(255,255,255,.03);
				color: #fff;
				font-size: 14px;
			}
			.newsletter-form input:focus {
				outline: none;
				border-color: var(--primary);
			}
			.newsletter-form button {
				padding: 12px 26px;
				border-radius: 26px;
				background: var(--grad);
				color: #fff;
				font-weight: 600;
				font-size: 14px;
				border: none;
				cursor: pointer;
			}
			.newsletter-microcopy {
				font-size: 11px;
				color: #71717a;
				margin-top: 12px;
			}
			.newsletter-microcopy a { color: var(--primary); text-decoration: none; }
			@media (max-width: 768px) {
				.trust-bar { gap: 20px; padding: 14px; }
				.posts-grid { grid-template-columns: 1fr; }
				.hero { padding: 100px 16px 36px; }
				.cta-section { padding: 32px 20px; }
				.cta-trust { gap: 16px; }
				.newsletter { padding: 28px 20px; }
				.newsletter-form { flex-direction: column; }
				.newsletter-form input { min-width: 100%; }
				.testimonial-grid { grid-template-columns: 1fr; }
			}
		</style>
	</head>
	<body>
		<Header />
		<section class="hero">
			<h1>AI & Automation Insights</h1>
			<p>Expert strategies for growing your business with technology. Daily content created by our AI village.</p>
			<div class="hero-stats">
				<div class="hero-stat">
					<div class="number">{posts.length}</div>
					<div class="label">Latest Posts</div>
				</div>
				<div class="hero-stat">
					<div class="number">Daily</div>
					<div class="label">New Content</div>
				</div>
				<div class="hero-stat">
					<div class="number">11</div>
					<div class="label">AI Agents</div>
				</div>
			</div>
		</section>
		<div class="trust-bar">
			<div class="trust-item"><span>50+</span><p>Websites</p></div>
			<div class="trust-item"><span>15+</span><p>Years</p></div>
			<div class="trust-item"><span>24/7</span><p>AI Support</p></div>
			<div class="trust-item"><span>100%</span><p>Client Focus</p></div>
		</div>
		<div class="section-header">
			<h2>Latest Insights</h2>
		</div>
		<div class="posts-grid">
			{posts.map((post) => (
				<article class="post">
					<div class="post-image-container">
						<span class="post-category">{post.data.category}</span>
						<a href={`/blog/${post.id}/`}>
							{post.data.heroImage && (
								<Image class="post-image" width={720} height={360} src={post.data.heroImage} alt={post.data.title} loading="lazy" />
							)}
						</a>
					</div>
					<div class="post-content">
						<h3><a href={`/blog/${post.id}/`}>{post.data.title}</a></h3>
						<p>{post.data.description}</p>
						<div class="post-meta">
							<span><FormattedDate date={post.data.pubDate} /></span>
							<a href={`/blog/${post.id}/`}>Read more →</a>
						</div>
					</div>
				</article>
			))}
		</div>
		<section class="cta-section">
			<h3>Ready to Transform Your Business?</h3>
			<div class="cta-trust">
				<div class="cta-trust-item"><span>50+</span><p>Websites</p></div>
				<div class="cta-trust-item"><span>15+</span><p>Years</p></div>
				<div class="cta-trust-item"><span>24/7</span><p>AI Support</p></div>
			</div>
			<p>Let's discuss how AI automation and modern WordPress can accelerate your growth.</p>
			<div class="cta-buttons">
				<a href="https://offers.cc3po.com/our-services.html" class="cta-btn primary">Get Started Today</a>
				<a href="https://cc3po.com/contact/" class="cta-btn secondary">Schedule Free Call</a>
			</div>
		</section>
		<div class="testimonials">
			<h4>What Clients Say</h4>
			<div class="testimonial-grid">
				<div class="testimonial">
					<div class="testimonial-content">"CC3PO automated our entire lead workflow. We went from 10 leads/month to 85+. Best investment we've made."</div>
					<div class="testimonial-author">
						<div class="testimonial-avatar">AL</div>
						<div class="testimonial-info">
							<div class="testimonial-name">Dr. Alan Lee</div>
							<div class="testimonial-title">Dental Practice, Manteca - 3 Year Client</div>
						</div>
					</div>
				</div>
				<div class="testimonial">
					<div class="testimonial-content">"The AI village approach is genius. Content that used to take us 2 weeks now publishes automatically every day."</div>
					<div class="testimonial-author">
						<div class="testimonial-avatar">SM</div>
						<div class="testimonial-info">
							<div class="testimonial-name">Sarah Mitchell</div>
							<div class="testimonial-title">Nonprofit Director, Sacramento</div>
						</div>
					</div>
				</div>
				<div class="testimonial">
					<div class="testimonial-content">"Carlos understands AI at a level most consultants don't. He trained the AI that powers Tesla Autopilot."</div>
					<div class="testimonial-author">
						<div class="testimonial-avatar">RJ</div>
						<div class="testimonial-info">
							<div class="testimonial-name">Robert Johnson</div>
							<div class="testimonial-title">Tech Startup CEO, SF</div>
						</div>
					</div>
				</div>
			</div>
		</div>
		<section class="newsletter" id="newsletter-section">
			<h3>Get Weekly Insights Delivered</h3>
			<p>🔥 Join 1,000+ business owners receiving our latest strategies.</p>
			<form class="newsletter-form" id="newsletter-form">
				<input type="email" name="email" placeholder="Enter your email" required />
				<button type="submit">Subscribe</button>
			</form>
			<div class="newsletter-microcopy">🔒 Your info is secure. Unsubscribe anytime. <a href="https://cc3po.com/privacy/">Privacy Policy</a></div>
		</section>
		<script>
			document.getElementById('newsletter-form')?.addEventListener('submit', async (e) => {
				e.preventDefault();
				const form = e.target as HTMLFormElement;
				const email = (form.querySelector('input[type=email]') as HTMLInputElement).value;
				try {
					const res = await fetch('/api/subscribe', {
						method: 'POST',
						headers: { 'Content-Type': 'application/json' },
						body: JSON.stringify({ email })
					});
					const data = await res.json();
					if (data.success) {
						alert(data.message || 'Thanks for subscribing!');
						form.reset();
					} else {
						alert(data.error || 'Error');
					}
				} catch (err) {
					alert('Error: ' + err);
				}
			});
		</script>
		<Footer />
	</body>
</html>