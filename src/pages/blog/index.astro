---
import { getCollection } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import BlogHero from '../../components/BlogHero.astro';
import PostCard from '../../components/PostCard.astro';
import CategoryNav from '../../components/CategoryNav.astro';
import Sidebar from '../../components/Sidebar.astro';
import NewsletterSignup from '../../components/NewsletterSignup.astro';

const SITE_TITLE = 'Signal — CC3PO Insights | AI Automation & WordPress Intelligence';
const SITE_DESCRIPTION = 'Intelligence from the AI village — strategies, systems, and signals worth acting on. Daily insights for growing your business.';

// Get all posts sorted by date
const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Get featured post (most recent)
const featuredPost = posts[0];
const latestPosts = posts.slice(1, 5);
const remainingPosts = posts.slice(1);

// Get unique categories for stats
const categories = [...new Set(posts.map(post => post.data.category).filter(Boolean))];
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      :root {
        --bg: #0a0a0b;
        --card: #141418;
        --text: #fff;
        --muted: #d4d4d8;
        --primary: #e94560;
        --accent: #4fc3f7;
        --grad: #e94560;
      }
      
      * { 
        margin: 0; 
        padding: 0; 
        box-sizing: border-box; 
      }
      
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border-width: 0; }
      
      body {
        font-family: Inter, system-ui, sans-serif;
        background: var(--bg);
        color: var(--text);
        line-height: 1.6;
        min-height: 100vh;
      }

      /* Main Content Layout */
      .main-container {
        display: flex;
        max-width: 1400px;
        margin: 0 auto;
        padding: 0 24px 60px;
        gap: 40px;
      }

      .content-area {
        flex: 1;
        min-width: 0;
      }

      /* Section Headers */
      .section-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        padding-top: 40px;
      }

      .section-header h2 {
        font-size: 24px;
        font-weight: 700;
        color: #fff;
        display: flex;
        align-items: center;
        gap: 12px;
      }

      .section-header h2::after {
        content: '';
        width: 40px;
        height: 2px;
        background: linear-gradient(90deg, #e94560, transparent);
      }

      .view-all-link {
        color: #e94560;
        text-decoration: none;
        font-size: 14px;
        font-weight: 500;
        display: flex;
        align-items: center;
        gap: 4px;
        transition: gap 0.2s;
      }

      .view-all-link:hover {
        gap: 8px;
      }

      /* Posts Grid */
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 24px;
      }

      /* Stats Bar */
      .stats-bar {
        display: flex;
        justify-content: center;
        gap: 48px;
        padding: 24px;
        margin: 40px 24px;
        background: linear-gradient(135deg, rgba(107,53,255,.05), rgba(0,210,255,.05));
        border: 1px solid rgba(255,255,255,.06);
        border-radius: 16px;
      }

      .stat-item {
        text-align: center;
      }

      .stat-number {
        font-size: 28px;
        font-weight: 800;
        background: #e94560;
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
      }

      .stat-label {
        font-size: 13px;
        color: #d4d4d8;
        margin-top: 4px;
      }

      /* Responsive */
      @media (max-width: 1024px) {
        .main-container {
          flex-direction: column;
          gap: 32px;
        }

        .sidebar-area {
          width: 100%;
        }
      }

      @media (max-width: 768px) {
        .main-container {
          padding: 0 16px 40px;
        }

        .posts-grid {
          grid-template-columns: 1fr;
        }

        .stats-bar {
          flex-wrap: wrap;
          gap: 24px;
          margin: 24px 16px;
        }

        .section-header {
          flex-direction: column;
          align-items: flex-start;
          gap: 12px;
        }
      }
    </style>
  </head>
  <body>
		<a href="#main-content" class="skip-link">Skip to main content</a>
    <Header />
    
    <main id="main-content">
    <h1 class="sr-only">CC3PO Insights Blog — All Articles</h1>
    <!-- Hero Section -->
    <BlogHero featuredPost={featuredPost} latestPosts={latestPosts} />

    <!-- Stats Bar -->
    <div class="stats-bar">
      <div class="stat-item">
        <div class="stat-number">{posts.length}</div>
        <div class="stat-label">Signals</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">{categories.length}</div>
        <div class="stat-label">Categories</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">Weekly</div>
        <div class="stat-label">New Signals</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">AI-Powered</div>
      </div>
    </div>

    <!-- Category Navigation -->
    <CategoryNav activeCategory="All" />

    <!-- Main Content Area -->
    <div class="main-container">
      <div class="content-area">
        <div class="section-header">
          <h2>All Signals</h2>
        </div>
        <div class="posts-grid">
          {remainingPosts.map((post) => (
            <PostCard post={post} />
          ))}
        </div>

        <!-- Newsletter CTA -->
        <NewsletterSignup variant="inline" />
      </div>

      <!-- Sidebar -->
      <div class="sidebar-area">
        <Sidebar />
      </div>
    </div>

    <Footer />
  </body>
</html>
