---
// src/pages/bundles/it-owner.astro
// IT Owner Bundle — $397/mo
import '../../styles/global.css';

const tier = 'it-owner';
const price = 397;
const priceLabel = '$397/mo';
const title = 'IT Owner Bundle';
const subtitle = 'Full compliance & security suite for IT professionals';
const description = 'Enterprise-grade compliance, security posture management, and audit preparation for IT owners and MSPs. Stay ahead of SOC 2, GDPR, and every framework that matters.';

const features = [
  { icon: '⚡', title: 'Daily Telegram Alerts', desc: 'Security and compliance alerts delivered to your phone every morning' },
  { icon: '📋', title: 'Monthly PDF Reports', desc: 'Scorecards, vulnerability scans, compliance matrices, and incident timelines' },
  { icon: '🇪🇸', title: 'Spanish Toggle', desc: 'Full Spanish language support for bilingual teams' },
  { icon: '🆓', title: 'Free Tier Access', desc: '7-day free trial — no credit card required' },
  { icon: '🔒', title: '30-Day Auto-Cancel', desc: 'Auto-cancel if you\'re not engaged — we earn your subscription' },
  { icon: '🛡️', title: 'Dedup Protection', desc: 'Never double-billed — duplicate charge prevention built in' },
  { icon: '🚀', title: 'Priority Support', desc: 'Direct line to our compliance team — faster responses, deeper help' },
  { icon: '📊', title: 'Compliance Matrix', desc: 'Track your status across SOC 2, ISO 27001, GDPR, HIPAA, and more' },
];

const complianceFrameworks = [
  { name: 'SOC 2 Type II', status: '✅ Compliant', color: '#27ae60' },
  { name: 'ISO 27001', status: '🔄 In Progress', color: '#f39c12' },
  { name: 'GDPR', status: '✅ Compliant', color: '#27ae60' },
  { name: 'HIPAA', status: '📋 Planning', color: '#3498db' },
  { name: 'PCI DSS', status: '🔄 In Progress', color: '#f39c12' },
  { name: 'NIST CSF', status: '📋 Planning', color: '#3498db' },
];

const faqs = [
  { q: 'How is this different from the Local Business Bundle?', a: 'The IT Owner Bundle includes advanced compliance matrices, security posture monitoring, vulnerability scan tracking, and priority support — everything an IT owner or MSP needs.' },
  { q: 'Does it support MSP multi-tenant?', a: 'Yes! You can manage compliance for multiple client organizations from a single dashboard.' },
  { q: 'What compliance frameworks are covered?', a: 'SOC 2, ISO 27001, GDPR, HIPAA, PCI DSS, NIST CSF, and more. We continuously add new frameworks.' },
  { q: 'How does the 30-day auto-cancel work?', a: 'If we don\'t see any engagement (login, Telegram interaction, PDF download) for 30 days, we auto-cancel your subscription. No surprise charges.' },
  { q: 'Can I get a custom compliance matrix?', a: 'Yes — reach out to our compliance team and we\'ll build a custom matrix for your specific regulatory requirements.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — CC3PO</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://cc3po.com/bundles/it-owner" />
  <style>
    :root {
      --color-primary: #1a1a2e;
      --color-accent: #e94560;
      --color-accent2: #0f3460;
      --color-bg: #f0f2f5;
      --color-surface: #ffffff;
      --color-text: #1a1a2e;
      --color-muted: #555;
      --radius: 12px;
      --shadow: 0 4px 24px rgba(26, 26, 46, 0.12);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: var(--color-text); background: var(--color-bg); line-height: 1.6; }
    .hero { background: linear-gradient(135deg, #1a1a2e 0%, #16213e 50%, #0f3460 100%); color: #fff; padding: 80px 20px; text-align: center; position: relative; overflow: hidden; }
    .hero::before { content: ''; position: absolute; top: -50%; left: -50%; width: 200%; height: 200%; background: radial-gradient(circle, rgba(233, 69, 96, 0.1) 0%, transparent 50%); animation: pulse 8s ease-in-out infinite; }
    @keyframes pulse { 0%, 100% { transform: scale(1); } 50% { transform: scale(1.1); } }
    .hero h1 { font-size: 3rem; margin-bottom: 12px; position: relative; }
    .hero .subtitle { font-size: 1.3rem; opacity: 0.9; margin-bottom: 8px; position: relative; }
    .hero .badge { display: inline-block; background: var(--color-accent); padding: 4px 16px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-bottom: 16px; position: relative; }
    .hero .price { font-size: 3rem; font-weight: 800; position: relative; }
    .hero .price span { font-size: 1rem; font-weight: 400; opacity: 0.7; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; padding: 60px 0; }
    .feature-card { background: var(--color-surface); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); border-top: 3px solid var(--color-accent); transition: transform 0.2s; }
    .feature-card:hover { transform: translateY(-4px); }
    .feature-card .icon { font-size: 2rem; margin-bottom: 12px; }
    .feature-card h3 { font-size: 1.1rem; color: var(--color-primary); margin-bottom: 8px; }
    .feature-card p { color: var(--color-muted); font-size: 0.9rem; }
    .frameworks { background: var(--color-surface); border-radius: var(--radius); padding: 40px; margin: 40px 0; box-shadow: var(--shadow); }
    .frameworks h2 { font-size: 1.6rem; color: var(--color-primary); margin-bottom: 24px; }
    .framework-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(240px, 1fr)); gap: 16px; }
    .framework-item { display: flex; align-items: center; justify-content: space-between; padding: 16px 20px; border-radius: 8px; background: #f8f9fa; }
    .framework-item .name { font-weight: 600; }
    .framework-item .status { font-size: 0.9rem; font-weight: 600; }
    .cta-section { text-align: center; padding: 60px 20px; }
    .cta-button { display: inline-block; background: var(--color-accent); color: #fff; padding: 16px 48px; border-radius: 8px; font-size: 1.2rem; font-weight: 700; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
    .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(233, 69, 96, 0.3); }
    .cta-button.secondary { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); margin-left: 16px; }
    .cta-button.secondary:hover { background: var(--color-primary); color: #fff; }
    .faqs { padding: 40px 0; }
    .faq { background: var(--color-surface); border-radius: var(--radius); padding: 24px; margin-bottom: 16px; box-shadow: var(--shadow); }
    .faq h3 { color: var(--color-primary); font-size: 1.1rem; margin-bottom: 8px; }
    .faq p { color: var(--color-muted); }
    .guarantee { text-align: center; padding: 40px; color: var(--color-muted); font-size: 0.95rem; }
    .guarantee strong { color: var(--color-primary); }
    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .hero .price { font-size: 2.2rem; }
      .features { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <section class="hero">
    <div class="container">
      <div class="badge">⭐ Most Popular</div>
      <h1>🖥️ {title}</h1>
      <p class="subtitle">{subtitle}</p>
      <p class="price">{priceLabel} <span>/month</span></p>
    </div>
  </section>

  <section class="container">
    <div class="features">
      {features.map(f => (
        <div class="feature-card">
          <div class="icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>

    <div class="frameworks">
      <h2>📊 Compliance Frameworks</h2>
      <div class="framework-grid">
        {complianceFrameworks.map(fw => (
          <div class="framework-item">
            <span class="name">{fw.name}</span>
            <span class="status" style={`color: ${fw.color}`}>{fw.status}</span>
          </div>
        ))}
      </div>
    </div>

    <div class="cta-section">
      <a href={`/api/checkout?tier=${tier}`} class="cta-button">Get Started — {priceLabel}</a>
      <a href={`/api/free-access?tier=${tier}`} class="cta-button secondary">Try Free for 7 Days</a>
    </div>

    <div class="faqs">
      <h2 style="font-size: 1.8rem; color: var(--color-primary); margin-bottom: 24px;">Frequently Asked Questions</h2>
      {faqs.map(faq => (
        <div class="faq">
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </div>
      ))}
    </div>

    <div class="guarantee">
      <strong>30-Day Engagement Guarantee:</strong> If you're not actively using the service, we'll auto-cancel your subscription — no surprise charges, no hassle. Priority support means you always get answers fast.
    </div>
  </section>
</body>
</html>