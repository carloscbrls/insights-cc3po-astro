            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Email alerts
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-gray-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              No CWV monitoring
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-gray-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              No error monitoring
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-gray-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              No status page
            </li>
          </ul>
          <a href="https://checkout.cc3po.com/b/PLACEHOLDER_BASIC" class="block w-full bg-gray-800 hover:bg-gray-700 text-white font-semibold text-center py-3 rounded-lg transition">Buy Now — $49/mo</a>
        </div>

        <!-- Pro (Recommended) -->
        <div class="bg-gradient-to-b from-emerald-500/10 to-[#0f0f1a] border border-emerald-500/30 rounded-2xl p-6 flex flex-col relative">
          <div class="absolute -top-3 left-1/2 -translate-x-1/2 bg-emerald-500 text-black text-xs font-bold px-4 py-1 rounded-full">Most Popular</div>
          <h3 class="text-xl font-bold text-white mb-2">Pro</h3>
          <p class="text-sm text-gray-500 mb-4">For growing businesses that need full visibility</p>
          <div class="mb-6">
            <span class="text-4xl font-bold text-white">$97</span>
            <span class="text-gray-500">/mo</span>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Up to 10 sites
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              5-minute uptime checks
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Core Web Vitals (LCP, INP, CLS)
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Error log monitoring
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              SSL monitoring
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Email &amp; SMS alerts
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-500">
              <svg class="w-4 h-4 text-gray-600 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/></svg>
              No status page
            </li>
          </ul>
          <a href="https://checkout.cc3po.com/b/PLACEHOLDER_PRO" class="block w-full bg-emerald-500 hover:bg-emerald-400 text-black font-semibold text-center py-3 rounded-lg transition">Buy Now — $97/mo</a>
        </div>

        <!-- Enterprise -->
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-2xl p-6 flex flex-col">
          <h3 class="text-xl font-bold text-white mb-2">Enterprise</h3>
          <p class="text-sm text-gray-500 mb-4">For agencies and businesses that need it all</p>
          <div class="mb-6">
            <span class="text-4xl font-bold text-white">$197</span>
            <span class="text-gray-500">/mo</span>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Up to 25 sites
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Everything in Pro
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Public status page
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Monthly SLA PDF reports
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Telegram alerts
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Daily Telegram summaries
            </li>
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              99.9% uptime SLA
            </li>
          </ul>
          <a href="https://checkout.cc3po.com/b/PLACEHOLDER_ENTERPRISE" class="block w-full bg-gray-800 hover:bg-gray-700 text-white font-semibold text-center py-3 rounded-lg transition">Buy Now — $197/mo</a>
        </div>
      </div>
    </div>

    <!-- Comparison Table -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Plan Comparison</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-800">
              <th class="text-left py-3 pr-4 text-gray-400 font-medium">Feature</th>
              <th class="text-center py-3 px-4 text-gray-400 font-medium">Basic</th>
              <th class="text-center py-3 px-4 text-emerald-400 font-medium">Pro</th>
              <th class="text-center py-3 pl-4 text-emerald-400 font-medium">Enterprise</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Max sites</td>
              <td class="text-center py-3 px-4 text-gray-400">3</td>
              <td class="text-center py-3 px-4 text-gray-400">10</td>
              <td class="text-center py-3 pl-4 text-gray-400">25</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Uptime monitoring (5min)</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">SSL monitoring</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Email alerts</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Core Web Vitals</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Error monitoring</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">SMS alerts</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Public status page</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Monthly SLA reports</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Telegram alerts</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
