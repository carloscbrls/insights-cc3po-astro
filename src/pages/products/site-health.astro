---
// SiteHealth — Astro Product Page
// astro/site-health.astro

import Layout from '../../layouts/Layout.astro';
---

<Layout title="SiteHealth — Uptime, CWV & Error Monitoring + Status Page | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">SiteHealth</h1>
        <p class="text-xl text-gray-400 mb-6">Comprehensive website monitoring — uptime, Core Web Vitals, error tracking, and public status pages. Know before your customers do.</p>
        <div class="flex flex-wrap gap-3">
          <a href="/products/site-health/#pricing" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">See Plans — Starting at $49/mo</a>
          <a href="#free-check" class="inline-block border border-gray-700 hover:border-gray-500 text-gray-300 font-semibold px-8 py-3 rounded-lg transition">Free Site Check</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">$49</p>
        <p class="text-sm text-gray-500">per month</p>
        <p class="text-xs text-gray-600 mt-2">Cancel anytime</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is SiteHealth?</h2>
      <p class="text-gray-400 leading-relaxed">
        SiteHealth is a complete website monitoring platform that checks your sites every 5 minutes for uptime, 
        measures Core Web Vitals (LCP, INP, CLS) every hour, and monitors for JavaScript errors and broken resources. 
        Get instant alerts via email, SMS, or Telegram, and provide your customers with a beautiful public status page.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Add Your Sites</h3>
          <p class="text-sm text-gray-500">Enter your website URLs. We handle the rest — no code, no configuration.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Continuous Monitoring</h3>
          <p class="text-sm text-gray-500">Uptime checks every 5 minutes, CWV every hour, error scans every 15 minutes.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Instant Alerts</h3>
          <p class="text-sm text-gray-500">Get notified via email, SMS, or Telegram the moment something goes wrong.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">4</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Status Page + Reports</h3>
          <p class="text-sm text-gray-500">Public status page for your customers. Monthly SLA reports for your team.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Uptime monitoring every 5 minutes</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Core Web Vitals (LCP, INP, CLS, TTFB)</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">JavaScript error &amp; 4xx/5xx monitoring</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">SSL certificate expiry alerts</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Email, SMS &amp; Telegram alerts</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Public status page per client</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Daily Telegram one-liner summaries</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Monthly SLA PDF reports</span>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div id="pricing" class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">Simple Pricing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Basic -->
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-2xl p-6 flex flex-col">
          <h3 class="text-xl font-bold text-white mb-2">Basic</h3>
          <p class="text-sm text-gray-500 mb-4">For small sites that need basic monitoring</p>
          <div class="mb-6">
            <span class="text-4xl font-bold text-white">$49</span>
            <span class="text-gray-500">/mo</span>
          </div>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-2 text-sm text-gray-400">
              <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
