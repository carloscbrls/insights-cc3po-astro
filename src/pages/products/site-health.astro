            <tr>
              <td class="py-3 pr-4 text-gray-400">Daily summaries</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- Free Check -->
    <div id="free-check" class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6 text-center">Try It Free</h2>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-2xl p-8 max-w-lg mx-auto">
        <p class="text-gray-400 text-center mb-6">Enter your email and URL for a free health check. We'll send you the results.</p>
        <form id="freeCheckForm" class="space-y-4">
          <div>
            <label class="block text-sm text-gray-500 mb-1" for="email">Email</label>
            <input type="email" id="email" required class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-emerald-500" placeholder="you@company.com">
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1" for="url">Website URL</label>
            <input type="url" id="url" required class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-emerald-500" placeholder="https://yoursite.com">
          </div>
          <div>
            <label class="block text-sm text-gray-500 mb-1" for="company">Company (optional)</label>
            <input type="text" id="company" class="w-full bg-gray-900 border border-gray-700 rounded-lg px-4 py-2.5 text-white focus:outline-none focus:border-emerald-500" placeholder="Your Company Inc.">
          </div>
          <button type="submit" class="w-full bg-emerald-500 hover:bg-emerald-400 text-black font-semibold py-3 rounded-lg transition">Check My Site</button>
        </form>
        <div id="freeCheckResult" class="hidden mt-4 p-4 rounded-lg text-center"></div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Never Be Surprised by Downtime Again</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Start monitoring your websites in minutes. Cancel anytime.
      </p>
      <a href="#pricing" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">See Plans</a>
    </div>
  </section>
</Layout>

<script>
  // Free check form handler
  const form = document.getElementById('freeCheckForm');
  const result = document.getElementById('freeCheckResult');

  if (form) {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const email = document.getElementById('email').value;
      const url = document.getElementById('url').value;
      const company = document.getElementById('company').value;

      result.classList.remove('hidden');
      result.innerHTML = '<p class="text-gray-400">Checking your site...</p>';

      try {
        const response = await fetch('/api/free-check', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, url, company }),
        });

        const data = await response.json();

        if (data.success) {
          const statusEmoji = data.status === 'up' ? '✅' : data.status === 'degraded' ? '⚠️' : '🔴';
          result.innerHTML = `
            <p class="text-emerald-400 font-semibold mb-2">${statusEmoji} Check Complete!</p>
            <p class="text-gray-400 text-sm">${data.url}</p>
            <p class="text-gray-400 text-sm">Status: ${data.status} (${data.responseTimeMs}ms)</p>
            <p class="text-gray-500 text-xs mt-2">We'll email you the full report.</p>
          `;
        } else {
          result.innerHTML = `<p class="text-red-400">Error: ${data.error || 'Something went wrong'}</p>`;
        }
      } catch (err) {
        result.innerHTML = `<p class="text-red-400">Error: Could not reach server</p>`;
      }
    });
  }
</script>
