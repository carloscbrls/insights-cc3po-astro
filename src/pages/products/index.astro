---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="All Products — CC3PO">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">All Products</h1>
    <p class="text-gray-400 text-lg mb-12">Everything we offer to help your business grow and stay compliant.</p>

    <div class="space-y-8">
      <!-- Compliance Shield -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Compliance Shield</h2>
            <p class="text-gray-400 mb-4">Continuous ADA/WCAG monitoring for your website. Daily scans, automated alerts, and fix guidance to keep you compliant and reduce lawsuit risk.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Daily WCAG 2.2 AA scans</li>
              <li>✓ Email &amp; SMS alerts on new issues</li>
              <li>✓ Fix recommendations for each issue</li>
              <li>✓ Compliance dashboard</li>
            </ul>
            <a href="/products/shield/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">$97<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <a href="https://checkout.cc3po.com/b/5kQ5kC6fY3EX0v27Kc1B61s" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Buy Now</a>
          </div>
        </div>
      </div>

      <!-- Compliance Shield Pro -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Compliance Shield Pro</h2>
            <p class="text-gray-400 mb-4">Everything in Compliance Shield plus priority support, custom fix implementation, and detailed monthly compliance reports.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Everything in Compliance Shield</li>
              <li>✓ Priority support with 4-hour response</li>
              <li>✓ Custom fix implementation</li>
              <li>✓ Monthly compliance reports</li>
            </ul>
            <a href="/products/shield-pro/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">$199<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <a href="https://checkout.cc3po.com/b/aFadR833Mcbt0v2ggI1B61t" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Buy Now</a>
          </div>
        </div>
      </div>

      <!-- Compliance Pack -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Compliance Pack</h2>
            <p class="text-gray-400 mb-4">One-time compliance audit and fix. Perfect for getting compliant fast without a monthly commitment.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Full ADA/WCAG compliance audit</li>
              <li>✓ Detailed fix recommendations</li>
              <li>✓ Fix implementation</li>
              <li>✓ Compliance report</li>
            </ul>
            <a href="/products/compliance-pack/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">$199</p>
            <p class="text-xs text-gray-500">one-time</p>
            <a href="https://checkout.cc3po.com/b/5kQ8wO47Q3EXfpW4y01B61u" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Buy Now</a>
          </div>
        </div>
      </div>

      <!-- AI Voice Agent -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">AI Voice Agent</h2>
            <p class="text-gray-400 mb-4">24/7 AI receptionist for trades businesses. Never miss a call — we answer, qualify leads, book appointments, and send you SMS alerts.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ 24/7 call answering</li>
              <li>✓ Appointment booking</li>
              <li>✓ Lead qualification &amp; capture</li>
              <li>✓ SMS alerts for new leads</li>
            </ul>
            <a href="/products/voice-agent/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">$97<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Sign Up</a>
          </div>
        </div>
      </div>

      <!-- Website Monitoring -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Website Monitoring</h2>
            <p class="text-gray-400 mb-4">Hourly uptime, performance, and security checks for your website. Get instant alerts when something goes wrong.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Hourly uptime monitoring</li>
              <li>✓ Performance tracking</li>
              <li>✓ Security vulnerability checks</li>
              <li>✓ Email &amp; SMS alerts</li>
            </ul>
            <a href="/products/website-monitoring/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">$49<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <span class="mt-3 inline-block bg-gray-800 text-gray-500 font-semibold px-6 py-2 rounded-lg text-sm">Coming Soon</span>
          </div>
        </div>
      </div>

      <!-- Compliance Badge -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Compliance Badge</h2>
            <p class="text-gray-400 mb-4">Show the world you're ADA/WCAG compliant. Free basic badge or verified badge with monthly scans.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Free basic compliance badge</li>
              <li>✓ Verified badge with monthly scans</li>
              <li>✓ Display on your website</li>
              <li>✓ Trust signal for customers</li>
            </ul>
            <a href="/products/badge/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">Free – $99<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <a href="https://cc3po-compliance-bad-dmih.bolt.host" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Get Your Badge</a>
          </div>
        </div>
      </div>

      <!-- Quote Generator -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Quote Generator</h2>
            <p class="text-gray-400 mb-4">Generate professional quotes for your business. Free tier for basic quotes, paid tier for branded quotes with compliance check.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Professional quote templates</li>
              <li>✓ Free basic quotes</li>
              <li>✓ Branded quotes (paid)</li>
              <li>✓ Compliance check included</li>
            </ul>
            <a href="/products/quote-generator/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">Free – $49<span class="text-sm text-gray-500 font-normal">/mo</span></p>
            <a href="https://quote.cc3po.com" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Try It Free</a>
          </div>
        </div>
      </div>

      <!-- Free Business Scan -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Free Business Scan</h2>
            <p class="text-gray-400 mb-4">Enter your URL and get a free ADA/WCAG compliance scan. No signup required — instant results.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Free compliance scan</li>
              <li>✓ No signup required</li>
              <li>✓ Instant results</li>
              <li>✓ WCAG 2.2 AA analysis</li>
            </ul>
            <a href="/products/scan/" class="text-emerald-400 hover:text-emerald-300 text-sm font-medium transition">Learn more →</a>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">Free</p>
            <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Scan Your Site</a>
          </div>
        </div>
      </div>

      <!-- Partner Program -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Partner Program</h2>
            <p class="text-gray-400 mb-4">Join our partner program and earn commissions by referring businesses to CC3PO. Free to join.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Free to join</li>
              <li>✓ Earn commissions on referrals</li>
              <li>✓ Marketing materials included</li>
              <li>✓ Dedicated partner dashboard</li>
            </ul>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">Free</p>
            <a href="https://partners.cc3po.com" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Join Now</a>
          </div>
        </div>
      </div>

      <!-- Signature Portal -->
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 md:p-8">
        <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
          <div class="flex-1">
            <h2 class="text-xl font-bold text-white mb-2">Signature Portal</h2>
            <p class="text-gray-400 mb-4">Send, sign, and manage documents online. Secure electronic signatures for your business.</p>
            <ul class="text-sm text-gray-500 space-y-1 mb-4">
              <li>✓ Send documents for signature</li>
              <li>✓ Legally binding e-signatures</li>
              <li>✓ Document management</li>
              <li>✓ Secure &amp; encrypted</li>
            </ul>
          </div>
          <div class="text-right flex-shrink-0">
            <p class="text-2xl font-bold text-emerald-400">Free</p>
            <a href="https://sign.cc3po.com" class="mt-3 inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Open Portal</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Layout>
