---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Compliance Badge — Show You're ADA/WCAG Compliant | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Compliance Badge</h1>
        <p class="text-xl text-gray-400 mb-6">Show the world you're ADA/WCAG compliant. Free basic badge or verified badge with monthly scans.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://cc3po-compliance-bad-dmih.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Get Your Badge</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">Free</p>
        <p class="text-sm text-gray-500">– $99/mo</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is the Compliance Badge?</h2>
      <p class="text-gray-400 leading-relaxed">
        The Compliance Badge lets you display your ADA/WCAG compliance status on your website. 
        Choose a free basic badge to show your commitment to accessibility, or upgrade to a verified 
        badge with monthly compliance scans for maximum trust.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Choose Your Badge</h3>
          <p class="text-sm text-gray-500">Select free basic or verified badge with monthly scans.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Add to Your Site</h3>
          <p class="text-sm text-gray-500">Copy a snippet of code and paste it on your website.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Build Trust</h3>
          <p class="text-sm text-gray-500">Visitors see your badge and know you take accessibility seriously.</p>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Pricing</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Free</h3>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$0</p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Basic compliance badge</li>
            <li>✓ Display on your website</li>
            <li>✓ Self-certification</li>
          </ul>
          <a href="https://cc3po-compliance-bad-dmih.bolt.host" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Get Free Badge</a>
        </div>
        <div class="bg-[#0f0f1a] border border-emerald-500/30 rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-white">Verified</h3>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">Recommended</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$99<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Verified compliance badge</li>
            <li>✓ Monthly compliance scans</li>
            <li>✓ Real-time status updates</li>
            <li>✓ Priority support</li>
          </ul>
          <a href="https://cc3po-compliance-bad-dmih.bolt.host" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Get Verified</a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Show Your Commitment to Accessibility</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Get your Compliance Badge today and let your customers know you care.
      </p>
      <a href="https://cc3po-compliance-bad-dmih.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Get Your Badge</a>
    </div>
  </section>
</Layout>
