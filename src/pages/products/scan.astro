---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Free Business Scan — ADA/WCAG Compliance Check | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Free Business Scan</h1>
        <p class="text-xl text-gray-400 mb-6">Enter your URL and get a free ADA/WCAG compliance scan. No signup required — instant results.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Scan Your Site Now</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Always</p>
        <p class="text-4xl font-bold text-emerald-400">Free</p>
        <p class="text-sm text-gray-500">no signup required</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is the Free Business Scan?</h2>
      <p class="text-gray-400 leading-relaxed">
        The Free Business Scan checks your website for ADA/WCAG 2.2 AA compliance issues. 
        Just enter your URL and get instant results showing what needs to be fixed. No signup, 
        no credit card, no commitment.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Enter Your URL</h3>
          <p class="text-sm text-gray-500">Type or paste your website URL into the scanner.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Scan</h3>
          <p class="text-sm text-gray-500">Our scanner checks your site against WCAG 2.2 AA standards.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Get Results</h3>
          <p class="text-sm text-gray-500">Instant report showing compliance issues and how to fix them.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">What You Get</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Free compliance scan</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">No signup required</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Instant results</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">WCAG 2.2 AA analysis</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Issue descriptions &amp; locations</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Fix recommendations</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">See How Your Site Stacks Up</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Free, instant, no strings attached. Find out if your website is compliant.
      </p>
      <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Scan Your Site Now</a>
    </div>
  </section>
</Layout>
