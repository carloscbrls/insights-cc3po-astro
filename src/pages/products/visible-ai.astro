// Spanish toggle support
const locale = Astro.url.searchParams.get('lang') || 'en';
const t = locale === 'es' ? translations.es : translations.en;
---

<Layout title={t.title}>
  <section class="max-w-4xl mx-auto px-4 py-16">
    <!-- Back link + language toggle -->
    <div class="flex items-center justify-between mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; {t.backToProducts}</a>
      <a href={locale === 'es' ? '/products/visible-ai/' : '/products/visible-ai/?lang=es'} class="text-sm text-gray-500 hover:text-emerald-400 transition">
        {locale === 'es' ? t.englishToggle : t.spanishToggle}
      </a>
    </div>

    <!-- Hero -->
    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <div class="flex items-center gap-2 mb-2">
          <span class="text-xs font-semibold bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">AI</span>
          <span class="text-xs font-semibold bg-purple-500/10 text-purple-400 px-2 py-1 rounded-full">{t.new}</span>
        </div>
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">{t.title}</h1>
        <p class="text-xl text-gray-400 mb-6">{t.subtitle}</p>
        <div class="flex flex-wrap gap-3">
          <a href="#pricing" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">{t.startFree}</a>
          <a href="#free-scan" class="inline-block border border-gray-700 hover:border-emerald-500 text-gray-300 hover:text-emerald-400 font-semibold px-8 py-3 rounded-lg transition">{t.tryItFree}</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">{t.startingAt}</p>
        <p class="text-4xl font-bold text-emerald-400">$79</p>
        <p class="text-sm text-gray-500">{t.perMonth}</p>
        <p class="text-xs text-gray-600 mt-2">{t.freeTrial}</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">{t.whatIs}</h2>
      <p class="text-gray-400 leading-relaxed">{t.whatIsDesc}</p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">{t.howItWorks}</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
