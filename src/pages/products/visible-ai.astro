<script>
  // Free scan form handler
  document.getElementById('visibleai-free-scan-form')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const form = e.target;
    const data = Object.fromEntries(new FormData(form));
    const resultDiv = document.getElementById('visibleai-scan-result');

    resultDiv.innerHTML = '<span class="text-gray-400">Submitting...</span>';

    try {
      const response = await fetch('https://cc3po.com/api/visible-ai/free-scan', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });

      const result = await response.json();
      resultDiv.innerHTML = result.success
        ? '<span class="text-emerald-400">' + result.message + '</span>'
        : '<span class="text-red-400">' + result.message + '</span>';
    } catch (error) {
      resultDiv.innerHTML = '<span class="text-red-400">An error occurred. Please try again.</span>';
    }
  });
</script>


