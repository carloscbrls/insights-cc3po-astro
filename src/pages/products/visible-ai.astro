          <h3 class="text-sm font-semibold text-white">ChatGPT</h3>
          <p class="text-xs text-gray-500">{t.aiChat}</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-4 text-center">
          <div class="text-2xl mb-2">🌐</div>
          <h3 class="text-sm font-semibold text-white">Gemini</h3>
          <p class="text-xs text-gray-500">{t.aiAssistant}</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-4 text-center">
