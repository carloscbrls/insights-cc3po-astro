---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Compliance Shield Pro — Priority ADA/WCAG Monitoring | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Compliance Shield Pro</h1>
        <p class="text-xl text-gray-400 mb-6">Everything in Compliance Shield plus priority support, custom fix implementation, and detailed monthly compliance reports.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://checkout.cc3po.com/b/aFadR833Mcbt0v2ggI1B61t" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Buy Now — $199/mo</a>
          <a href="/products/shield/" class="inline-block border border-gray-700 hover:border-gray-500 text-gray-300 font-semibold px-8 py-3 rounded-lg transition">Compare with Shield</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">$199</p>
        <p class="text-sm text-gray-500">per month</p>
        <p class="text-xs text-gray-600 mt-2">Cancel anytime</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is Compliance Shield Pro?</h2>
      <p class="text-gray-400 leading-relaxed">
        Compliance Shield Pro is our premium ADA/WCAG monitoring service. You get everything from Compliance Shield 
        plus priority support with 4-hour response time, custom fix implementation by our team, and detailed monthly 
        compliance reports perfect for legal documentation.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Daily Scans + Priority Alerts</h3>
          <p class="text-sm text-gray-500">Daily WCAG 2.2 AA scans with priority alerts sent directly to your phone and email.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Fix Issues For You</h3>
          <p class="text-sm text-gray-500">Our team implements fixes for compliance issues. No need to involve your developer.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Monthly Reports</h3>
          <p class="text-sm text-gray-500">Get detailed monthly compliance reports with trends, fixes applied, and recommendations.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Everything in Compliance Shield</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Priority support — 4-hour response</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Custom fix implementation by our team</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Monthly compliance reports</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Dedicated compliance specialist</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Cancel anytime</span>
        </div>
      </div>
    </div>

    <!-- Comparison -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Shield vs Shield Pro</h2>
      <div class="overflow-x-auto">
        <table class="w-full text-sm">
          <thead>
            <tr class="border-b border-gray-800">
              <th class="text-left py-3 pr-4 text-gray-400 font-medium">Feature</th>
              <th class="text-center py-3 px-4 text-gray-400 font-medium">Shield</th>
              <th class="text-center py-3 pl-4 text-emerald-400 font-medium">Shield Pro</th>
            </tr>
          </thead>
          <tbody>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Daily WCAG 2.2 AA scans</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Email &amp; SMS alerts</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Fix recommendations</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Compliance dashboard</td>
              <td class="text-center py-3 px-4 text-emerald-400">✓</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Priority support (4hr response)</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Custom fix implementation</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr class="border-b border-gray-800/50">
              <td class="py-3 pr-4 text-gray-400">Monthly compliance reports</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
            <tr>
              <td class="py-3 pr-4 text-gray-400">Dedicated specialist</td>
              <td class="text-center py-3 px-4 text-gray-600">—</td>
              <td class="text-center py-3 pl-4 text-emerald-400">✓</td>
            </tr>
          </tbody>
        </table>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Go Pro. Stay Protected.</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Get priority support and custom fixes with Compliance Shield Pro.
      </p>
      <a href="https://checkout.cc3po.com/b/aFadR833Mcbt0v2ggI1B61t" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Buy Now — $199/mo</a>
    </div>
  </section>
</Layout>
