  <script>
    async function handleFreeScan(event) {
      event.preventDefault();
      const url = document.getElementById('scan-url').value;
      const resultDiv = document.getElementById('scan-result');
      resultDiv.classList.remove('hidden');
      resultDiv.innerHTML = '<p class="text-gray-400 text-center">Scanning... <span class="animate-pulse">⏳</span></p>';

      try {
        const response = await fetch('https://disclose-shield-scanner.cc3po.workers.dev/scan', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ url })
        });
        const data = await response.json();

        if (data.status === 'ok') {
          const chatbots = data.chatbots || [];
          const compliant = chatbots.filter(c => c.compliant).length;
          const total = chatbots.length;

          resultDiv.innerHTML = `
            <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
              <h3 class="text-lg font-semibold text-white mb-3">Scan Results for ${url}</h3>
              <div class="grid grid-cols-2 gap-4 mb-4">
                <div class="text-center p-3 bg-gray-800/30 rounded-lg">
                  <p class="text-2xl font-bold text-white">${total}</p>
                  <p class="text-xs text-gray-500">Chatbots Found</p>
                </div>
                <div class="text-center p-3 bg-gray-800/30 rounded-lg">
                  <p class="text-2xl font-bold text-emerald-400">${compliant}</p>
                  <p class="text-xs text-gray-500">Compliant</p>
                </div>
              </div>
              ${chatbots.length > 0 ? `
                <div class="space-y-2">
                  ${chatbots.map(c => `
                    <div class="flex items-center justify-between p-2 bg-gray-800/20 rounded-lg">
                      <span class="text-sm text-gray-400">${c.type}</span>
                      <span class="text-xs ${c.compliant ? 'text-emerald-400' : 'text-red-400'}">${c.compliant ? '✓ Compliant' : '✗ Missing disclosure'}</span>
                    </div>
                  `).join('')}
                </div>
              ` : '<p class="text-sm text-gray-500 text-center">No AI chatbots detected on this page.</p>'}
              <p class="text-xs text-gray-600 mt-4 text-center">Want daily monitoring? <a href="#pricing" class="text-emerald-400 hover:text-emerald-300">View plans →</a></p>
            </div>
          `;
        } else {
          resultDiv.innerHTML = `<p class="text-red-400 text-center">Error: ${data.error || 'Scan failed'}</p>`;
        }
      } catch (err) {
        resultDiv.innerHTML = `<p class="text-red-400 text-center">Error: ${err.message}</p>`;
      }

      return false;
    }
  </script>
