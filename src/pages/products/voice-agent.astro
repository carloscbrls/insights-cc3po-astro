---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="AI Voice Agent — 24/7 AI Receptionist for Trades | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">AI Voice Agent</h1>
        <p class="text-xl text-gray-400 mb-6">24/7 AI receptionist for trades businesses. Never miss a call — we answer, qualify leads, book appointments, and send you SMS alerts.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Sign Up — $97/mo</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">$97</p>
        <p class="text-sm text-gray-500">per month</p>
        <p class="text-xs text-gray-600 mt-2">Cancel anytime</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is the AI Voice Agent?</h2>
      <p class="text-gray-400 leading-relaxed">
        The AI Voice Agent is a 24/7 AI receptionist designed specifically for trades and service businesses. 
        It answers every call, qualifies leads, books appointments, and sends you instant SMS alerts — so you 
        never miss a business opportunity, even when you're on the job.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Sign Up</h3>
          <p class="text-sm text-gray-500">Create your account and set up your business profile in minutes.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Get a Number</h3>
          <p class="text-sm text-gray-500">We assign you a local phone number that forwards to our AI agent.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Answer Calls</h3>
          <p class="text-sm text-gray-500">Our AI answers every call 24/7, qualifies the lead, and books appointments.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">4</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">You Get Leads</h3>
          <p class="text-sm text-gray-500">New leads and appointments are sent to your phone via SMS instantly.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">24/7 call answering — never miss a lead</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Automatic appointment booking</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Lead qualification &amp; capture</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Instant SMS alerts for new leads</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Natural conversation AI</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Local phone number included</span>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Pricing</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Basic</h3>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$97<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ 24/7 call answering</li>
            <li>✓ Up to 500 minutes/month</li>
            <li>✓ Lead capture &amp; SMS alerts</li>
            <li>✓ Appointment booking</li>
            <li>✓ Local phone number</li>
          </ul>
          <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Sign Up</a>
        </div>
        <div class="bg-[#0f0f1a] border border-emerald-500/30 rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-white">Pro</h3>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">Popular</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$199<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Everything in Basic</li>
            <li>✓ Unlimited minutes</li>
            <li>✓ Custom AI voice &amp; script</li>
            <li>✓ CRM integration</li>
            <li>✓ Priority support</li>
          </ul>
          <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Sign Up</a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Never Miss a Lead Again</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Your AI receptionist is ready. Start taking calls 24/7 today.
      </p>
      <a href="https://cc3po-compliance-sca-nvsn.bolt.host" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Sign Up — $97/mo</a>
    </div>
  </section>
</Layout>
