---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Compliance Shield — Continuous ADA/WCAG Monitoring | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Compliance Shield</h1>
        <p class="text-xl text-gray-400 mb-6">Continuous ADA/WCAG monitoring for your website. Daily scans, automated alerts, and fix guidance to keep you compliant and reduce lawsuit risk.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://checkout.cc3po.com/b/5kQ5kC6fY3EX0v27Kc1B61s" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Buy Now — $97/mo</a>
          <a href="/products/scan/" class="inline-block border border-gray-700 hover:border-gray-500 text-gray-300 font-semibold px-8 py-3 rounded-lg transition">Try Free Scan First</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">$97</p>
        <p class="text-sm text-gray-500">per month</p>
        <p class="text-xs text-gray-600 mt-2">Cancel anytime</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is Compliance Shield?</h2>
      <p class="text-gray-400 leading-relaxed">
        Compliance Shield is a continuous ADA/WCAG monitoring service for your website. We scan your site daily 
        against WCAG 2.2 AA standards, alert you when new issues are found, and provide clear fix guidance 
        so you can resolve problems before they become lawsuits.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Scan Daily</h3>
          <p class="text-sm text-gray-500">Our automated scanner checks your entire website against WCAG 2.2 AA standards every day.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Alert You</h3>
          <p class="text-sm text-gray-500">When new issues are found, you get instant alerts via email and SMS with details on what needs fixing.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Guide Fixes</h3>
          <p class="text-sm text-gray-500">Each issue comes with clear fix recommendations so you or your developer can resolve it quickly.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Daily WCAG 2.2 AA scans</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Email &amp; SMS alerts on new issues</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Fix recommendations for each issue</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Compliance dashboard</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Historical scan data</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Cancel anytime</span>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Protect Your Business Today</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        ADA lawsuits are on the rise. Get Compliance Shield and stay protected.
      </p>
      <a href="https://checkout.cc3po.com/b/5kQ5kC6fY3EX0v27Kc1B61s" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Buy Now — $97/mo</a>
    </div>
  </section>
</Layout>
