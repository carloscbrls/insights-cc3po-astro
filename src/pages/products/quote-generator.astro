---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Quote Generator — Professional Quotes for Your Business | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Quote Generator</h1>
        <p class="text-xl text-gray-400 mb-6">Generate professional quotes for your business. Free tier for basic quotes, paid tier for branded quotes with compliance check.</p>
        <div class="flex flex-wrap gap-3">
          <a href="https://quote.cc3po.com" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Try It Free</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">Free</p>
        <p class="text-sm text-gray-500">– $49/mo</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is the Quote Generator?</h2>
      <p class="text-gray-400 leading-relaxed">
        The Quote Generator helps trades and service businesses create professional quotes in minutes. 
        Choose from templates, add your services and pricing, and generate a polished quote to send to your customers. 
        The paid tier adds your branding and includes a compliance check.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Choose a Template</h3>
          <p class="text-sm text-gray-500">Select from professional quote templates designed for trades businesses.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Fill in Details</h3>
          <p class="text-sm text-gray-500">Add your services, pricing, and customer information.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Send &amp; Track</h3>
          <p class="text-sm text-gray-500">Generate a PDF quote and send it to your customer. Track when they view it.</p>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Pricing</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Free</h3>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$0</p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Basic quote templates</li>
            <li>✓ PDF generation</li>
            <li>✓ Email delivery</li>
            <li>✓ Up to 10 quotes/month</li>
          </ul>
          <a href="https://quote.cc3po.com" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Try It Free</a>
        </div>
        <div class="bg-[#0f0f1a] border border-emerald-500/30 rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-white">Pro</h3>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">Popular</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$49<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Branded quotes with your logo</li>
            <li>✓ Unlimited quotes</li>
            <li>✓ Compliance check included</li>
            <li>✓ Quote tracking &amp; analytics</li>
            <li>✓ Custom templates</li>
          </ul>
          <a href="https://quote.cc3po.com" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Upgrade to Pro</a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Start Quoting Like a Pro</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Create professional quotes in minutes. Free to start.
      </p>
      <a href="https://quote.cc3po.com" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Try It Free</a>
    </div>
  </section>
</Layout>
