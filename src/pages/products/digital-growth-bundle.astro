---
// src/pages/bundles/digital-growth.astro
// Digital Growth Bundle — $297/mo
import '../../styles/global.css';

const tier = 'digital-growth';
const price = 297;
const priceLabel = '$297/mo';
const title = 'Digital Growth Bundle';
const subtitle = 'Growth-focused compliance for digital-first businesses';
const description = 'SEO compliance, content marketing automation, and digital presence monitoring. Stay compliant while growing your online reach.';

const features = [
  { icon: '⚡', title: 'Daily Telegram Alerts', desc: 'Growth and compliance tips delivered to your phone every morning' },
  { icon: '📋', title: 'Monthly PDF Reports', desc: 'SEO performance scorecards, campaign metrics, and growth opportunities' },
  { icon: '🇪🇸', title: 'Spanish Toggle', desc: 'Full Spanish language support — serve bilingual audiences' },
  { icon: '🆓', title: 'Free Tier Access', desc: '7-day free trial — no credit card required' },
  { icon: '🔒', title: '30-Day Auto-Cancel', desc: 'Not engaged? Auto-cancelled. We earn your subscription.' },
  { icon: '🛡️', title: 'Dedup Protection', desc: 'Never double-billed — duplicate charge prevention' },
  { icon: '📈', title: 'SEO Metrics Dashboard', desc: 'Track rankings, traffic, and conversion rates in real time' },
  { icon: '🎯', title: 'Content Pipeline', desc: 'Automated content calendar with compliance checks built in' },
];

const metrics = [
  { label: 'Organic Traffic', value: '+23%', direction: 'up' },
  { label: 'Conversion Rate', value: '4.2%', direction: 'up' },
  { label: 'Monthly Revenue', value: '$12.4K', direction: 'up' },
  { label: 'Compliance Score', value: '94/100', direction: 'up' },
  { label: 'Content Published', value: '12', direction: 'neutral' },
  { label: 'Alerts Sent', value: '30', direction: 'neutral' },
];

const growthSteps = [
  { step: '1', title: 'Audit', desc: 'We scan your digital presence for compliance gaps and growth opportunities' },
  { step: '2', title: 'Plan', desc: 'Custom content calendar with SEO targets and compliance checkpoints' },
  { step: '3', title: 'Execute', desc: 'Daily alerts keep you on track; monthly reports show your progress' },
  { step: '4', title: 'Grow', desc: 'Watch your rankings, traffic, and revenue climb month over month' },
];

const faqs = [
  { q: 'How is this different from the Local Business Bundle?', a: 'The Digital Growth Bundle focuses on online compliance — SEO, content marketing, advertising disclosures, and digital presence monitoring. It\'s built for businesses that live online.' },
  { q: 'Does this include SEO tools?', a: 'We provide SEO metrics, content pipeline management, and compliance checks. For advanced keyword research, we integrate with your existing tools.' },
  { q: 'What about advertising compliance?', a: 'Yes — CAN-SPAM, FTC disclosure requirements, and platform-specific advertising policies are all covered in your daily alerts and monthly reports.' },
  { q: 'Can I switch from another bundle?', a: 'Absolutely. Upgrade, downgrade, or switch between bundles from your customer portal at any time.' },
];
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{title} — CC3PO</title>
  <meta name="description" content={description} />
  <link rel="canonical" href="https://cc3po.com/bundles/digital-growth" />
  <style>
    :root {
      --color-primary: #0f3460;
      --color-secondary: #16213e;
      --color-accent: #e94560;
      --color-green: #27ae60;
      --color-bg: #f8f9fa;
      --color-surface: #ffffff;
      --color-text: #1a1a2e;
      --color-muted: #555;
      --radius: 12px;
      --shadow: 0 4px 24px rgba(15, 52, 96, 0.1);
    }
    * { margin: 0; padding: 0; box-sizing: border-box; }
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; color: var(--color-text); background: var(--color-bg); line-height: 1.6; }
    .hero { background: linear-gradient(135deg, #0f3460 0%, #e94560 50%, #16213e 100%); color: #fff; padding: 80px 20px; text-align: center; position: relative; }
    .hero::after { content: '📈'; position: absolute; right: 5%; top: 20%; font-size: 4rem; opacity: 0.15; }
    .hero h1 { font-size: 3rem; margin-bottom: 12px; }
    .hero .subtitle { font-size: 1.3rem; opacity: 0.9; margin-bottom: 8px; }
    .hero .badge { display: inline-block; background: rgba(255,255,255,0.2); border: 1px solid rgba(255,255,255,0.4); padding: 4px 16px; border-radius: 20px; font-size: 0.85rem; margin-bottom: 16px; }
    .hero .price { font-size: 2.8rem; font-weight: 800; }
    .hero .price span { font-size: 1rem; font-weight: 400; opacity: 0.7; }
    .container { max-width: 1100px; margin: 0 auto; padding: 0 20px; }
    .features { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 24px; padding: 60px 0; }
    .feature-card { background: var(--color-surface); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); border-left: 4px solid var(--color-accent); transition: transform 0.2s; }
    .feature-card:hover { transform: translateY(-4px); }
    .feature-card .icon { font-size: 2rem; margin-bottom: 12px; }
    .feature-card h3 { font-size: 1.1rem; color: var(--color-primary); margin-bottom: 8px; }
    .feature-card p { color: var(--color-muted); font-size: 0.9rem; }
    .metrics { background: var(--color-surface); border-radius: var(--radius); padding: 40px; margin: 40px 0; box-shadow: var(--shadow); }
    .metrics h2 { font-size: 1.6rem; color: var(--color-primary); margin-bottom: 24px; }
    .metrics-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: 20px; }
    .metric { text-align: center; padding: 20px; background: #f8f9fa; border-radius: 8px; }
    .metric .value { font-size: 2rem; font-weight: 800; color: var(--color-accent); }
    .metric .label { font-size: 0.85rem; color: var(--color-muted); margin-top: 4px; }
    .metric .direction { font-size: 0.8rem; color: var(--color-green); font-weight: 600; }
    .how-it-works { padding: 60px 0; }
    .how-it-works h2 { font-size: 1.6rem; color: var(--color-primary); margin-bottom: 32px; text-align: center; }
    .steps { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 24px; }
    .step { background: var(--color-surface); border-radius: var(--radius); padding: 28px; box-shadow: var(--shadow); text-align: center; position: relative; }
    .step .number { display: inline-flex; align-items: center; justify-content: center; width: 48px; height: 48px; background: var(--color-accent); color: #fff; border-radius: 50%; font-size: 1.3rem; font-weight: 700; margin-bottom: 16px; }
    .step h3 { font-size: 1.1rem; color: var(--color-primary); margin-bottom: 8px; }
    .step p { color: var(--color-muted); font-size: 0.9rem; }
    .cta-section { text-align: center; padding: 60px 20px; }
    .cta-button { display: inline-block; background: var(--color-accent); color: #fff; padding: 16px 48px; border-radius: 8px; font-size: 1.2rem; font-weight: 700; text-decoration: none; transition: transform 0.2s, box-shadow 0.2s; }
    .cta-button:hover { transform: translateY(-2px); box-shadow: 0 8px 32px rgba(233, 69, 96, 0.3); }
    .cta-button.secondary { background: transparent; color: var(--color-primary); border: 2px solid var(--color-primary); margin-left: 16px; }
    .cta-button.secondary:hover { background: var(--color-primary); color: #fff; }
    .faqs { padding: 40px 0; }
    .faq { background: var(--color-surface); border-radius: var(--radius); padding: 24px; margin-bottom: 16px; box-shadow: var(--shadow); }
    .faq h3 { color: var(--color-primary); font-size: 1.1rem; margin-bottom: 8px; }
    .faq p { color: var(--color-muted); }
    .guarantee { text-align: center; padding: 40px; color: var(--color-muted); font-size: 0.95rem; }
    .guarantee strong { color: var(--color-primary); }
    @media (max-width: 768px) {
      .hero h1 { font-size: 2rem; }
      .hero .price { font-size: 2rem; }
      .features { grid-template-columns: 1fr; }
      .steps { grid-template-columns: 1fr; }
    }
  </style>
</head>
<body>
  <section class="hero">
    <div class="container">
      <div class="badge">🚀 Growth-Focused</div>
      <h1>📈 {title}</h1>
      <p class="subtitle">{subtitle}</p>
      <p class="price">{priceLabel} <span>/month</span></p>
    </div>
  </section>

  <section class="container">
    <div class="features">
      {features.map(f => (
        <div class="feature-card">
          <div class="icon">{f.icon}</div>
          <h3>{f.title}</h3>
          <p>{f.desc}</p>
        </div>
      ))}
    </div>

    <div class="metrics">
      <h2>📊 Typical Growth Metrics</h2>
      <div class="metrics-grid">
        {metrics.map(m => (
          <div class="metric">
            <div class="value">{m.value}</div>
            <div class="label">{m.label}</div>
            {m.direction === 'up' && <div class="direction">↑ improving</div>}
          </div>
        ))}
      </div>
    </div>

    <div class="how-it-works">
      <h2>🚀 How It Works</h2>
      <div class="steps">
        {growthSteps.map(s => (
          <div class="step">
            <div class="number">{s.step}</div>
            <h3>{s.title}</h3>
            <p>{s.desc}</p>
          </div>
        ))}
      </div>
    </div>

    <div class="cta-section">
      <a href={`/api/checkout?tier=${tier}`} class="cta-button">Start Growing — {priceLabel}</a>
      <a href={`/api/free-access?tier=${tier}`} class="cta-button secondary">Try Free for 7 Days</a>
    </div>

    <div class="faqs">
      <h2 style="font-size: 1.8rem; color: var(--color-primary); margin-bottom: 24px;">Frequently Asked Questions</h2>
      {faqs.map(faq => (
        <div class="faq">
          <h3>{faq.q}</h3>
          <p>{faq.a}</p>
        </div>
      ))}
    </div>

    <div class="guarantee">
      <strong>30-Day Engagement Guarantee:</strong> If you're not actively using the service, we'll auto-cancel your subscription. No surprise charges. Grow at your own pace.
    </div>
  </section>
</body>
</html>