---
import Layout from '../../layouts/Layout.astro';
---

<Layout title="Reseña — Bilingual Review Autopilot for Trades | CC3PO">
  <section class="max-w-4xl mx-auto px-4 py-16">
    <div class="mb-8">
      <a href="/products/" class="text-sm text-gray-500 hover:text-emerald-400 transition">&larr; Back to all products</a>
    </div>

    <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-8 mb-12">
      <div class="flex-1">
        <h1 class="text-3xl md:text-5xl font-bold text-white mb-4">Reseña</h1>
        <p class="text-xl text-gray-400 mb-6">Bilingual Google Business Profile review autopilot. We monitor, reply, and report — so your reputation stays spotless in English <em>and</em> Spanish.</p>
        <div class="flex flex-wrap gap-3">
          <a href="#pricing" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">See Plans — Starting at $97/mo</a>
        </div>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6 text-center flex-shrink-0 w-full lg:w-64">
        <p class="text-sm text-gray-500 mb-1">Starting at</p>
        <p class="text-4xl font-bold text-emerald-400">$97</p>
        <p class="text-sm text-gray-500">per month</p>
        <p class="text-xs text-gray-600 mt-2">Cancel anytime</p>
      </div>
    </div>

    <!-- What It Is -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-4">What Is Reseña?</h2>
      <p class="text-gray-400 leading-relaxed">
        Reseña is a fully automated review management service for Google Business Profiles. 
        It polls your GBP every 15 minutes, detects new reviews, AI-generates thoughtful replies 
        in the reviewer's language (English or Spanish), posts them automatically, and sends you 
        a weekly digest. Your reputation stays active, responsive, and bilingual — without lifting a finger.
      </p>
    </div>

    <!-- How It Works -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">How It Works</h2>
      <div class="grid grid-cols-1 md:grid-cols-4 gap-4">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">1</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Connect GBP</h3>
          <p class="text-sm text-gray-500">One-click OAuth to connect your Google Business Profile. Secure, read-only review access.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">2</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">We Monitor</h3>
          <p class="text-sm text-gray-500">Every 15 minutes we check for new reviews. Instant detection, zero delay.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">3</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">AI Replies</h3>
          <p class="text-sm text-gray-500">AI generates a thoughtful reply in the same language as the review — English or Spanish. You approve or we auto-post.</p>
        </div>
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <div class="w-10 h-10 bg-emerald-500/10 rounded-lg flex items-center justify-center mb-3">
            <span class="text-emerald-400 font-bold">4</span>
          </div>
          <h3 class="text-lg font-semibold text-white mb-2">Weekly Digest</h3>
          <p class="text-sm text-gray-500">Every Monday, get a PDF digest with sentiment trends, reply stats, and actionable insights.</p>
        </div>
      </div>
    </div>

    <!-- Features -->
    <div class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Features</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">15-minute review polling — never miss a review</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">AI-generated replies in English &amp; Spanish</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Auto-post or manual approval mode</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Sentiment trend tracking over time</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Weekly PDF digest with insights</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Daily Telegram status summary</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">30-day inactivity auto-cancel</span>
        </div>
        <div class="flex items-start gap-3">
          <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span class="text-gray-400">Customer portal for self-service</span>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div id="pricing" class="mb-12">
      <h2 class="text-2xl font-bold text-white mb-6">Pricing</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-6">
          <h3 class="text-lg font-semibold text-white mb-2">Monitor</h3>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$97<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ 15-min review polling</li>
            <li>✓ Real-time alerts (Telegram/SMS)</li>
            <li>✓ Sentiment trend dashboard</li>
            <li>✓ Weekly PDF digest</li>
            <li>✓ Daily Telegram summary</li>
            <li>✗ AI-generated replies</li>
            <li>✗ Auto-posting</li>
            <li>✗ Bilingual support</li>
          </ul>
          <a href="https://buy.stripe.com/00J3cK3qP9vH4Gc5kl" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Subscribe — $97/mo</a>
        </div>
        <div class="bg-[#0f0f1a] border border-emerald-500/30 rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-white">Reply</h3>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">Popular</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$197<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Everything in Monitor</li>
            <li>✓ AI-generated replies</li>
            <li>✓ Manual approval mode</li>
            <li>✓ Reply draft preview</li>
            <li>✓ Sentiment trend dashboard</li>
            <li>✗ Auto-posting</li>
            <li>✗ Bilingual support</li>
          </ul>
          <a href="https://buy.stripe.com/28O7uFb2h4vH4Gc7sB" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Subscribe — $197/mo</a>
        </div>
        <div class="bg-[#0f0f1a] border border-emerald-500/30 rounded-xl p-6">
          <div class="flex items-center justify-between mb-2">
            <h3 class="text-lg font-semibold text-white">Autopilot</h3>
            <span class="text-xs bg-emerald-500/10 text-emerald-400 px-2 py-1 rounded-full">Best Value</span>
          </div>
          <p class="text-3xl font-bold text-emerald-400 mb-4">$397<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <ul class="text-sm text-gray-500 space-y-2 mb-6">
            <li>✓ Everything in Reply</li>
            <li>✓ Auto-posting (no approval needed)</li>
            <li>✓ Bilingual English &amp; Spanish</li>
            <li>✓ Custom reply tone &amp; templates</li>
            <li>✓ Priority support</li>
            <li>✓ Multi-location support (up to 5)</li>
          </ul>
          <a href="https://buy.stripe.com/5kA7uFdVh1vH4Gc7sB" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-2 rounded-lg text-sm transition">Subscribe — $397/mo</a>
        </div>
      </div>
    </div>

    <!-- CTA -->
    <div class="bg-gradient-to-br from-emerald-500/10 to-transparent border border-emerald-500/20 rounded-2xl p-8 text-center">
      <h2 class="text-2xl font-bold text-white mb-4">Your Reputation, Automated</h2>
      <p class="text-gray-400 mb-6 max-w-lg mx-auto">
        Never miss a review again. Reseña monitors, replies, and reports — in English and Spanish.
      </p>
      <a href="#pricing" class="inline-block bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-8 py-3 rounded-lg transition">Get Started — $97/mo</a>
    </div>
  </section>
</Layout>
