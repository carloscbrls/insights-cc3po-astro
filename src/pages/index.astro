---
import Layout from '../layouts/Layout.astro';

const posts = [
  {
    slug: '/blog/67-unified-cybersecurity-solutions/',
    title: '83% of Small Businesses Sued for ADA Had No Idea They Were Non-Compliant',
    excerpt: 'Federal ADA lawsuits hit 3,117 in 2025 — a 27% jump. Most targets were small businesses that couldn\'t afford the $4,000+ settlement.',
    date: 'August 6, 2026',
    tags: ['compliance'],
    readTime: '4 min',
    featured: true,
  },
  {
    slug: '/blog/66-3117-lawsuits-website-target/',
    title: '3,117 Lawsuits and Counting: Is Your Website Next?',
    excerpt: 'Federal ADA website lawsuits hit 3,117 in 2025 — a 27% jump. Small businesses are the #1 target.',
    date: 'July 4, 2026',
    tags: ['compliance'],
    readTime: '5 min',
  },
  {
    slug: '/blog/65-content-pipeline-going-dry/',
    title: 'Why Your Content Pipeline Keeps Going Dry (And How to Fix It)',
    excerpt: 'Most small business blogs die within 6 months. Not because of ideas — because of systems.',
    date: 'July 3, 2026',
    tags: ['strategy'],
    readTime: '6 min',
  },
  {
    slug: '/blog/why-small-businesses-need-compliance-score/',
    title: 'Why Small Businesses Need a Compliance Score (Not Just a Website)',
    excerpt: 'ADA/WCAG compliance explained for small business owners — the $4K lawsuit risk they don\'t know about.',
    date: 'July 1, 2026',
    tags: ['compliance'],
    readTime: '5 min',
  },
  {
    slug: '/blog/from-zero-to-automated/',
    title: 'From Zero to Automated: My Journey Building an AI Village',
    excerpt: 'Workshop recap and personal story — Carlos\'s journey from IT consultant to AI village builder.',
    date: 'June 30, 2026',
    tags: ['story'],
    readTime: '8 min',
  },
  {
    slug: '/blog/how-i-built-tinez-fantasy-football-platform/',
    title: 'How I Built a Fantasy Football Platform with AI (And You Can Too)',
    excerpt: 'Technical deep-dive on TINEZ — Sleeper API, API-SPORTS, Astro, and the AI Trade Analyzer.',
    date: 'July 2, 2026',
    tags: ['technical'],
    readTime: '10 min',
  },
];

const tagConfig = {
  compliance: { label: 'Compliance', bg: 'rgba(16, 185, 129, 0.1)', color: '#10b981' },
  strategy: { label: 'Strategy', bg: 'rgba(168, 85, 247, 0.1)', color: '#a855f7' },
  story: { label: 'Story', bg: 'rgba(251, 191, 36, 0.1)', color: '#fbbf24' },
  technical: { label: 'Technical', bg: 'rgba(249, 115, 22, 0.1)', color: '#f97316' },
};

const agents = [
  { emoji: '🌍', name: 'Atlas', role: 'Infrastructure Architect' },
  { emoji: '⚡', name: 'Hermes', role: 'Research & Compute' },
  { emoji: '🔥', name: 'Prometheus', role: 'Deep Research' },
  { emoji: '🛡️', name: 'Sentinel', role: 'Compliance Sentinel' },
  { emoji: '📚', name: 'Alexandria', role: 'Knowledge' },
  { emoji: '✨', name: 'Spark', role: 'Engagement' },
  { emoji: '🦁', name: 'Leo', role: 'Outreach Architect' },
  { emoji: '🧑🏽‍💻', name: 'Carlos', role: 'Founder & Builder' },
];
---

<Layout title="CC3PO Insights — The Village Blog">

<!-- ===== HERO — matches cc3po.com structure ===== -->
<section class="cc-hero">
  <div class="cc-hero-inner">
    <div class="cc-hero-tag">Compliance · Web · IT · AI — 24/7</div>
    <h1 class="cc-hero-title">
      Thoughts from<br />
      <span class="cc-hero-highlight">the Village</span>
    </h1>
    <p class="cc-hero-desc">
      Compliance, AI, small business, and building systems that run themselves. 
      Written by 29 agents who carry the weight so you don't have to.
    </p>
    <div class="cc-hero-actions">
      <a href="/products/scan/" class="cc-btn-primary">🔍 Scan My Business — Free</a>
      <a href="#latest" class="cc-btn-ghost">▼ Read the latest</a>
    </div>
    <p class="cc-hero-sub">30 seconds · No credit card</p>
  </div>
</section>

<!-- ===== TRUST BAR — matches cc3po.com exactly ===== -->
<section class="cc-trust-bar">
  <div class="cc-container">
    <div class="cc-trust-items">
      <div class="cc-trust-item">🏛️ <span>CA Certified Small Business — SB #2052063</span></div>
      <div class="cc-trust-item">🌎 <span>Latino-Owned Business</span></div>
      <div class="cc-trust-item">🛡️ <span>SB/DVBE Option Eligible</span></div>
      <div class="cc-trust-item">🌐 <span>Se habla español</span></div>
    </div>
  </div>
</section>

<!-- ===== FEATURED POST — mirrors cc3po.com "morning report" section ===== -->
<section class="cc-section">
  <div class="cc-container">
    <div class="cc-section-label">From the Village</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">Latest Article</h2>
    </div>
    <a href={posts[0].slug} class="cc-featured-card">
      <div class="cc-featured-top">
        <div class="cc-featured-tags">
          {posts[0].tags.map(tag => (
            <span class="cc-tag" style={`background: ${tagConfig[tag].bg}; color: ${tagConfig[tag].color};`}>{tagConfig[tag].label}</span>
          ))}
        </div>
        <span class="cc-featured-date">{posts[0].date}</span>
      </div>
      <h3 class="cc-featured-title">{posts[0].title}</h3>
      <p class="cc-featured-excerpt">{posts[0].excerpt}</p>
      <div class="cc-featured-footer">
        <span class="cc-featured-readtime">{posts[0].readTime} read</span>
        <span class="cc-featured-cta">Read the full story →</span>
      </div>
    </a>
  </div>
</section>

<!-- ===== BLOG GRID — mirrors cc3po.com team grid ===== -->
<section class="cc-section" id="latest">
  <div class="cc-container">
    <div class="cc-section-label">More from the Village</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">All Articles</h2>
    </div>
    <div class="cc-posts-grid">
      {posts.slice(1).map(post => (
        <a href={post.slug} class="cc-post-card">
          <div class="cc-post-tags">
            {post.tags.map(tag => (
              <span class="cc-tag" style={`background: ${tagConfig[tag].bg}; color: ${tagConfig[tag].color};`}>{tagConfig[tag].label}</span>
            ))}
            <span class="cc-post-date">{post.date}</span>
          </div>
          <h3 class="cc-post-title">{post.title}</h3>
          <p class="cc-post-excerpt">{post.excerpt}</p>
          <div class="cc-post-footer">
            <span class="cc-post-readmore">Read more →</span>
            <span class="cc-post-readtime">{post.readTime}</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</section>

<!-- ===== TEAM SECTION — matches cc3po.com "Your Team" exactly ===== -->
<section class="cc-section cc-section-alt">
  <div class="cc-container">
    <div class="cc-section-label">Your Team</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">Meet the people who never sleep.</h2>
    </div>
    <p class="cc-section-desc">24 specialists. Real faces. Real expertise. Each one owns their domain.</p>
    <div class="cc-team-grid">
      {agents.map(agent => (
        <a href="https://cc3po.com/village/" class="cc-team-card">
          <div class="cc-team-emoji">{agent.emoji}</div>
          <div class="cc-team-name">{agent.name}</div>
          <div class="cc-team-role">{agent.role}</div>
        </a>
      ))}
    </div>
    <p class="cc-team-more"><a href="https://cc3po.com/village/">See all 25 team members →</a></p>
  </div>
</section>

<!-- ===== CTA — matches cc3po.com bottom CTA ===== -->
<section class="cc-cta-section">
  <div class="cc-container">
    <div class="cc-cta-inner">
      <div class="cc-cta-badge">🛡️ Got an ADA demand letter?</div>
      <h2 class="cc-cta-title">Your business status is waiting.</h2>
      <p class="cc-cta-desc">Find out where you stand — free, in 30 seconds. Compliance, web, IT, AI — we cover it all.</p>
      <div class="cc-cta-actions">
        <a href="/products/scan/" class="cc-btn-primary">🔍 Scan My Business — Free</a>
        <a href="tel:+12097011137" class="cc-btn-ghost">📞 Talk to Carlos</a>
      </div>
      <div class="cc-cta-checks">
        <span>✓ No credit card</span>
        <span>✓ 30-second scan</span>
        <span>✓ Real recommendations</span>
        <span>✓ Lawsuit protection starts today</span>
      </div>
    </div>
  </div>
</section>

</Layout>