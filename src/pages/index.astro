---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import EngagementPoll from '../components/EngagementPoll.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AIReadinessScore from '../components/AIReadinessScore.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Map existing categories to audience segments
const audienceMap = {
  'Business': 'local-business', 'Compliance': 'local-business',
  'ADA Compliance': 'local-business', 'WordPress': 'local-business',
  'Performance': 'local-business', 'Security': 'local-business',
  'Tools': 'local-business', 'IT Automation': 'local-business',
  'Automation': 'local-business', 'Hosting': 'local-business',
  'Maintenance': 'local-business', 'Consulting': 'local-business',
  'Technology': 'creator', 'AI & Automation': 'creator',
  'AI &amp; Automation': 'creator', 'Growth': 'creator',
  'Music': 'creator', 'Nonprofit': 'nonprofit',
  'Real Stories': 'all', 'Behind the Build': 'all',
};

// Tag each post with audience
const taggedPosts = posts.map(p => ({
  ...p,
  audience: audienceMap[p.data.category] || 'local-business',
  tags: p.data.tags || [],
}));

const mostRecent = posts[0];
const latestCount = Math.min(30, posts.length);
const featuredPost = posts[0];
const SITE_TITLE = 'CC3PO Insights — Compliance & WordPress for Small Business Owners';
const SITE_DESCRIPTION = 'Real talk about ADA compliance, WordPress security, and the tech that actually helps your business — from people who build websites, not people who sell consulting.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://insights.cc3po.com/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
      :root { --bg: #0a0a0b; --card: #141418; --text: #fff; --muted: #d4d4d8; --primary: #e94560; --accent: #4fc3f7; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: Inter, system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; min-height: 100vh; }

      /* === HERO === */
      .village-hero {
        text-align: center;
        padding: 100px 24px 60px;
        position: relative;
        overflow: hidden;
      }
      .village-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(ellipse at 50% 50%, rgba(107,53,255,0.08), transparent 60%);
        pointer-events: none;
      }
      .village-hero h1 {
        font-size: 36px;
        font-weight: 800;
        color: #fff;
        max-width: 680px;
        margin: 0 auto 12px;
        line-height: 1.3;
        position: relative;
      }
      .village-hero h1 em {
        color: #e94560;
        font-style: normal;
      }
      .village-hero p {
        font-size: 17px;
        color: #a1a1aa;
        max-width: 520px;
        margin: 0 auto 8px;
        position: relative;
        line-height: 1.6;
      }
      .village-hero .hero-cta {
        margin-top: 28px;
        position: relative;
      }
      .village-hero .hero-cta a {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 14px 28px;
        background: linear-gradient(135deg, #6b35ff, #00d2ff);
        border-radius: 10px;
        color: #fff;
        font-size: 15px;
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s;
      }
      .village-hero .hero-cta a:hover {
        transform: translateY(-2px);
        box-shadow: 0 8px 30px rgba(107,53,255,0.3);
      }
      .village-hero .hero-note {
        font-size: 13px;
        color: #52525b;
        margin-top: 8px;
        position: relative;
      }

      /* === INLINE FILTER TOGGLE (subtle) === */
      .filter-toggle {
        max-width: 1200px;
        margin: 0 auto 32px;
        padding: 0 24px;
        text-align: center;
      }
      .filter-toggle p {
        font-size: 14px;
        color: #71717a;
        margin-bottom: 8px;
      }
      .filter-links {
        display: flex;
        justify-content: center;
        gap: 4px;
        flex-wrap: wrap;
      }
      .filter-links a {
        font-size: 13px;
        color: #52525b;
        text-decoration: none;
        padding: 4px 12px;
        border-radius: 12px;
        cursor: pointer;
        transition: all 0.2s;
        border: 1px solid transparent;
      }
      .filter-links a:hover {
        color: #d4d4d8;
        border-color: rgba(255,255,255,0.08);
      }
      .filter-links a.active {
        color: #fff;
        border-color: rgba(107,53,255,0.4);
        background: rgba(107,53,255,0.1);
      }

      /* === POSTS GRID === */
      .posts-section {
        max-width: 1200px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
      }
      .post-card-wrapper { transition: all 0.3s ease; }
      .post-card-wrapper.hidden { display: none; }

      /* === SOCIAL PROOF === */
      .social-proof {
        max-width: 1200px;
        margin: 0 auto 32px;
        padding: 0 24px;
      }
      .social-proof .most-read {
        font-size: 13px;
        color: #52525b;
      }
      .social-proof .most-read a {
        color: #4fc3f7;
        text-decoration: none;
      }

      /* === AI READINESS SCORE === */
      .readiness-wrapper {
        max-width: 680px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }

      /* === NEWSLETTER CTA === */
      .cta-section {
        max-width: 640px;
        margin: 0 auto 60px;
        padding: 0 24px;
      }

      /* === RESPONSIVE === */
      @media (max-width: 768px) {
        .village-hero { padding: 100px 16px 60px; }
        .village-hero h1 { font-size: 32px; }
        .village-hero p { font-size: 16px; }
        .audience-buttons { flex-wrap: wrap; }
        .audience-btn { flex: 1; min-width: 140px; justify-content: center; }
        .posts-grid { grid-template-columns: 1fr; }
        .tools-grid { grid-template-columns: 1fr; }
        .poll-card { padding: 24px 20px; }
        .village-stats { flex-wrap: wrap; gap: 24px; padding: 24px 16px; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link" style="position:absolute;top:-100px;left:0;background:#e94560;color:#fff;padding:12px 24px;z-index:10000;font-size:16px;font-weight:600;text-decoration:none;border-radius:0 0 8px 0;transition:top.2s">Skip to main content</a>
    <Header />

    <!-- 🏠 HERO -->
    <section class="village-hero">
      <h1>Your website could cost you <em>$4,000 per violation</em>. And you probably have more than one.</h1>
      <p>Real talk about ADA compliance, WordPress security, and the tech that actually helps your business — from people who build websites, not people who sell consulting.</p>
      <div class="hero-cta">
        <a href="/signal/">See what's new →</a>
      </div>
      <div class="hero-note">Built by the same team behind the free compliance scanner used by 900+ California businesses.</div>
    </section>

    <!-- 🔖 INLINE FILTER (subtle: above posts only) -->
    <div class="filter-toggle">
      <p>For <strong>business owners</strong> &middot;
        <a id="filter-creator">tech teams</a> &middot;
        <a id="filter-nonprofit">nonprofits</a> &middot;
        <a id="filter-all" class="active">everyone</a>
      </p>
    </div>

    <!-- 📰 POSTS -->
    <section class="posts-section" id="main-content">
      <div class="posts-grid">
        {taggedPosts.map((post) => (
          <div class="post-card-wrapper" data-audience={post.audience}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>

    <!-- 📈 SOCIAL PROOF (replaces stats bar) -->
    <div class="social-proof">
      <p class="most-read">Most read this week: <a href="{featuredPost.data.permalink || ('/blog/' + featuredPost.slug)}">{featuredPost.data.title}</a></p>
    </div>

    <!-- 🧠 AI READINESS SCORE -->
    <div class="readiness-wrapper">
      <AIReadinessScore />
    </div>

    <!-- 📬 NEWSLETTER -->
    <section class="cta-section">
      <NewsletterSignup variant="inline" />
    </section>

    <Footer />
    <CookieBanner />

    <script>
      // Audience filter
      const buttons = document.querySelectorAll('.audience-btn');
      const cards = document.querySelectorAll('.post-card-wrapper');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Update active button
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const audience = btn.dataset.audience;
          cards.forEach(card => {
            if (audience === 'all' || card.dataset.audience === audience) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });
    </script>
  </body>
</html>