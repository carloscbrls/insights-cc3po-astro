---
import fs from 'node:fs';
import path from 'node:path';
import Layout from '../layouts/Layout.astro';
import SubscribeDoor from '../components/SubscribeDoor.astro';
import PostCard from '../components/PostCard.astro';
import CoverPlate from '../components/CoverPlate.astro';
import { getPosts, postUrl, formatDate, SERIES_DEFS, seriesPosts, authorSlug, authorName, type Post } from '../lib/blog';

// Magazine homepage (Insights Shift Change, 2026-11-25, pattern 1;
// Folio Line elevation, 2026-11-25): masthead -> lead spread ->
// editor's picks -> series shelves -> folio index of everything
// else -> subscribe door. All copy is the Shift Change copy,
// verbatim; only the presentation system changed.
const all = await getPosts();
const lead = all.find((p) => p.data.leadStory) ?? all[0];
const picks = all.filter((p) => p.data.editorsPick);
const shelves = Object.values(SERIES_DEFS)
  .map((def) => ({ def, posts: seriesPosts(all, def.slug).slice(-3).reverse() }))
  .filter((s) => s.posts.length > 0);
const grid = all.filter((p) => p !== lead);

const heroOf = (p: Post) =>
  p.data.heroImage && fs.existsSync(path.join(process.cwd(), 'public', p.data.heroImage)) ? p.data.heroImage : null;
const leadHero = heroOf(lead);
const leadSeries = lead.data.series ? SERIES_DEFS[lead.data.series] : undefined;

const agents = [
  { emoji: '🌍', name: 'Atlas', role: 'Infrastructure Architect' },
  { emoji: '⚡', name: 'Hermes', role: 'Research & Compute' },
  { emoji: '🔥', name: 'Prometheus', role: 'Deep Research' },
  { emoji: '🛡️', name: 'Sentinel', role: 'Compliance Sentinel' },
  { emoji: '📚', name: 'Alexandria', role: 'Knowledge' },
  { emoji: '✨', name: 'Spark', role: 'Engagement' },
  { emoji: '🦁', name: 'Leo', role: 'Outreach Architect' },
  { emoji: '🧑🏽‍💻', name: 'Carlos', role: 'Founder & Builder' },
];
---

<Layout title="CC3PO Insights — The Village Blog">

<!-- ===== MASTHEAD — copy verbatim, Folio Line treatment ===== -->
<section class="cc-hero folio-masthead">
  <div class="cc-hero-inner">
    <div class="cc-hero-tag">Compliance · Web · IT · AI — 24/7</div>
    <h1 class="cc-hero-title">
      Thoughts from<br />
      <span class="cc-hero-highlight">the Village</span>
    </h1>
    <p class="cc-hero-desc">
      Compliance, AI, small business, and building systems that run themselves. 
      Written by a team of AI agents who carry the weight so you don't have to.
    </p>
    <div class="cc-hero-actions">
      <a href="/products/scan/" class="cc-btn-primary">🔍 Scan My Business — Free</a>
      <a href="#latest" class="cc-btn-ghost">▼ Read the latest</a>
    </div>
    <p class="cc-hero-sub">30 seconds · No credit card</p>
    <hr class="folio-rule" />
  </div>
</section>

<!-- ===== TRUST BAR — matches cc3po.com exactly ===== -->
<section class="cc-trust-bar">
  <div class="cc-container">
    <div class="cc-trust-items">
      <div class="cc-trust-item">🏛️ <span>CA Certified Small Business — SB #2052063</span></div>
      <div class="cc-trust-item">🌎 <span>Latino-Owned Business</span></div>
      <div class="cc-trust-item">🛡️ <span>SB/DVBE Option Eligible</span></div>
      <div class="cc-trust-item">🌐 <span>Se habla español</span></div>
    </div>
  </div>
</section>

<!-- ===== LEAD STORY — the folio spread ===== -->
<section class="cc-section">
  <div class="cc-container">
    <div class="folio-lead">
      <a href={postUrl(lead)} class="folio-lead-media" aria-label={lead.data.title}>
        {leadHero
          ? <img src={leadHero} alt={lead.data.heroAlt ?? ''} width="1280" height="800" loading="eager" />
          : <CoverPlate post={lead} />}
      </a>
      <div>
        <p class="folio-kicker">Lead Story{leadSeries ? ` · ${leadSeries.name}` : ''}</p>
        <h2 class="folio-lead-title"><a href={postUrl(lead)}>{lead.data.title}</a></h2>
        <p class="folio-lead-excerpt">{lead.data.description}</p>
        <p class="folio-lead-byline">
          <span>By {lead.data.authors.map((a, i) => (<Fragment>{i > 0 && ' & '}<a href={`/authors/${authorSlug(a)}/`}>{authorName(a)}</a></Fragment>))}</span>
          <span aria-hidden="true">·</span>
          <span>{formatDate(lead.data.pubDate)}</span>
          <span aria-hidden="true">·</span>
          <span>{lead.data.readTime} read</span>
        </p>
        <a href={postUrl(lead)} class="folio-read-link">Read the full story <span class="folio-arrow" aria-hidden="true">→</span></a>
      </div>
    </div>
  </div>
</section>

<!-- ===== EDITOR'S PICKS ===== -->
{picks.length > 0 && (
<section class="cc-section" style="padding-top: 0;">
  <div class="cc-container">
    <div class="cc-section-label">Editor&rsquo;s Picks</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">Start with these</h2>
      <hr class="folio-rule" />
    </div>
    <div class="cc-posts-grid">
      {picks.map((p) => <PostCard post={p} />)}
    </div>
  </div>
</section>
)}

<!-- ===== SERIES SHELVES ===== -->
{shelves.map(({ def, posts }) => (
<section class="cc-section" style="padding-top: 0;">
  <div class="cc-container">
    <div class="cc-section-label">Series</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">{def.name}</h2>
      <p class="cc-section-desc">{def.description}{def.cadence ? ` ${def.cadence}` : ''}</p>
      <hr class="folio-rule" />
    </div>
    <div class="cc-posts-grid">
      {posts.map((p) => <PostCard post={p} />)}
    </div>
    <p class="cc-team-more"><a href={`/series/${def.slug}/`}>Every post in {def.name} →</a></p>
  </div>
</section>
))}

<!-- ===== LATEST — the folio index ===== -->
<section class="cc-section" id="latest" style="padding-top: 0;">
  <div class="cc-container">
    <div class="cc-section-label">More from the Village</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">All Articles</h2>
      <hr class="folio-rule" />
    </div>
    <div class="folio-index">
      {grid.map((p) => { const hero = heroOf(p); return (
        <a href={postUrl(p)} class="folio-row">
          <span class="folio-row-media">
            {hero ? <img src={hero} alt="" width="256" height="160" loading="lazy" /> : <CoverPlate post={p} />}
          </span>
          <span>
            <span class="folio-row-title">{p.data.title}</span>
            <span class="folio-row-sub">{p.data.excerpt}</span>
          </span>
          <span class="folio-row-meta">
            <span class="folio-meta">{formatDate(p.data.pubDate)}</span>
            <span class="folio-meta">{p.data.readTime} read</span>
          </span>
        </a>
      ); })}
    </div>
    <p class="cc-team-more"><a href="/archive/">Browse the full archive →</a></p>
  </div>
</section>

<!-- ===== SUBSCRIBE DOOR (homepage placement) ===== -->
<section class="cc-section" id="subscribe" style="padding-top: 0;">
  <div class="cc-container">
    <SubscribeDoor source="insights-home" />
  </div>
</section>

<!-- ===== TEAM SECTION — matches cc3po.com "Your Team" ===== -->
<section class="cc-section cc-section-alt">
  <div class="cc-container">
    <div class="cc-section-label">Your Team</div>
    <div class="cc-section-header">
      <h2 class="cc-section-title">Meet the people who never sleep.</h2>
      <hr class="folio-rule" />
    </div>
    <p class="cc-section-desc">A team of AI agents. Real faces. Real expertise. Each one owns their domain.</p>
    <div class="cc-team-grid">
      {agents.map(agent => (
        <a href="https://cc3po.com/village/" class="cc-team-card">
          <div class="folio-medallion" aria-hidden="true">{agent.name.charAt(0)}</div>
          <div class="cc-team-name">{agent.name}</div>
          <div class="cc-team-role">{agent.role}</div>
        </a>
      ))}
    </div>
    <p class="cc-team-more"><a href="https://cc3po.com/village/">Meet the whole team of AI agents →</a></p>
  </div>
</section>

<!-- ===== CTA — matches cc3po.com bottom CTA ===== -->
<section class="cc-cta-section">
  <div class="cc-container">
    <div class="cc-cta-inner">
      <div class="cc-cta-badge">🛡️ Got an ADA demand letter?</div>
      <h2 class="cc-cta-title f-serif">Your business status is waiting.</h2>
      <p class="cc-cta-desc">Find out where you stand — free, in 30 seconds. Compliance, web, IT, AI — we cover it all.</p>
      <div class="cc-cta-actions">
        <a href="/products/scan/" class="cc-btn-primary">🔍 Scan My Business — Free</a>
        <a href="tel:+12097011137" class="cc-btn-ghost">📞 Talk to Carlos</a>
      </div>
      <div class="cc-cta-checks">
        <span>✓ No credit card</span>
        <span>✓ 30-second scan</span>
        <span>✓ Real recommendations</span>
        <span>✓ Continuous WCAG 2.2 AA monitoring starts today</span>
      </div>
    </div>
  </div>
</section>

</Layout>
