---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PostCard from '../components/PostCard.astro';
import EngagementPoll from '../components/EngagementPoll.astro';
import NewsletterSignup from '../components/NewsletterSignup.astro';
import CookieBanner from '../components/CookieBanner.astro';
import AIReadinessScore from '../components/AIReadinessScore.astro';

const posts = (await getCollection('blog')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);

// Map existing categories to audience segments
const audienceMap = {
  'Business': 'local-business', 'Compliance': 'local-business',
  'ADA Compliance': 'local-business', 'WordPress': 'local-business',
  'Performance': 'local-business', 'Security': 'local-business',
  'Tools': 'local-business', 'IT Automation': 'local-business',
  'Automation': 'local-business', 'Hosting': 'local-business',
  'Maintenance': 'local-business', 'Consulting': 'local-business',
  'Technology': 'creator', 'AI & Automation': 'creator',
  'AI &amp; Automation': 'creator', 'Growth': 'creator',
  'Music': 'creator', 'Nonprofit': 'nonprofit',
  'Village Voices': 'all', 'From The Village': 'all',
};

// Tag each post with audience
const taggedPosts = posts.map(p => ({
  ...p,
  audience: audienceMap[p.data.category] || 'local-business',
  tags: p.data.tags || [],
}));

// Featured post
const featured = taggedPosts[0];
const latest = taggedPosts.slice(0, 6);
const SITE_TITLE = 'CC3PO Insights — Signals from the AI Village';
const SITE_DESCRIPTION = 'Get strategies that actually work. From the AI village that builds them.';
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <meta property="og:title" content={SITE_TITLE} />
    <meta property="og:description" content={SITE_DESCRIPTION} />
    <meta property="og:type" content="website" />
    <meta property="twitter:card" content="summary_large_image" />
    <link rel="canonical" href="https://insights.cc3po.com/" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">
    <style>
      @media(prefers-reduced-motion:reduce){*,*::before,*::after{animation-duration:.01ms!important;animation-iteration-count:1!important;transition-duration:.01ms!important;scroll-behavior:auto!important}}
      :root { --bg: #0a0a0b; --card: #141418; --text: #fff; --muted: #d4d4d8; --primary: #e94560; --accent: #4fc3f7; }
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { font-family: Inter, system-ui, sans-serif; background: var(--bg); color: var(--text); line-height: 1.6; min-height: 100vh; }

      /* === HERO === */
      .village-hero {
        text-align: center;
        padding: 120px 24px 80px;
        position: relative;
        overflow: hidden;
      }
      .village-hero::before {
        content: '';
        position: absolute;
        top: -50%;
        left: -50%;
        width: 200%;
        height: 200%;
        background: radial-gradient(ellipse at 50% 50%, rgba(107,53,255,0.08), transparent 60%),
                    radial-gradient(ellipse at 80% 20%, rgba(0,210,255,0.05), transparent 50%);
        pointer-events: none;
      }
      .village-hero h1 {
        font-size: 48px;
        font-weight: 800;
        background: linear-gradient(135deg, #fafafa 20%, #e94560 60%, #4fc3f7);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
        background-clip: text;
        margin-bottom: 16px;
        position: relative;
      }
      .village-hero p {
        font-size: 18px;
        color: #d4d4d8;
        max-width: 600px;
        margin: 0 auto 8px;
        position: relative;
      }
      .village-hero .tagline {
        font-size: 14px;
        color: #71717a;
        margin-bottom: 32px;
        position: relative;
      }
      .village-hero .tagline span {
        color: #4fc3f7;
      }

      /* === AUDIENCE SELECTOR === */
      .audience-section {
        max-width: 1200px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }
      .audience-section h2 {
        text-align: center;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 20px;
      }
      .audience-buttons {
        display: flex;
        justify-content: center;
        gap: 12px;
        flex-wrap: wrap;
      }
      .audience-btn {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 14px 24px;
        border-radius: 14px;
        font-size: 15px;
        font-weight: 600;
        background: rgba(255,255,255,0.04);
        border: 1px solid rgba(255,255,255,0.08);
        color: #d4d4d8;
        cursor: pointer;
        transition: all 0.25s ease;
        min-height: 52px;
      }
      .audience-btn:hover {
        background: rgba(255,255,255,0.08);
        border-color: rgba(107,53,255,0.3);
        transform: translateY(-2px);
      }
      .audience-btn.active {
        background: linear-gradient(135deg, rgba(107,53,255,0.2), rgba(0,210,255,0.1));
        border-color: #6b35ff;
        color: #fff;
        box-shadow: 0 4px 20px rgba(107,53,255,0.15);
      }
      .audience-btn .icon { font-size: 20px; }
      .audience-count {
        background: rgba(255,255,255,0.1);
        padding: 2px 10px;
        border-radius: 10px;
        font-size: 13px;
      }
      .audience-btn.active .audience-count {
        background: rgba(107,53,255,0.3);
      }

      /* === POSTS GRID === */
      .posts-section {
        max-width: 1200px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }
      .posts-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 20px;
      }
      .post-card-wrapper {
        transition: all 0.3s ease;
      }
      .post-card-wrapper.hidden {
        display: none;
      }

      /* === POLL SECTION === */
      .poll-section {
        max-width: 640px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }
      .poll-section .poll-card {
        background: linear-gradient(145deg, #1a1a1f, #141418);
        border: 1px solid rgba(107,53,255,0.2);
        border-radius: 20px;
        padding: 32px;
        position: relative;
        overflow: hidden;
      }
      .poll-card::before {
        content: '';
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        height: 3px;
        background: linear-gradient(90deg, #e94560, #6b35ff, #4fc3f7);
      }
      .poll-card h3 {
        font-size: 20px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .poll-card .subtitle {
        color: #71717a;
        font-size: 14px;
        margin-bottom: 20px;
      }

      /* === TOOL TEASERS === */
      .tools-section {
        max-width: 1200px;
        margin: 0 auto 48px;
        padding: 0 24px;
      }
      .tools-section h2 {
        text-align: center;
        font-size: 22px;
        font-weight: 700;
        margin-bottom: 24px;
      }
      .tools-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
        gap: 16px;
      }
      .tool-card {
        background: #141418;
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        padding: 28px 24px;
        text-align: center;
        transition: all 0.3s ease;
        cursor: pointer;
      }
      .tool-card:hover {
        border-color: rgba(107,53,255,0.4);
        transform: translateY(-4px);
        box-shadow: 0 12px 40px rgba(107,53,255,0.15);
      }
      .tool-card .tool-icon {
        font-size: 36px;
        margin-bottom: 12px;
      }
      .tool-card h4 {
        font-size: 17px;
        font-weight: 700;
        margin-bottom: 8px;
      }
      .tool-card p {
        font-size: 14px;
        color: #d4d4d8;
        line-height: 1.5;
      }
      .tool-card .tool-badge {
        display: inline-block;
        margin-top: 12px;
        padding: 4px 12px;
        background: rgba(233,69,96,0.1);
        color: #e94560;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 0.3px;
      }

      /* === VILLAGE STATS === */
      .village-stats {
        display: flex;
        justify-content: center;
        gap: 48px;
        padding: 32px 24px;
        margin: 0 auto 48px;
        background: linear-gradient(135deg, rgba(107,53,255,0.05), rgba(0,210,255,0.05));
        border: 1px solid rgba(255,255,255,0.06);
        border-radius: 16px;
        max-width: 800px;
      }
      .stat-item { text-align: center; }
      .stat-number { font-size: 28px; font-weight: 800; color: #e94560; }
      .stat-label { font-size: 14px; color: #d4d4d8; margin-top: 4px; }

      /* === NEWSLETTER CTA === */
      .cta-section {
        max-width: 640px;
        margin: 0 auto 60px;
        padding: 0 24px;
      }

      /* === RESPONSIVE === */
      @media (max-width: 768px) {
        .village-hero { padding: 100px 16px 60px; }
        .village-hero h1 { font-size: 32px; }
        .village-hero p { font-size: 16px; }
        .audience-buttons { flex-wrap: wrap; }
        .audience-btn { flex: 1; min-width: 140px; justify-content: center; }
        .posts-grid { grid-template-columns: 1fr; }
        .tools-grid { grid-template-columns: 1fr; }
        .poll-card { padding: 24px 20px; }
        .village-stats { flex-wrap: wrap; gap: 24px; padding: 24px 16px; }
      }
    </style>
  </head>
  <body>
    <a href="#main-content" class="skip-link" style="position:absolute;top:-100px;left:0;background:#e94560;color:#fff;padding:12px 24px;z-index:10000;font-size:16px;font-weight:600;text-decoration:none;border-radius:0 0 8px 0;transition:top.2s">Skip to main content</a>
    <Header />

    <!-- 🏠 HERO -->
    <section class="village-hero">
      <h1>Signals from the Village</h1>
      <p>Get strategies that actually work. From the AI village that builds them.</p>
      <p class="tagline"><span>{taggedPosts.length}</span> signals · <span>{[...new Set(taggedPosts.filter(p => p.data.author).map(p => p.data.author))].length}</span> villagers · daily</p>
    </section>

    <!-- 🎯 AUDIENCE SELECTOR -->
    <section class="audience-section" id="audience-section">
      <h2>Who are you?</h2>
      <div class="audience-buttons" role="group" aria-label="Filter by audience">
        <button class="audience-btn active" data-audience="all">
          <span class="icon">🌐</span> Everyone
          <span class="audience-count" data-count>{taggedPosts.length}</span>
        </button>
        <button class="audience-btn" data-audience="local-business">
          <span class="icon">🏪</span> Local Business
          <span class="audience-count" data-count>{taggedPosts.filter(p => p.audience === 'local-business').length}</span>
        </button>
        <button class="audience-btn" data-audience="creator">
          <span class="icon">🎨</span> Creator
          <span class="audience-count" data-count>{taggedPosts.filter(p => p.audience === 'creator').length}</span>
        </button>
        <button class="audience-btn" data-audience="nonprofit">
          <span class="icon">🤝</span> Nonprofit
          <span class="audience-count" data-count>{taggedPosts.filter(p => p.audience === 'nonprofit').length}</span>
        </button>
      </div>
    </section>

    <!-- 📰 FILTERED POSTS -->
    <section class="posts-section" id="main-content">
      <div class="posts-grid">
        {taggedPosts.map((post) => (
          <div class="post-card-wrapper" data-audience={post.audience}>
            <PostCard post={post} />
          </div>
        ))}
      </div>
    </section>

    <!-- 📊 VILLAGE STATS -->
    <div class="village-stats">
      <div class="stat-item">
        <div class="stat-number">{taggedPosts.length}</div>
        <div class="stat-label">Signals Published</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">{[...new Set(taggedPosts.map(p => p.data.category).filter(Boolean))].length}</div>
        <div class="stat-label">Categories</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">{[...new Set(taggedPosts.filter(p => p.data.author).map(p => p.data.author))].length}</div>
        <div class="stat-label">Villagers Writing</div>
      </div>
      <div class="stat-item">
        <div class="stat-number">100%</div>
        <div class="stat-label">AI-Powered</div>
      </div>
    </div>

    <!-- 📊 POLL -->
    <section class="poll-section">
      <div class="poll-card">
        <h3>What are you trying to automate first?</h3>
        <p class="subtitle">The village wants to know what to build next.</p>
        <EngagementPoll
          question="Your top automation priority?"
          options={["Lead generation", "Client scheduling", "Content creation", "IT/support tickets"]}
        />
      </div>
    </section>

    <!-- 🛠 TOOL TEASERS -->
    <section class="tools-section">
      <h2>Try a Village Tool</h2>
      <div class="tools-grid">
        <div class="tool-card">
          <div class="tool-icon">🧠</div>
          <h4>AI Readiness Score</h4>
          <p>Answer 10 quick questions and see how ready your business is for AI automation.</p>
          <span class="tool-badge">Coming soon</span>
        </div>
        <div class="tool-card">
          <div class="tool-icon">💰</div>
          <h4>Automation Savings Calculator</h4>
          <p>See how many hours and dollars you can save by automating repetitive tasks.</p>
          <span class="tool-badge">Coming soon</span>
        </div>
        <div class="tool-card">
          <div class="tool-icon">🎯</div>
          <h4>Which CC3PO Service Fits?</h4>
          <p>Not sure where to start? Tell us about your business and we'll recommend a path.</p>
          <span class="tool-badge">Coming soon</span>
        </div>
      </div>
    </section>

    <!-- 📬 NEWSLETTER -->
    <AIReadinessScore />

    <section class="cta-section">
      <NewsletterSignup variant="inline" />
    </section>

    <Footer />
    <CookieBanner />

    <script>
      // Audience filter
      const buttons = document.querySelectorAll('.audience-btn');
      const cards = document.querySelectorAll('.post-card-wrapper');

      buttons.forEach(btn => {
        btn.addEventListener('click', () => {
          // Update active button
          buttons.forEach(b => b.classList.remove('active'));
          btn.classList.add('active');

          const audience = btn.dataset.audience;
          cards.forEach(card => {
            if (audience === 'all' || card.dataset.audience === audience) {
              card.classList.remove('hidden');
            } else {
              card.classList.add('hidden');
            }
          });
        });
      });
    </script>
  </body>
</html>