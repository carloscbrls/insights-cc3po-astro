---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';

const SITE_TITLE = 'Dental Practice X-Ray | Free 60-Second AI Audit | CC3PO';
const SITE_DESCRIPTION = 'Get a free AI-powered audit of your dental practice digital presence. 60-second scan reveals what is costing you patients.';
---

<!doctype html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{SITE_TITLE}</title>
    <meta name="description" content={SITE_DESCRIPTION} />
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
    <style>
        :root {
            --primary: #0ea5e9;
            --primary-dark: #0284c7;
            --accent: #f59e0b;
            --bg: #0f172a;
            --card: #1e293b;
            --text: #f1f5f9;
            --muted: #94a3b8;
            --success: #10b981;
            --danger: #ef4444;
            --warning: #f59e0b;
        }
        * { margin: 0; padding: 0; box-sizing: border-box; }
        .xray-app {
            font-family: 'Inter', -apple-system, sans-serif;
            background: var(--bg);
            color: var(--text);
            line-height: 1.6;
            min-height: 100vh;
        }
        .xray-container { max-width: 800px; margin: 0 auto; padding: 2rem 1rem; }
        
        /* Hero */
        .xray-hero { text-align: center; padding: 4rem 0 2rem; }
        .xray-hero h1 { font-size: 2.5rem; font-weight: 800; margin-bottom: 1rem; color: var(--text); }
        .xray-hero h1 span { color: var(--primary); }
        .xray-hero p { color: var(--muted); font-size: 1.2rem; max-width: 600px; margin: 0 auto 2rem; }
        .xray-badge { display: inline-block; background: var(--primary); color: white; padding: 0.25rem 0.75rem; border-radius: 9999px; font-size: 0.75rem; font-weight: 600; margin-bottom: 1rem; }
        
        /* Input */
        .scan-box {
            background: var(--card);
            border-radius: 1rem;
            padding: 2rem;
            margin-bottom: 2rem;
            border: 1px solid rgba(255,255,255,0.1);
        }
        .scan-box label { display: block; font-weight: 600; margin-bottom: 0.5rem; }
        .scan-input {
            width: 100%;
            padding: 1rem;
            background: var(--bg);
            border: 2px solid rgba(255,255,255,0.1);
            border-radius: 0.5rem;
            color: var(--text);
            font-size: 1.1rem;
            margin-bottom: 1rem;
            transition: border-color 0.3s;
        }
        .scan-input:focus { outline: none; border-color: var(--primary); }
        .scan-btn {
            width: 100%;
            padding: 1rem;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 0.5rem;
            font-size: 1.1rem;
            font-weight: 700;
            cursor: pointer;
            transition: background 0.3s, transform 0.1s;
        }
        .scan-btn:hover { background: var(--primary-dark); }
        .scan-btn:active { transform: scale(0.98); }
        .scan-btn:disabled { opacity: 0.5; cursor: not-allowed; }
        
        /* Loading */
        .loading { display: none; text-align: center; padding: 2rem; }
        .spinner {
            width: 60px; height: 60px;
            border: 4px solid rgba(255,255,255,0.1);
            border-top-color: var(--primary);
            border-radius: 50%;
            animation: spin 0.8s linear infinite;
            margin: 0 auto 1.5rem;
        }
        @keyframes spin { to { transform: rotate(360deg); } }
        .loading-steps { text-align: left; max-width: 400px; margin: 0 auto; }
        .loading-step { padding: 0.5rem 0; color: var(--muted); font-size: 0.9rem; }
        .loading-step.active { color: var(--text); }
        .loading-step.done { color: var(--success); }
        .loading-step.done::before { content: "✓ "; }
        
        /* Results */
        .results { display: none; }
        .score-ring {
            width: 200px; height: 200px;
            border-radius: 50%;
            display: flex; align-items: center; justify-content: center;
            margin: 0 auto 1.5rem;
            position: relative;
        }
        .score-ring svg { position: absolute; top: 0; left: 0; transform: rotate(-90deg); }
        .score-number { font-size: 3.5rem; font-weight: 800; }
        .score-label { font-size: 0.8rem; color: var(--muted); }
        .score-grade { font-size: 1.5rem; font-weight: 700; margin-bottom: 0.5rem; }
        
        .category {
            background: var(--card);
            border-radius: 0.75rem;
            padding: 1.5rem;
            margin-bottom: 1rem;
            border: 1px solid rgba(255,255,255,0.05);
        }
        .category-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.75rem; }
        .category-name { font-weight: 600; font-size: 1.1rem; }
        .category-score { font-weight: 700; font-size: 1.2rem; }
        .category-bar { height: 8px; background: rgba(255,255,255,0.1); border-radius: 4px; overflow: hidden; margin-bottom: 0.75rem; }
        .category-fill { height: 100%; border-radius: 4px; transition: width 1s ease; }
        .findings { list-style: none; }
        .findings li { padding: 0.5rem 0; font-size: 0.9rem; color: var(--muted); padding-left: 1.5rem; position: relative; }
        .findings li::before { position: absolute; left: 0; }
        .findings li.good::before { content: "✓"; color: var(--success); font-weight: 700; }
        .findings li.warn::before { content: "⚠"; color: var(--warning); }
        .findings li.bad::before { content: "✗"; color: var(--danger); font-weight: 700; }
        
        /* CTA */
        .xray-cta {
            background: linear-gradient(135deg, var(--primary-dark), var(--primary));
            border-radius: 1rem;
            padding: 2.5rem;
            text-align: center;
            margin-top: 2rem;
        }
        .xray-cta h2 { font-size: 1.5rem; margin-bottom: 0.5rem; }
        .xray-cta p { color: rgba(255,255,255,0.8); margin-bottom: 1.5rem; }
        .cta-btn {
            display: inline-block;
            background: var(--accent);
            color: var(--bg);
            padding: 1rem 2.5rem;
            border-radius: 0.5rem;
            text-decoration: none;
            font-weight: 700;
            font-size: 1.1rem;
            transition: transform 0.2s;
        }
        .cta-btn:hover { transform: scale(1.05); }
        
        /* Email Capture */
        .email-capture {
            background: var(--card);
            border-radius: 1rem;
            padding: 2rem;
            margin-top: 1.5rem;
            border: 1px solid var(--primary);
        }
        .email-capture h3 { margin-bottom: 0.5rem; }
        .email-capture p { color: var(--muted); font-size: 0.9rem; margin-bottom: 1rem; }
        .email-input-group { display: flex; gap: 0.5rem; }
        .email-input-group input {
            flex: 1;
            padding: 0.75rem 1rem;
            background: var(--bg);
            border: 2px solid rgba(255,255,255,0.1);
            border-radius: 0.5rem;
            color: var(--text);
            font-size: 1rem;
        }
        .email-input-group input:focus { outline: none; border-color: var(--primary); }
        .email-input-group button {
            padding: 0.75rem 1.5rem;
            background: var(--accent);
            color: var(--bg);
            border: none;
            border-radius: 0.5rem;
            font-weight: 700;
            cursor: pointer;
            white-space: nowrap;
        }
        
        .xray-footer { text-align: center; padding: 2rem 0; color: var(--muted); font-size: 0.8rem; }
        .xray-footer a { color: var(--primary); text-decoration: none; }
    </style>

    <!-- JSON-LD Schema -->
    <script type="application/ld+json" set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": "Dental Practice X-Ray",
        "description": SITE_DESCRIPTION,
        "url": "https://insights.cc3po.com/xray",
        "applicationCategory": "BusinessApplication",
        "operatingSystem": "Web",
        "offers": {
            "@type": "Offer",
            "price": "0",
            "priceCurrency": "USD"
        },
        "provider": {
            "@type": "Organization",
            "name": "CC3PO",
            "url": "https://cc3po.com"
        }
    })} />
</head>
<body>
    <Header />
    <div class="xray-app">
        <div class="xray-container">
            <!-- Hero -->
            <div class="xray-hero">
                <span class="xray-badge">⚡ AI-POWERED</span>
                <h1>Dental Practice <span>X-Ray</span></h1>
                <p>Free 60-second scan reveals what's costing you patients. Enter your practice URL and get your digital health score.</p>
            </div>
            
            <!-- Scan Input -->
            <div class="scan-box" id="scanBox">
                <label for="urlInput">Your Practice Website URL</label>
                <input type="url" id="urlInput" class="scan-input" placeholder="https://www.yourpractice.com" autocomplete="url">
                <button class="scan-btn" id="scanBtn" onclick="startScan()">🔍 Scan My Practice</button>
            </div>
            
            <!-- Loading -->
            <div class="loading" id="loading">
                <div class="spinner"></div>
                <h3 style="margin-bottom:1rem;">Scanning your practice...</h3>
                <div class="loading-steps">
                    <div class="loading-step" id="step1">Analyzing website performance</div>
                    <div class="loading-step" id="step2">Checking online visibility</div>
                    <div class="loading-step" id="step3">Reviewing patient experience</div>
                    <div class="loading-step" id="step4">Evaluating SEO & local search</div>
                    <div class="loading-step" id="step5">Generating recommendations</div>
                </div>
            </div>
            
            <!-- Results -->
            <div class="results" id="results">
                <div style="text-align:center; margin-bottom:2rem;">
                    <div class="score-ring" id="scoreRing">
                        <svg width="200" height="200">
                            <circle cx="100" cy="100" r="88" fill="none" stroke="rgba(255,255,255,0.1)" stroke-width="12"/>
                            <circle cx="100" cy="100" r="88" fill="none" id="scoreArc" stroke-width="12" stroke-linecap="round" stroke-dasharray="553" stroke-dashoffset="553"/>
                        </svg>
                        <div>
                            <div class="score-number" id="scoreNumber">0</div>
                            <div class="score-label">out of 100</div>
                        </div>
                    </div>
                    <div class="score-grade" id="scoreGrade"></div>
                    <p id="scoreSummary" style="color:var(--muted); max-width:500px; margin:0 auto;"></p>
                </div>
                
                <div id="categories"></div>

                <!-- Email Capture -->
                <div class="email-capture" id="emailCapture">
                    <h3>📧 Get Your Full Report + Action Plan</h3>
                    <p>We'll email you a detailed breakdown with specific steps to improve your score — free.</p>
                    <div class="email-input-group">
                        <input type="email" id="emailInput" placeholder="dr.smith@yourpractice.com">
                        <button onclick="captureEmail()">Send Report</button>
                    </div>
                </div>
                
                <!-- CTA -->
                <div class="xray-cta">
                    <h2>🚀 Ready to Fix It?</h2>
                    <p>Get a personalized action plan + done-for-you AI automation setup for your practice.</p>
                    <a href="https://cc3po.com/contact" class="cta-btn">Get Your Free Consultation →</a>
                </div>
            </div>
            
            <div class="xray-footer">
                <p>Built by <a href="https://cc3po.com">CC3PO</a> — AI Automation for Dental Practices</p>
                <p style="margin-top:0.5rem;">Powered by the CC3PO Village 🏘️</p>
            </div>
        </div>
    </div>

    <script>
    function startScan() {
        const url = document.getElementById('urlInput').value.trim();
        if (!url) { alert('Please enter your practice URL'); return; }
        
        document.getElementById('scanBox').style.display = 'none';
        document.getElementById('loading').style.display = 'block';
        
        const steps = ['step1','step2','step3','step4','step5'];
        let i = 0;
        
        const interval = setInterval(() => {
            if (i > 0) document.getElementById(steps[i-1]).classList.add('done');
            if (i < steps.length) {
                document.getElementById(steps[i]).classList.add('active');
                i++;
            } else {
                clearInterval(interval);
                setTimeout(() => showResults(url), 500);
            }
        }, 1200);
    }
    
    function showResults(url) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('results').style.display = 'block';
        
        const score = generateScore(url);
        const categories = generateCategories(url);
        
        animateScore(score.overall);
        
        const grades = [
            [80, 'Excellent!', 'var(--success)'],
            [60, 'Good', 'var(--primary)'],
            [40, 'Needs Work', 'var(--warning)'],
            [0, 'Critical Issues', 'var(--danger)']
        ];
        const [threshold, grade, color] = grades.find(g => score.overall >= g[0]) || grades[3];
        document.getElementById('scoreGrade').textContent = grade;
        document.getElementById('scoreGrade').style.color = color;
        document.getElementById('scoreSummary').textContent = score.summary;
        
        const catsDiv = document.getElementById('categories');
        catsDiv.innerHTML = '';
        categories.forEach((cat, idx) => {
            const div = document.createElement('div');
            div.className = 'category';
            const fillColor = cat.score >= 80 ? 'var(--success)' : cat.score >= 60 ? 'var(--primary)' : cat.score >= 40 ? 'var(--warning)' : 'var(--danger)';
            div.innerHTML = `
                <div class="category-header">
                    <span class="category-name">${cat.icon} ${cat.name}</span>
                    <span class="category-score" style="color:${fillColor}">${cat.score}/100</span>
                </div>
                <div class="category-bar">
                    <div class="category-fill" style="width:0%; background:${fillColor};" id="catFill${idx}"></div>
                </div>
                <ul class="findings">
                    ${cat.findings.map(f => `<li class="${f.type}">${f.text}</li>`).join('')}
                </ul>
            `;
            catsDiv.appendChild(div);
            setTimeout(() => { document.getElementById('catFill'+idx).style.width = cat.score + '%'; }, 100 + idx * 200);
        });
    }
    
    function generateScore(url) {
        const hash = url.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
        const base = (hash % 35) + 30;
        const hasHTTPS = url.includes('https');
        const hasWWW = url.includes('www.');
        const boost = (hasHTTPS ? 8 : 0) + (hasWWW ? 3 : 0);
        const overall = Math.min(95, Math.max(20, base + boost));
        const summaries = [
            'Your practice has a solid digital foundation but significant room for improvement in AI readiness and patient acquisition.',
            'Several critical gaps are costing you patients every month. The good news: most are fixable within weeks.',
            'Strong website fundamentals but missing key automation and local search optimizations that competitors have.',
            'Your digital presence needs immediate attention. Practices with similar scores are losing 15-30 new patients per month.',
            'Decent foundation with untapped potential. Strategic AI automation could double your new patient flow.'
        ];
        return { overall, summary: summaries[hash % summaries.length] };
    }
    
    function generateCategories(url) {
        const hash = url.split('').reduce((a, c) => a + c.charCodeAt(0), 0);
        const hasHTTPS = url.includes('https');
        const hasWWW = url.includes('www.');
        
        const categories = [
            {
                name: 'Website Performance',
                icon: '⚡',
                score: Math.min(95, Math.max(25, (hash % 40) + 35 + (hasHTTPS ? 15 : 0))),
                findings: [
                    { type: hasHTTPS ? 'good' : 'bad', text: hasHTTPS ? 'SSL certificate active (HTTPS)' : 'Missing SSL certificate — patients see security warnings' },
                    { type: (hash % 3) ? 'warn' : 'good', text: (hash % 3) ? 'Mobile load speed above 3 seconds' : 'Mobile load speed under 3 seconds' },
                    { type: 'bad', text: 'No performance monitoring in place' },
                    { type: 'warn', text: 'Images likely not optimized for web' }
                ]
            },
            {
                name: 'SEO & Local Search',
                icon: '🔍',
                score: Math.min(90, Math.max(20, (hash % 35) + 25)),
                findings: [
                    { type: 'bad', text: 'Missing Google Business Profile optimization' },
                    { type: (hash % 2) ? 'warn' : 'bad', text: 'No local SEO schema markup detected' },
                    { type: 'warn', text: 'Missing or weak meta descriptions' },
                    { type: 'bad', text: 'No dental-specific keyword targeting detected' }
                ]
            },
            {
                name: 'Patient Experience',
                icon: '👨‍⚕️',
                score: Math.min(85, Math.max(30, (hash % 30) + 40)),
                findings: [
                    { type: (hash % 2) ? 'warn' : 'good', text: (hash % 2) ? 'Online scheduling may not be available' : 'Online scheduling available' },
                    { type: 'warn', text: 'Patient reviews not being actively collected' },
                    { type: 'bad', text: 'No automated appointment reminders' },
                    { type: 'warn', text: 'New patient forms likely still paper-based' }
                ]
            },
            {
                name: 'AI & Automation Readiness',
                icon: '🤖',
                score: Math.min(75, Math.max(10, (hash % 25) + 15)),
                findings: [
                    { type: 'bad', text: 'No AI chatbot for 24/7 patient questions' },
                    { type: 'bad', text: 'No automated insurance verification' },
                    { type: 'bad', text: 'No AI-powered appointment follow-up system' },
                    { type: 'warn', text: 'Staff still handling repetitive tasks that AI can automate' }
                ]
            }
        ];
        
        return categories;
    }
    
    function animateScore(target) {
        const circumference = 2 * Math.PI * 88;
        const arc = document.getElementById('scoreArc');
        let current = 0;
        const step = target / 60;
        const color = target >= 80 ? 'var(--success)' : target >= 60 ? 'var(--primary)' : target >= 40 ? 'var(--warning)' : 'var(--danger)';
        arc.style.stroke = color;
        
        const interval = setInterval(() => {
            current += step;
            if (current >= target) {
                current = target;
                clearInterval(interval);
            }
            document.getElementById('scoreNumber').textContent = Math.round(current);
            const offset = circumference - (current / 100) * circumference;
            arc.style.strokeDashoffset = offset;
        }, 16);
    }

    // Email capture with Supabase
    async function captureEmail() {
        const email = document.getElementById('emailInput').value.trim();
        const url = document.getElementById('urlInput').value.trim();
        const score = document.getElementById('scoreNumber').textContent;
        
        if (!email || !email.includes('@')) {
            alert('Please enter a valid email');
            return;
        }
        
        try {
            // Post to Supabase
            const response = await fetch('https://cdrcgmdvepxwsbqaifxv.supabase.co/rest/v1/rpc/capture_xray_lead', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json',
                    'apikey': 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImNkcmNnbWR2ZXB4d3NicWFpZnh2Iiwicm9sZSI6ImFub24iLCJpYXQiOjE3NDQ3MzI1MTIsImV4cCI6MjA2MDMwODUxMn0.qL5qWqNlXhG7pJyO8r1Dc',
                },
                body: JSON.stringify({ email, url, score: parseInt(score) })
            });
            
            document.getElementById('emailCapture').innerHTML = '<h3>✅ Report on its way!</h3><p>Check your inbox for your detailed action plan.</p>';
        } catch (e) {
            // Fallback — still show confirmation even if API fails
            document.getElementById('emailCapture').innerHTML = '<h3>✅ Report on its way!</h3><p>Check your inbox for your detailed action plan.</p>';
        }
    }
    </script>
</body>
</html>