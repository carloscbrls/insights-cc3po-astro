---
import Layout from '../layouts/Layout.astro';
import PostCard from '../components/PostCard.astro';
import { getPosts } from '../lib/blog';

// Full archive (Insights Shift Change, pattern 6): every post grouped
// by month, newest first. Folio Line cards (elevation pass, 2026-11-25).
const all = await getPosts();
const groups = new Map<string, typeof all>();
for (const post of all) {
  const key = post.data.pubDate.toLocaleDateString('en-US', { month: 'long', year: 'numeric', timeZone: 'UTC' });
  if (!groups.has(key)) groups.set(key, []);
  groups.get(key)!.push(post);
}
---

<Layout title="Archive — CC3PO Insights" description="Every CC3PO Insights post, grouped by month.">
<section class="cc-section">
  <div class="cc-container">
    <div class="folio-header" style="margin-bottom: 40px;">
      <p class="folio-kicker">Archive</p>
      <h1>Every post, by month</h1>
      <p class="folio-lede">{all.length} posts and counting. Subscribe on the <a href="/#subscribe" style="color: var(--semantic-success); text-decoration: underline; text-underline-offset: 3px;">homepage</a> to get new ones by email.</p>
      <hr class="folio-rule" />
    </div>
    {[...groups.entries()].map(([month, posts]) => (
      <div style="margin-bottom: 44px;">
        <h2 class="f-serif" style="font-size: 22px; font-weight: 600; color: var(--brand-paper); margin: 0 0 6px;">{month}</h2>
        <hr class="folio-rule" style="margin: 0 0 20px; width: 72px;" />
        <div class="cc-posts-grid">
          {posts.map((post) => <PostCard post={post} />)}
        </div>
      </div>
    ))}
  </div>
</section>
</Layout>
