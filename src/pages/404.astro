---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---

<html lang="en">
	<head>
		<BaseHead title="404 - Page Not Found" description="The page you're looking for doesn't exist." />
	</head>
	<body>
		<Header />
		<div class="hero">
			<h1>404</h1>
			<p>Page not found</p>
			<a href="/blog/" class="cta-btn primary">Back to Blog</a>
		</div>
		<Footer />
	</body>
</html>
<style>
	.hero { min-height: 50vh; display: flex; flex-direction: column; align-items: center; justify-content: center; text-align: center; padding: 120px 24px; }
	h1 { font-size: 120px; font-weight: 800; background: linear-gradient(135deg, #6b35ff, #00d2ff); -webkit-background-clip: text; -webkit-text-fill-color: transparent; margin: 0; }
	p { font-size: 24px; color: #a1a1aa; margin: 16px 0 32px; }
	.cta-btn { display: inline-block; padding: 14px 32px; background: linear-gradient(135deg, #6b35ff, #00d2ff); color: #fff; border-radius: 26px; text-decoration: none; font-weight: 600; }
</style>
