---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Websites, Domains & Automation">
  <section class="max-w-6xl mx-auto px-4 py-16">
    <!-- Hero -->
    <div class="text-center mb-20">
      <div class="inline-flex items-center gap-2 bg-emerald-500/10 border border-emerald-500/20 rounded-full px-4 py-1.5 mb-6">
        <span class="w-2 h-2 bg-emerald-400 rounded-full animate-pulse"></span>
        <span class="text-emerald-400 text-sm font-medium">Built with AI — Delivered in 48 hours</span>
      </div>
      <h1 class="text-4xl md:text-6xl font-bold text-white mb-4 leading-tight">
        Your Website,<br>
        <span class="bg-gradient-to-r from-emerald-400 to-cyan-400 bg-clip-text text-transparent">Your Way</span>
      </h1>
      <p class="text-gray-400 text-lg max-w-2xl mx-auto mb-8">
        One place to buy your domain, build your site, and manage everything.
        No tech skills needed. No multiple vendors. No hidden fees.
      </p>
      <div class="flex flex-col sm:flex-row gap-4 justify-center">
        <a href="#pricing" class="bg-emerald-500 hover:bg-emerald-400 text-black font-bold px-8 py-3 rounded-lg transition text-lg shadow-lg shadow-emerald-500/20">See Plans</a>
        <a href="#domain" class="border border-gray-600 hover:border-emerald-500 text-white font-bold px-8 py-3 rounded-lg transition text-lg">Buy a Domain</a>
      </div>
    </div>

    <!-- Stats Bar -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 mb-20">
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-5 text-center">
        <p class="text-2xl font-bold text-white">48<span class="text-emerald-400 text-lg">hr</span></p>
        <p class="text-gray-500 text-sm">Average build time</p>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-5 text-center">
        <p class="text-2xl font-bold text-white">12+</p>
        <p class="text-gray-500 text-sm">Sites hosted</p>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-5 text-center">
        <p class="text-2xl font-bold text-white">9</p>
        <p class="text-gray-500 text-sm">Active clients</p>
      </div>
      <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-5 text-center">
        <p class="text-2xl font-bold text-white">100<span class="text-emerald-400 text-lg">%</span></p>
        <p class="text-gray-500 text-sm">White-label delivery</p>
      </div>
    </div>

    <!-- The Flow -->
    <div class="mb-20">
      <h2 class="text-2xl md:text-3xl font-bold text-white text-center mb-2">How It Works</h2>
      <p class="text-gray-400 text-center mb-10 max-w-xl mx-auto">Four simple steps from idea to live website.</p>
      <div class="grid md:grid-cols-4 gap-6 relative">
        <!-- Connector line -->
        <div class="hidden md:block absolute top-12 left-[12.5%] right-[12.5%] h-0.5 bg-gradient-to-r from-emerald-500/40 via-emerald-500/20 to-emerald-500/40"></div>
        
        <div class="text-center relative">
          <div class="w-24 h-24 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 border border-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
          <span class="block text-emerald-400 text-sm font-bold mb-1">STEP 1</span>
          <h3 class="text-white font-semibold mb-1">Buy Your Domain</h3>
          <p class="text-gray-500 text-sm">Search and register your domain through our link. Or bring your own.</p>
        </div>
        <div class="text-center relative">
          <div class="w-24 h-24 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 border border-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <span class="block text-emerald-400 text-sm font-bold mb-1">STEP 2</span>
          <h3 class="text-white font-semibold mb-1">Choose Your Path</h3>
          <p class="text-gray-500 text-sm">We build it for you, or use Bolt.new to build it yourself with AI.</p>
        </div>
        <div class="text-center relative">
          <div class="w-24 h-24 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 border border-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          <span class="block text-emerald-400 text-sm font-bold mb-1">STEP 3</span>
          <h3 class="text-white font-semibold mb-1">Get Your Portal</h3>
          <p class="text-gray-500 text-sm">White-label dashboard to manage your site, email, and billing.</p>
        </div>
        <div class="text-center relative">
          <div class="w-24 h-24 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 border border-emerald-500/20 rounded-2xl flex items-center justify-center mx-auto mb-4">
            <svg class="w-10 h-10 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <span class="block text-emerald-400 text-sm font-bold mb-1">STEP 4</span>
          <h3 class="text-white font-semibold mb-1">Go Live</h3>
          <p class="text-gray-500 text-sm">Site deployed on SiteGround with SSL, CDN, backups, and monitoring.</p>
        </div>
      </div>
    </div>

    <!-- Domain Search Section -->
    <div id="domain" class="bg-gradient-to-br from-[#0f0f1a] to-[#0a0a14] border border-gray-800 rounded-2xl p-8 md:p-10 mb-20">
      <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-6 mb-8">
        <div>
          <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Step 1: Get Your Domain</h2>
          <p class="text-gray-400">Search for available domains. We use SiteGround for registration — you get a great price, we get a small commission.</p>
        </div>
        <div class="flex-shrink-0">
          <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-4 py-2 text-center">
            <p class="text-xs text-gray-500">Domains starting at</p>
            <p class="text-xl font-bold text-emerald-400">$10<span class="text-sm text-gray-500">/yr</span></p>
          </div>
        </div>
      </div>
      
      <div class="flex flex-col sm:flex-row gap-3 mb-6">
        <div class="flex-1 relative">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-5 h-5 text-gray-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="yourbusiness.com" class="w-full bg-[#1a1a2e] border border-gray-700 rounded-lg pl-10 pr-4 py-3 text-white placeholder-gray-500 focus:outline-none focus:border-emerald-500 transition" />
        </div>
        <a href="https://www.siteground.com/go/a3sob40itj" target="_blank" class="bg-emerald-500 hover:bg-emerald-400 text-black font-semibold px-6 py-3 rounded-lg transition whitespace-nowrap text-center">Search on SiteGround →</a>
      </div>
      
      <div class="grid md:grid-cols-3 gap-4 text-sm">
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">$10-15/year</strong> for .com through SiteGround. No markup.</span>
        </div>
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">Already have a domain?</strong> We'll point it to your new site.</span>
        </div>
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">Buy through our link</strong> and we earn a commission that keeps prices low.</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Choose Your Path -->
    <div class="mb-20">
      <h2 class="text-2xl md:text-3xl font-bold text-white text-center mb-2">Step 2: Choose Your Path</h2>
      <p class="text-gray-400 text-center mb-10 max-w-xl mx-auto">Two ways to get your site built. Pick the one that fits you best.</p>

      <div class="grid md:grid-cols-2 gap-6">
        <!-- Path A: We Build -->
        <div class="bg-gradient-to-br from-[#0f0f1a] to-[#0a0a14] border-2 border-emerald-500/30 rounded-2xl p-8 relative group hover:border-emerald-500/60 transition">
          <div class="absolute -top-3 left-6 bg-emerald-500 text-black text-xs font-bold px-3 py-1 rounded-full">MOST POPULAR</div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-emerald-500/20 to-emerald-500/5 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">We Build It For You</h3>
              <p class="text-gray-500 text-sm">Sit back, we handle everything</p>
            </div>
          </div>
          <p class="text-gray-400 mb-6">Tell us what you need. We use AI to build your site fast. You review, we refine, you go live.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Built in <strong class="text-white">24-48 hours</strong></span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>You review and request changes</span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>We handle domain setup, SSL, everything</span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Ongoing support and edits</span>
            </li>
          </ul>
          <a href="#pricing" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold py-3 rounded-lg transition shadow-lg shadow-emerald-500/20">See Plans →</a>
        </div>

        <!-- Path B: You Build with Bolt.new -->
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-2xl p-8 group hover:border-gray-700 transition">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-12 h-12 bg-gradient-to-br from-purple-500/20 to-purple-500/5 rounded-xl flex items-center justify-center">
              <svg class="w-6 h-6 text-purple-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white">Build It Yourself</h3>
              <p class="text-gray-500 text-sm">Powered by Bolt.new AI</p>
            </div>
          </div>
          <p class="text-gray-400 mb-6">Use Bolt.new — the AI-powered web builder — to create your own site. Describe what you want, and AI builds it. We host it on SiteGround.</p>
          <ul class="space-y-3 mb-8">
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Describe your site in <strong class="text-white">plain English</strong></span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Bolt.new builds it with AI in <strong class="text-white">minutes</strong></span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Export and deploy to your SiteGround hosting</span>
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-purple-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>We handle the <strong class="text-white">technical setup</strong></span>
            </li>
          </ul>
          <a href="https://bolt.new" target="_blank" class="block text-center border border-gray-600 hover:border-purple-500 text-white font-semibold py-3 rounded-lg transition">Try Bolt.new →</a>
        </div>
      </div>
    </div>

    <!-- Pricing Tiers -->
    <div id="pricing" class="mb-20">
      <div class="text-center mb-12">
        <h2 class="text-2xl md:text-3xl font-bold text-white mb-2">Step 3: Pick a Plan</h2>
        <p class="text-gray-400 max-w-xl mx-auto">All plans include hosting on SiteGround, free SSL, CDN, daily backups, and your own white-label client portal.</p>
      </div>

      <div class="grid md:grid-cols-3 gap-6">
        <!-- Spark -->
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-2xl p-6 flex flex-col group hover:border-gray-700 transition">
          <h3 class="text-xl font-bold text-white mb-1">Spark</h3>
          <p class="text-gray-500 text-sm mb-4">Perfect for getting started</p>
          <p class="text-3xl font-bold text-white mb-1">$97<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <p class="text-xs text-gray-600 mb-6">Domain not included (~$10-15/yr)</p>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              1-page professional website
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Free SSL &amp; CDN
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Daily backups
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Email account setup
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              1 monthly edit
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              White-label client portal
            </li>
          </ul>
          <a href="https://checkout.cc3po.com/b/9B600i1ZI3EXelS5C41B61z" class="block text-center bg-emerald-500 hover:bg-emerald-400 text-black font-semibold py-3 rounded-lg transition">Get Spark</a>
        </div>

        <!-- Engine -->
        <div class="bg-gradient-to-br from-[#0f0f1a] to-[#0a0a14] border-2 border-emerald-500/30 rounded-2xl p-6 flex flex-col relative group hover:border-emerald-500/60 transition">
          <div class="absolute top-0 right-0">
            <span class="block bg-emerald-500 text-black text-xs font-bold px-4 py-1.5 rounded-bl-xl rounded-tr-xl">POPULAR</span>
          </div>
          <h3 class="text-xl font-bold text-white mb-1">Engine</h3>
          <p class="text-gray-500 text-sm mb-4">For growing businesses</p>
          <p class="text-3xl font-bold text-white mb-1">$297<span class="text-sm text-gray-500 font-normal">/mo</span></p>
          <p class="text-xs text-gray-600 mb-6">Domain not included (~$10-15/yr)</p>
          <ul class="space-y-3 mb-8 flex-1">
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Multi-page website (up to 5 pages)
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Blog setup
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              SEO optimization
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Free SSL &amp; CDN
            </li>
            <li class="flex items-start gap-3 text-gray-400 text-sm">
              <svg class="w-5 h-5 text-emerald-400 mt-0.5 flex-shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              Daily backups
