---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Websites, Domains & Automation">
  <style>
    /* ============================================
       /agency/ — Folio Line treatment (elevation pass, 2026-11-25)
       The agency page as a feature in the magazine: folio masthead,
       gilt rules, medallions, cover plates, Fraunces display type.
       Nightshift tokens only; copy, prices, links and form logic are
       the page's own, unchanged — only the treatment moved.
       ============================================ */
    .ag-wrap { max-width: 72rem; margin: 0 auto; padding: 0 1rem 4rem; }
    @media (min-width: 640px) { .ag-wrap { padding: 0 1.5rem 4rem; } }

    /* --- Masthead --- */
    .ag-masthead {
      position: relative;
      overflow: hidden;
      background:
        radial-gradient(90% 120% at 50% 0%, color-mix(in srgb, var(--folio-gold) 9%, transparent), transparent 60%),
        linear-gradient(180deg, #0d0d18 0%, var(--brand-night) 100%);
      padding: 8rem 1rem 4.5rem;
    }
    .ag-masthead::before {
      content: '';
      position: absolute; inset: 0;
      background-image:
        linear-gradient(90deg, color-mix(in srgb, var(--folio-gold) 3.5%, transparent) 1px, transparent 1px),
        linear-gradient(0deg, color-mix(in srgb, var(--folio-gold) 3.5%, transparent) 1px, transparent 1px);
      background-size: 56px 56px;
      pointer-events: none;
    }
    .ag-masthead-inner {
      position: relative;
      max-width: 72rem; margin: 0 auto;
      display: grid; grid-template-columns: 1.02fr 0.98fr; gap: 3rem; align-items: center;
    }
    @media (max-width: 900px) { .ag-masthead-inner { grid-template-columns: 1fr; gap: 2.25rem; } }
    .ag-badge {
      display: inline-flex; align-items: center; gap: 0.5rem;
      padding: 0.4rem 1rem;
      border: 1px solid color-mix(in srgb, var(--folio-gold) 40%, transparent);
      background: color-mix(in srgb, var(--folio-gold) 8%, transparent);
      border-radius: 999px;
      font-family: var(--folio-mono); font-size: 11px; font-weight: 700;
      letter-spacing: 0.18em; text-transform: uppercase;
      color: var(--folio-gold);
      margin-bottom: 1.5rem;
    }
    .ag-badge-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--folio-gold); position: relative; flex-shrink: 0; }
    .ag-badge-dot::after {
      content: ''; position: absolute; top: -3px; left: -3px; width: 14px; height: 14px;
      border-radius: 50%; background: color-mix(in srgb, var(--folio-gold) 25%, transparent);
    }
    @media (prefers-reduced-motion: no-preference) {
      .ag-badge-dot::after { animation: ag-pulse 2s ease-out infinite; }
      @keyframes ag-pulse { 0% { transform: scale(0.8); opacity: 1; } 100% { transform: scale(2.2); opacity: 0; } }
    }
    .ag-h1 {
      font-family: var(--folio-serif); font-weight: 600;
      font-size: clamp(2.6rem, 5.6vw, 4.4rem);
      line-height: 1.05; letter-spacing: -0.015em;
      color: var(--brand-paper); margin: 0 0 1.25rem;
    }
    .ag-h1 .ag-gilt {
      background: linear-gradient(120deg, var(--folio-gold-bright), var(--folio-gold) 65%);
      -webkit-background-clip: text; background-clip: text; -webkit-text-fill-color: transparent;
    }
    .ag-lede { font-size: 1.125rem; line-height: 1.65; color: color-mix(in srgb, var(--brand-paper) 72%, transparent); max-width: 34rem; margin: 0 0 2rem; }
    .ag-cta-row { display: flex; flex-wrap: wrap; gap: 0.75rem; }
    .ag-btn {
      display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem;
      min-height: 48px; padding: 0.8rem 2rem;
      background: var(--folio-gold); color: var(--brand-night);
      font-weight: 700; font-size: 0.95rem; border-radius: 10px;
      text-decoration: none; border: 1px solid var(--folio-gold);
      transition: transform 0.2s, background 0.2s, border-color 0.2s;
    }
    .ag-btn:hover { background: var(--folio-gold-bright); border-color: var(--folio-gold-bright); }
    .ag-btn-ghost {
      background: color-mix(in srgb, var(--brand-paper) 5%, transparent);
      color: var(--brand-paper);
      border: 1px solid color-mix(in srgb, var(--brand-paper) 14%, transparent);
    }
    .ag-btn-ghost:hover { background: color-mix(in srgb, var(--brand-paper) 10%, transparent); border-color: color-mix(in srgb, var(--brand-paper) 25%, transparent); }
    @media (prefers-reduced-motion: no-preference) {
      .ag-btn:hover { transform: translateY(-2px); }
    }
    .ag-btn:focus-visible, .ag-card-link:focus-visible, .ag-addon:focus-visible {
      outline: 2px solid var(--folio-gold); outline-offset: 3px;
    }
    .ag-hero-media {
      border-radius: 16px; overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--folio-gold) 25%, transparent);
      aspect-ratio: 16 / 10;
      box-shadow: 0 30px 60px rgba(0,0,0,0.45);
    }
    .ag-hero-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
    .ag-hero-caption {
      font-family: var(--folio-mono); font-size: 11.5px; letter-spacing: 0.04em;
      color: var(--semantic-muted); margin: 0.8rem 0 0; text-align: center;
    }

    /* --- Section furniture --- */
    .ag-section-head { text-align: center; max-width: 36rem; margin: 0 auto 3rem; }
    .ag-section-head .folio-kicker { margin-bottom: 0.6rem; }
    .ag-h2 {
      font-family: var(--folio-serif); font-weight: 600; letter-spacing: -0.01em;
      font-size: clamp(1.7rem, 3.4vw, 2.5rem); line-height: 1.15;
      color: var(--brand-paper); margin: 0 0 0.6rem;
    }
    .ag-h2-left { text-align: left; }
    .ag-sub { color: color-mix(in srgb, var(--brand-paper) 62%, transparent); font-size: 1rem; line-height: 1.6; margin: 0; }
    .ag-block { margin-bottom: 5rem; }
    .ag-panel {
      background: linear-gradient(180deg, color-mix(in srgb, var(--brand-surface-dark) 82%, transparent), var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      border-radius: 16px; padding: 2.5rem;
      position: relative; overflow: hidden;
    }
    .ag-panel::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--folio-gold), color-mix(in srgb, var(--folio-gold) 0%, transparent));
    }
    @media (max-width: 640px) { .ag-panel { padding: 1.6rem; } }

    /* --- Stats strip --- */
    .ag-stats {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem;
      max-width: 44rem; margin: 0 auto 5rem;
      border-top: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      border-bottom: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      padding: 1.6rem 0;
    }
    @media (max-width: 640px) { .ag-stats { grid-template-columns: repeat(2, 1fr); } }
    .ag-stat { text-align: center; padding: 0 0.5rem; }
    .ag-stat-num { font-family: var(--folio-serif); font-weight: 700; font-size: clamp(1.9rem, 4vw, 2.6rem); line-height: 1; color: var(--folio-gold); margin-bottom: 0.35rem; }
    .ag-stat-num .ag-stat-unit { font-size: 0.45em; }
    .ag-stat-label { font-size: 0.85rem; color: color-mix(in srgb, var(--brand-paper) 62%, transparent); }

    /* --- Steps --- */
    .ag-steps { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; }
    @media (max-width: 1024px) { .ag-steps { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .ag-steps { grid-template-columns: 1fr; } }
    .ag-step {
      background: linear-gradient(180deg, color-mix(in srgb, var(--brand-surface-dark) 82%, transparent), var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      border-radius: 16px; padding: 2rem 1.5rem; text-align: center;
      position: relative; overflow: hidden;
    }
    .ag-step::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--folio-gold), color-mix(in srgb, var(--folio-gold) 0%, transparent));
    }
    .ag-step .folio-medallion { margin-bottom: 0.9rem; }
    .ag-step-kicker { font-family: var(--folio-mono); font-size: 11px; font-weight: 700; letter-spacing: 0.24em; color: var(--folio-gold); margin: 0 0 0.5rem; }
    .ag-step h3 { font-family: var(--folio-serif); font-weight: 600; font-size: 1.1rem; color: var(--brand-paper); margin: 0 0 0.45rem; }
    .ag-step p { font-size: 0.83rem; line-height: 1.6; color: color-mix(in srgb, var(--brand-paper) 62%, transparent); margin: 0; }

    /* --- Domain panel --- */
    .ag-domain-head { display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 1.5rem; margin-bottom: 1.5rem; }
    .ag-price-plate {
      position: relative; flex-shrink: 0; width: 190px; height: 110px;
      border-radius: 12px; overflow: hidden;
      border: 1px solid color-mix(in srgb, var(--folio-gold) 30%, transparent);
      background:
        radial-gradient(130% 150% at 18% 0%, color-mix(in srgb, var(--folio-gold) 24%, transparent), transparent 58%),
        linear-gradient(160deg, #151528, var(--brand-night));
    }
    .ag-price-plate::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--folio-gold), color-mix(in srgb, var(--folio-gold) 0%, transparent));
    }
    .ag-price-plate .ag-plate-label {
      position: absolute; top: 14px; left: 16px;
      font-family: var(--folio-mono); font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.2em; text-transform: uppercase; color: var(--folio-gold);
    }
    .ag-price-plate .ag-plate-price {
      position: absolute; left: 16px; bottom: 10px;
      font-family: var(--folio-serif); font-weight: 700; font-size: 2.6rem; line-height: 1; color: var(--brand-paper);
    }
    .ag-price-plate .ag-plate-price .ag-plate-per { font-size: 1rem; color: color-mix(in srgb, var(--brand-paper) 62%, transparent); }
    .ag-search-row { display: flex; gap: 0.75rem; flex-wrap: wrap; margin-bottom: 1.25rem; }
    .ag-search-field { flex: 1; min-width: 200px; position: relative; }
    .ag-search-field svg { position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: color-mix(in srgb, var(--brand-paper) 45%, transparent); }
    .ag-input {
      width: 100%; box-sizing: border-box;
      background: color-mix(in srgb, var(--brand-paper) 4%, var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 12%, transparent);
      border-radius: 10px; padding: 0.8rem 1rem;
      color: var(--brand-paper); font-size: 16px; font-family: inherit;
      transition: border-color 0.2s;
    }
    .ag-input::placeholder { color: color-mix(in srgb, var(--brand-paper) 40%, transparent); }
    .ag-input:focus { outline: none; border-color: var(--folio-gold); box-shadow: 0 0 0 3px color-mix(in srgb, var(--folio-gold) 15%, transparent); }
    .ag-search-field .ag-input { padding-left: 2.6rem; }
    .ag-checks { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; font-size: 0.875rem; }
    @media (max-width: 768px) { .ag-checks { grid-template-columns: 1fr; } }
    .ag-check { display: flex; align-items: flex-start; gap: 0.5rem; color: color-mix(in srgb, var(--brand-paper) 62%, transparent); line-height: 1.55; }
    .ag-check svg { width: 16px; height: 16px; color: var(--folio-gold); flex-shrink: 0; margin-top: 2px; }
    .ag-check strong { color: color-mix(in srgb, var(--brand-paper) 85%, transparent); }

    /* --- Path + plan cards with plates --- */
    .ag-cards-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1.25rem; }
    @media (max-width: 900px) { .ag-cards-2 { grid-template-columns: 1fr; } }
    .ag-cards-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
    @media (max-width: 900px) { .ag-cards-3 { grid-template-columns: 1fr; } }
    .ag-card {
      display: flex; flex-direction: column;
      background: linear-gradient(180deg, color-mix(in srgb, var(--brand-surface-dark) 82%, transparent), var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      border-radius: 16px; overflow: hidden; position: relative;
      transition: border-color 0.2s;
    }
    .ag-card:hover { border-color: color-mix(in srgb, var(--folio-gold) 40%, transparent); }
    .ag-card-featured { border: 1px solid color-mix(in srgb, var(--folio-gold) 45%, transparent); }
    .ag-card-plate { height: 118px; position: relative; flex-shrink: 0; }
    .ag-card-plate-sm { height: 92px; }
    .ag-card-badge {
      position: absolute; top: 14px; right: 16px; z-index: 2;
      background: var(--folio-gold); color: var(--brand-night);
      font-family: var(--folio-mono); font-size: 10.5px; font-weight: 700;
      letter-spacing: 0.14em; padding: 4px 12px; border-radius: 999px;
    }
    .ag-card-body { padding: 1.75rem; display: flex; flex-direction: column; flex: 1; }
    .ag-card h3 { font-family: var(--folio-serif); font-weight: 600; font-size: 1.4rem; color: var(--brand-paper); margin: 0 0 0.2rem; }
    .ag-card .ag-card-sub { font-size: 0.8rem; color: color-mix(in srgb, var(--brand-paper) 55%, transparent); margin: 0 0 1rem; }
    .ag-card p { font-size: 0.9rem; line-height: 1.65; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); }
    .ag-card-body > p { margin: 0 0 1.25rem; }
    .ag-price { font-family: var(--folio-serif); font-weight: 700; font-size: 2.5rem; line-height: 1; color: var(--brand-paper); margin: 0 0 0.3rem; }
    .ag-price .ag-price-per { font-family: var(--folio-serif); font-size: 0.95rem; font-weight: 400; color: color-mix(in srgb, var(--brand-paper) 55%, transparent); }
    .ag-note { font-size: 0.8rem; color: color-mix(in srgb, var(--brand-paper) 55%, transparent); margin: 0 0 1.5rem; }
    .ag-list { list-style: none; margin: 0 0 1.5rem; padding: 0; flex: 1; }
    .ag-list li { display: flex; align-items: flex-start; gap: 0.6rem; font-size: 0.9rem; line-height: 1.55; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); padding: 0.28rem 0; }
    .ag-list svg { width: 18px; height: 18px; color: var(--folio-gold); flex-shrink: 0; margin-top: 1px; }
    .ag-list strong { color: var(--brand-paper); }
    .ag-card .ag-btn { width: 100%; box-sizing: border-box; }

    /* --- Bolt panel --- */
    .ag-bolt-head { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.25rem; }
    .ag-bolt-head .folio-medallion { margin: 0; width: 52px; height: 52px; }
    .ag-bolt-head .folio-medallion svg { width: 22px; height: 22px; color: var(--folio-gold); }
    .ag-bolt-head h2 { font-family: var(--folio-serif); font-weight: 600; font-size: 1.7rem; color: var(--brand-paper); margin: 0; }
    .ag-bolt-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; margin-top: 2rem; }
    @media (max-width: 900px) { .ag-bolt-grid { grid-template-columns: 1fr; } }
    .ag-bolt-card {
      background: color-mix(in srgb, var(--brand-night) 55%, transparent);
      border: 1px solid color-mix(in srgb, var(--brand-paper) 8%, transparent);
      border-radius: 12px; padding: 1.5rem;
    }
    .ag-bolt-card .ag-bolt-ico {
      width: 40px; height: 40px; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      background: radial-gradient(120% 120% at 30% 20%, color-mix(in srgb, var(--folio-gold) 14%, transparent), color-mix(in srgb, var(--brand-surface-dark) 90%, transparent));
      border: 1px solid color-mix(in srgb, var(--folio-gold) 45%, transparent);
      margin-bottom: 0.8rem;
    }
    .ag-bolt-card .ag-bolt-ico svg { width: 18px; height: 18px; color: var(--folio-gold); }
    .ag-bolt-card h3 { font-size: 0.95rem; font-weight: 600; color: var(--brand-paper); margin: 0 0 0.4rem; }
    .ag-bolt-card p { font-size: 0.9rem; line-height: 1.65; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); margin: 0; }
    .ag-bolt-foot { margin-top: 1.5rem; padding-top: 1.25rem; border-top: 1px solid color-mix(in srgb, var(--brand-paper) 8%, transparent); }
    .ag-bolt-foot p { font-size: 0.9rem; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); margin: 0; }
    .ag-bolt-foot strong { color: color-mix(in srgb, var(--brand-paper) 85%, transparent); }
    .ag-link { color: var(--folio-gold); text-decoration: underline; text-underline-offset: 3px; }
    .ag-link:hover { color: var(--folio-gold-bright); }

    /* --- Add-ons --- */
    .ag-addons { display: grid; grid-template-columns: repeat(3, 1fr); gap: 0.75rem; }
    @media (max-width: 900px) { .ag-addons { grid-template-columns: repeat(2, 1fr); } }
    @media (max-width: 560px) { .ag-addons { grid-template-columns: 1fr; } }
    .ag-addon {
      display: block; padding: 1.25rem; text-decoration: none;
      background: linear-gradient(180deg, color-mix(in srgb, var(--brand-surface-dark) 82%, transparent), var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 9%, transparent);
      border-radius: 14px; transition: border-color 0.2s;
    }
    .ag-addon:hover { border-color: color-mix(in srgb, var(--folio-gold) 45%, transparent); }
    .ag-addon-top { display: flex; align-items: center; gap: 0.7rem; margin-bottom: 0.5rem; }
    .ag-addon .folio-medallion { width: 38px; height: 38px; font-size: 1rem; margin: 0; flex-shrink: 0; }
    .ag-addon h3 { font-family: var(--folio-serif); font-weight: 600; font-size: 1.02rem; color: var(--brand-paper); margin: 0; }
    .ag-addon p { font-size: 0.8rem; line-height: 1.55; color: color-mix(in srgb, var(--brand-paper) 62%, transparent); margin: 0; }

    /* --- CTA band --- */
    .ag-cta {
      position: relative; overflow: hidden; text-align: center;
      background:
        radial-gradient(120% 130% at 12% 0%, color-mix(in srgb, var(--folio-gold) 7%, transparent), transparent 55%),
        linear-gradient(165deg, color-mix(in srgb, var(--brand-surface-dark) 88%, transparent), var(--brand-night));
      border: 1px solid color-mix(in srgb, var(--brand-paper) 8%, transparent);
      border-radius: 20px; padding: 3rem 2rem;
    }
    .ag-cta::before {
      content: ''; position: absolute; top: 0; left: 0; right: 0; height: 3px;
      background: linear-gradient(90deg, var(--folio-gold), var(--brand-accent, #e8506b), color-mix(in srgb, var(--brand-accent) 0%, transparent));
    }
    .ag-cta .ag-cta-row { justify-content: center; }

    /* --- Form --- */
    .ag-form { max-width: 36rem; margin: 0 auto; }
    .ag-form-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
    @media (max-width: 640px) { .ag-form-grid { grid-template-columns: 1fr; } }
    .ag-field { margin-bottom: 1rem; }
    .ag-form-grid .ag-field { margin-bottom: 0; }
    .ag-form-rows { display: flex; flex-direction: column; gap: 1rem; }
    .ag-label { display: block; font-size: 0.875rem; font-weight: 500; color: color-mix(in srgb, var(--brand-paper) 78%, transparent); margin-bottom: 0.35rem; }
    .ag-form select.ag-input, .ag-form textarea.ag-input { appearance: auto; }
    .ag-form textarea.ag-input { resize: vertical; }
    .ag-form .ag-btn { width: 100%; box-sizing: border-box; font-size: 1rem; }
    .ag-form-note { font-size: 0.8rem; color: color-mix(in srgb, var(--brand-paper) 55%, transparent); text-align: center; margin: 0.6rem 0 0; }
    .ag-success { text-align: center; padding: 2rem 0; }
    .ag-success .ag-success-mark { font-size: 2.5rem; margin-bottom: 0.75rem; }
    .ag-success h3 { font-family: var(--folio-serif); font-weight: 600; font-size: 1.3rem; color: var(--brand-paper); margin: 0 0 0.5rem; }
    .ag-success p { font-size: 0.9rem; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); margin: 0; }

    /* --- FAQ --- */
    .ag-faq-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 1.5rem 2.5rem; }
    @media (max-width: 768px) { .ag-faq-grid { grid-template-columns: 1fr; } }
    .ag-faq h3 { font-size: 0.92rem; font-weight: 600; color: var(--brand-paper); margin: 0 0 0.45rem; }
    .ag-faq p { font-size: 0.9rem; line-height: 1.65; color: color-mix(in srgb, var(--brand-paper) 66%, transparent); margin: 0; }
  </style>

  <!-- Masthead -->
  <section class="ag-masthead">
    <div class="ag-masthead-inner">
      <div>
        <div class="ag-badge">
          <span class="ag-badge-dot"></span>
          Built with AI — Delivered in 48 hours
        </div>
        <h1 class="ag-h1">
          Your Website,<br>
          <span class="ag-gilt">Your Way</span>
        </h1>
        <p class="ag-lede">
          One place to buy your domain, build your site, and manage everything.
          No tech skills needed. No multiple vendors. No hidden fees.
        </p>
        <div class="ag-cta-row">
          <a href="#pricing" class="ag-btn">See Plans</a>
          <a href="#domain" class="ag-btn ag-btn-ghost">Buy a Domain</a>
        </div>
        <hr class="folio-rule">
      </div>
      <figure style="margin: 0;">
        <div class="ag-hero-media">
          <img src="/images/agency-feature.jpg" alt="A laptop on a craftsman's workbench at night, its screen showing a glowing gold-and-rose website wireframe, with paper wireframe sketches and a brass lamp beside it. AI-generated." loading="eager">
        </div>
        <figcaption class="ag-hero-caption">Every site starts as a sketch on the workbench.</figcaption>
      </figure>
    </div>
  </section>

  <section class="ag-wrap" style="padding-top: 3.5rem;">
    <!-- Stats -->
    <div class="ag-stats">
      <div class="ag-stat">
        <div class="ag-stat-num">48<span class="ag-stat-unit">hr</span></div>
        <div class="ag-stat-label">Average build time</div>
      </div>
      <div class="ag-stat">
        <div class="ag-stat-num">12+</div>
        <div class="ag-stat-label">Sites hosted</div>
      </div>
      <div class="ag-stat">
        <div class="ag-stat-num">9</div>
        <div class="ag-stat-label">Active clients</div>
      </div>
      <div class="ag-stat">
