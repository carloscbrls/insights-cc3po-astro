---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Websites, Domains & Automation">
  <style>
    .agency-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #10b981;
      position: relative;
      flex-shrink: 0;
    }
    .agency-badge-dot::after {
      content: '';
      position: absolute;
      top: -3px; left: -3px;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: rgba(16, 185, 129, 0.25);
      animation: pulseRing 2s ease-out infinite;
    }
    @keyframes pulseRing {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    .agency-step-connector {
      position: absolute;
      top: 50%;
      right: -12px;
      z-index: 2;
      width: 24px;
      height: 2px;
      background: linear-gradient(90deg, #10b981, transparent);
    }
    .agency-step:last-child .agency-step-connector { display: none; }
    @media (max-width: 768px) {
      .agency-step-connector { display: none !important; }
    }
  </style>

  <!-- Hero -->
  <section class="relative min-h-[80vh] flex items-center justify-center text-center px-4 sm:px-6 pt-24 pb-16 overflow-hidden bg-[#0a0a12]">
    <div class="absolute inset-0" style="background: radial-gradient(ellipse at 50% 0%, rgba(16,185,129,0.08) 0%, transparent 60%), radial-gradient(ellipse at 80% 100%, rgba(16,185,129,0.04) 0%, transparent 50%);"></div>
    <div class="relative z-10 max-w-3xl">
      <div class="inline-flex items-center gap-2 px-4 py-1.5 bg-emerald-500/10 border border-emerald-500/25 rounded-full text-xs font-bold text-emerald-400 tracking-wide mb-6">
        <span class="agency-badge-dot"></span>
        Built with AI — Delivered in 48 hours
      </div>
      <h1 class="text-4xl sm:text-5xl md:text-7xl font-extrabold leading-[1.1] tracking-tighter text-white mb-5">
        Your Website,<br>
        <span class="bg-gradient-to-r from-white via-emerald-400 to-emerald-300 bg-clip-text text-transparent">Your Way</span>
      </h1>
      <p class="text-base sm:text-lg text-white/80 leading-relaxed max-w-xl mx-auto mb-8">
        One place to buy your domain, build your site, and manage everything.
        No tech skills needed. No multiple vendors. No hidden fees.
      </p>
      <div class="flex flex-wrap justify-center gap-3">
        <a href="#pricing" class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-semibold rounded-lg transition-all duration-200 hover:-translate-y-0.5 hover:scale-[1.02] shadow-lg shadow-emerald-500/25">See Plans</a>
        <a href="#domain" class="inline-flex items-center gap-2 px-8 py-3 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-lg font-semibold transition-all duration-200">Buy a Domain</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-16">
    <!-- Stats -->
    <div class="grid grid-cols-2 md:grid-cols-4 gap-4 max-w-2xl mx-auto mb-20">
      <div class="text-center p-6 bg-[#0f0f1a] border border-gray-800 rounded-xl hover:border-emerald-500/25 transition-colors duration-300">
        <div class="text-2xl sm:text-4xl font-extrabold text-emerald-400 leading-none mb-1">48<span class="text-base">hr</span></div>
        <div class="text-xs sm:text-sm text-gray-500">Average build time</div>
      </div>
      <div class="text-center p-6 bg-[#0f0f1a] border border-gray-800 rounded-xl hover:border-emerald-500/25 transition-colors duration-300">
        <div class="text-2xl sm:text-4xl font-extrabold text-emerald-400 leading-none mb-1">12+</div>
        <div class="text-xs sm:text-sm text-gray-500">Sites hosted</div>
      </div>
      <div class="text-center p-6 bg-[#0f0f1a] border border-gray-800 rounded-xl hover:border-emerald-500/25 transition-colors duration-300">
        <div class="text-2xl sm:text-4xl font-extrabold text-emerald-400 leading-none mb-1">9</div>
        <div class="text-xs sm:text-sm text-gray-500">Active clients</div>
      </div>
      <div class="text-center p-6 bg-[#0f0f1a] border border-gray-800 rounded-xl hover:border-emerald-500/25 transition-colors duration-300">
        <div class="text-2xl sm:text-4xl font-extrabold text-emerald-400 leading-none mb-1">100<span class="text-base">%</span></div>
        <div class="text-xs sm:text-sm text-gray-500">White-label delivery</div>
      </div>
    </div>

    <!-- How It Works -->
    <div class="mb-20">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white text-center mb-2 tracking-tight">How It Works</h2>
      <p class="text-gray-500 text-center max-w-lg mx-auto mb-12 text-sm sm:text-base">Four simple steps from idea to live website.</p>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
        <div class="relative p-8 bg-[#0f0f1a] border border-gray-800 text-center hover:border-emerald-500/25 transition-colors duration-300 [&:not(:last-child)]:border-r-0 lg:[&:not(:last-child)]:border-r-0">
          <div class="agency-step-connector"></div>
          <div class="w-10 h-10 mx-auto mb-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-[18px] h-[18px] text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
          <div class="text-[11px] font-extrabold tracking-widest text-emerald-400 mb-2 font-mono">STEP 1</div>
          <h3 class="text-sm font-bold text-white mb-1.5">Buy Your Domain</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Search and register your domain through our link. Or bring your own.</p>
        </div>
        <div class="relative p-8 bg-[#0f0f1a] border border-gray-800 text-center hover:border-emerald-500/25 transition-colors duration-300">
          <div class="agency-step-connector"></div>
          <div class="w-10 h-10 mx-auto mb-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-[18px] h-[18px] text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <div class="text-[11px] font-extrabold tracking-widest text-emerald-400 mb-2 font-mono">STEP 2</div>
          <h3 class="text-sm font-bold text-white mb-1.5">Choose Your Path</h3>
          <p class="text-xs text-gray-500 leading-relaxed">We build it for you, or use Bolt.new to build it yourself with AI.</p>
        </div>
        <div class="relative p-8 bg-[#0f0f1a] border border-gray-800 text-center hover:border-emerald-500/25 transition-colors duration-300">
          <div class="agency-step-connector"></div>
          <div class="w-10 h-10 mx-auto mb-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-[18px] h-[18px] text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          <div class="text-[11px] font-extrabold tracking-widest text-emerald-400 mb-2 font-mono">STEP 3</div>
          <h3 class="text-sm font-bold text-white mb-1.5">Get Your Portal</h3>
          <p class="text-xs text-gray-500 leading-relaxed">White-label dashboard to manage your site, email, and billing.</p>
        </div>
        <div class="relative p-8 bg-[#0f0f1a] border border-gray-800 text-center hover:border-emerald-500/25 transition-colors duration-300">
          <div class="w-10 h-10 mx-auto mb-2 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center">
            <svg class="w-[18px] h-[18px] text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div class="text-[11px] font-extrabold tracking-widest text-emerald-400 mb-2 font-mono">STEP 4</div>
          <h3 class="text-sm font-bold text-white mb-1.5">Go Live</h3>
          <p class="text-xs text-gray-500 leading-relaxed">Site deployed on SiteGround with SSL, CDN, backups, and monitoring.</p>
        </div>
      </div>
    </div>

    <!-- Domain Search -->
    <div id="domain" class="bg-gradient-to-br from-white/[0.04] to-[#0a0a12]/50 border border-gray-800 rounded-xl p-8 sm:p-10 mb-20">
      <div class="flex flex-wrap items-start justify-between gap-4 mb-6">
        <div>
          <h2 class="text-2xl sm:text-3xl font-extrabold text-white text-left mb-1.5 tracking-tight">Step 1: Get Your Domain</h2>
          <p class="text-gray-500 text-sm sm:text-base">Search for available domains. We use SiteGround for registration — you get a great price, we get a small commission.</p>
        </div>
        <div class="bg-emerald-500/10 border border-emerald-500/20 rounded-lg px-4 py-2 text-center flex-shrink-0">
          <p class="text-xs text-gray-500 m-0">Domains starting at</p>
          <p class="text-2xl font-bold text-emerald-400 m-0">$10<span class="text-sm text-gray-500 font-normal">/yr</span></p>
        </div>
      </div>
      <div class="flex gap-3 mb-5 flex-wrap">
        <div class="flex-1 relative min-w-[200px]">
          <svg class="absolute left-3 top-1/2 -translate-y-1/2 w-[18px] h-[18px] text-gray-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="yourbusiness.com" class="w-full bg-[#1a1a2e]/80 border border-white/10 rounded-lg py-3 pl-10 pr-4 text-white text-sm focus:outline-none focus:border-emerald-500 focus:ring-3 focus:ring-emerald-500/10 placeholder:text-gray-500 transition-colors" />
        </div>
        <a href="https://www.siteground.com/go/a3sob40itj" target="_blank" class="inline-flex items-center gap-2 px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-semibold rounded-lg transition-all duration-200 whitespace-nowrap shadow-lg shadow-emerald-500/25">Search on SiteGround →</a>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-3 text-sm">
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">$10-15/year</strong> for .com through SiteGround. No markup.</span>
        </div>
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">Already have a domain?</strong> We'll point it to your new site.</span>
        </div>
        <div class="flex items-start gap-2 text-gray-500">
          <svg class="w-4 h-4 text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong class="text-gray-400">Buy through our link</strong> and we earn a commission that keeps prices low.</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Choose Your Path -->
    <div class="mb-20">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white text-center mb-2 tracking-tight">Step 2: Choose Your Path</h2>
      <p class="text-gray-500 text-center max-w-lg mx-auto mb-12 text-sm sm:text-base">Two ways to get your site built. Pick the one that fits you best.</p>
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-5">
        <!-- We Build -->
        <div class="relative bg-gradient-to-br from-emerald-500/10 to-emerald-500/5 border-2 border-emerald-500/30 rounded-xl p-8 hover:border-emerald-500/50 transition-all duration-300 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/10">
          <div class="absolute -top-3 left-6 bg-emerald-500 text-white text-[11px] font-bold px-3.5 py-1 rounded-full">MOST POPULAR</div>
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-emerald-500/15 border border-emerald-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.066 2.573c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.573 1.066c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.066-2.573c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white m-0">We Build It For You</h3>
              <p class="text-xs text-gray-500 m-0">Sit back, we handle everything</p>
            </div>
          </div>
          <p class="text-sm text-gray-500 leading-relaxed mb-5">Tell us what you need. We use AI to build your site fast. You review, we refine, you go live.</p>
          <ul class="mb-6 space-y-2">
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Built in <strong class="text-white">24-48 hours</strong></span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>You review and request changes</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>We handle domain setup, SSL, everything</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Ongoing support and edits</span>
            </li>
          </ul>
          <a href="#pricing" class="block text-center w-full inline-flex items-center justify-center gap-2 px-8 py-3 bg-emerald-500 hover:bg-emerald-400 text-black font-semibold rounded-lg transition-all duration-200 shadow-lg shadow-emerald-500/25">See Plans →</a>
        </div>
        <!-- Build Yourself -->
        <div class="bg-[#0f0f1a] border border-gray-800 rounded-xl p-8 hover:border-emerald-500/30 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/10 transition-all duration-300">
          <div class="flex items-center gap-3 mb-4">
            <div class="w-10 h-10 bg-emerald-500/10 border border-emerald-500/20 rounded-xl flex items-center justify-center flex-shrink-0">
              <svg class="w-5 h-5 text-emerald-400" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/></svg>
            </div>
            <div>
              <h3 class="text-xl font-bold text-white m-0">Build It Yourself</h3>
              <p class="text-xs text-gray-500 m-0">Powered by Bolt.new AI</p>
            </div>
          </div>
          <p class="text-sm text-gray-500 leading-relaxed mb-5">Use Bolt.new — the AI-powered web builder — to create your own site. Describe what you want, and AI builds it. We host it on SiteGround.</p>
          <ul class="mb-6 space-y-2">
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Describe your site in <strong class="text-white">plain English</strong></span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Bolt.new builds it with AI in <strong class="text-white">minutes</strong></span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>Export and deploy to your SiteGround hosting</span>
            </li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500">
              <svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
              <span>We handle the <strong class="text-white">technical setup</strong></span>
            </li>
          </ul>
          <a href="https://bolt.new" target="_blank" class="block text-center w-full inline-flex items-center justify-center gap-2 px-8 py-3 bg-white/5 hover:bg-white/10 text-white border border-white/10 rounded-lg font-semibold transition-all duration-200">Try Bolt.new →</a>
        </div>
      </div>
    </div>

    <!-- Pricing -->
    <div id="pricing" class="mb-20">
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-white text-center mb-2 tracking-tight">Step 3: Pick a Plan</h2>
      <p class="text-gray-500 text-center max-w-xl mx-auto mb-12 text-sm sm:text-base">All plans include hosting on SiteGround, free SSL, CDN, daily backups, and your own white-label client portal.</p>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <!-- Spark -->
        <div class="flex flex-col p-8 bg-[#0f0f1a] border border-gray-800 rounded-xl hover:border-emerald-500/30 hover:-translate-y-1 hover:shadow-lg hover:shadow-emerald-500/10 transition-all duration-300">
          <h3 class="text-xl font-bold text-white mb-1">Spark</h3>
          <p class="text-xs text-gray-500 mb-4">Perfect for getting started</p>
          <div class="text-4xl font-extrabold text-white mb-0.5">$97<span class="text-sm text-gray-500 font-normal">/mo</span></div>
          <p class="text-xs text-gray-500 mb-6">Domain not included (~$10-15/yr)</p>
          <ul class="flex-1 mb-6 space-y-2">
            <li class="flex items-start gap-2.5 text-sm text-gray-500"><svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>1-page professional website</li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500"><svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Free SSL &amp; CDN</li>
            <li class="flex items-start gap-2.5 text-sm text-gray-500"><svg class="w-[18px] h-[18px] text-emerald-400 flex-shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>Daily backups</li>
