---
import Layout from '../layouts/Layout.astro';
---

<Layout title="CC3PO Agency — Websites, Domains & Automation">
  <style>
    .agency-hero {
      position: relative;
      min-height: 80vh;
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
      padding: 96px 24px 64px;
      background: var(--bg-primary, #0a0a12);
      overflow: hidden;
    }
    .agency-hero::before {
      content: '';
      position: absolute;
      inset: 0;
      background: radial-gradient(ellipse at 50% 0%, rgba(232, 80, 107, 0.08) 0%, transparent 60%),
                  radial-gradient(ellipse at 80% 100%, rgba(79, 195, 247, 0.05) 0%, transparent 50%);
      z-index: 0;
    }
    .agency-hero-content {
      position: relative;
      z-index: 1;
      max-width: 800px;
    }
    .agency-badge {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 6px 16px;
      background: rgba(232, 80, 107, 0.1);
      border: 1px solid rgba(232, 80, 107, 0.25);
      border-radius: 100px;
      font-size: 12px;
      font-weight: 700;
      color: var(--accent, #e8506b);
      letter-spacing: 0.5px;
      margin-bottom: 24px;
    }
    .agency-badge-dot {
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background: #00e676;
      position: relative;
      flex-shrink: 0;
    }
    .agency-badge-dot::after {
      content: '';
      position: absolute;
      top: -3px; left: -3px;
      width: 14px; height: 14px;
      border-radius: 50%;
      background: rgba(0, 230, 118, 0.25);
      animation: pulseRing 2s ease-out infinite;
    }
    @keyframes pulseRing {
      0% { transform: scale(0.8); opacity: 1; }
      100% { transform: scale(2.2); opacity: 0; }
    }
    .agency-title {
      font-size: clamp(2.5rem, 6vw, 4.5rem);
      font-weight: 800;
      line-height: 1.1;
      letter-spacing: -2px;
      margin-bottom: 20px;
      color: #fff;
    }
    .agency-title-gradient {
      background: linear-gradient(135deg, #ffffff 0%, var(--accent, #e8506b) 40%, #4fc3f7 100%);
      -webkit-background-clip: text;
      -webkit-text-fill-color: transparent;
      background-clip: text;
    }
    .agency-sub {
      font-size: clamp(1rem, 1.8vw, 1.125rem);
      color: rgba(255, 255, 255, 0.78);
      line-height: 1.7;
      max-width: 640px;
      margin: 0 auto 32px;
    }
    .agency-cta-row {
      display: flex;
      gap: 12px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .agency-btn-primary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: var(--accent-dark, #b82d45);
      color: #fff;
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      min-height: 44px;
      transition: transform 0.2s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.2s;
      box-shadow: 0 4px 20px rgba(232, 80, 107, 0.3);
    }
    .agency-btn-primary:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 6px 30px rgba(232, 80, 107, 0.45);
      color: #fff;
      background: var(--accent, #e8506b);
    }
    .agency-btn-secondary {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      padding: 12px 28px;
      background: rgba(255, 255, 255, 0.06);
      color: #fff;
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      font-size: 15px;
      font-weight: 600;
      min-height: 44px;
      transition: all 0.2s;
    }
    .agency-btn-secondary:hover {
      background: rgba(255, 255, 255, 0.12);
      border-color: rgba(232, 80, 107, 0.4);
      color: #fff;
    }
    .agency-stats {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 16px;
      max-width: 800px;
      margin: 0 auto 80px;
    }
    .agency-stat {
      text-align: center;
      padding: 24px 16px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      transition: border-color 0.3s;
    }
    .agency-stat:hover {
      border-color: rgba(232, 80, 107, 0.25);
    }
    .agency-stat-num {
      font-size: clamp(1.5rem, 3vw, 2.5rem);
      font-weight: 800;
      color: var(--accent, #e8506b);
      line-height: 1;
      margin-bottom: 4px;
    }
    .agency-stat-label {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.6);
    }
    .agency-section-title {
      font-size: clamp(1.5rem, 3vw, 2.25rem);
      font-weight: 800;
      color: #fff;
      text-align: center;
      margin-bottom: 8px;
      letter-spacing: -1px;
    }
    .agency-section-desc {
      color: rgba(255, 255, 255, 0.6);
      text-align: center;
      max-width: 560px;
      margin: 0 auto 48px;
      font-size: 15px;
      line-height: 1.6;
    }
    .agency-card {
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 32px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s, box-shadow 0.3s;
    }
    .agency-card:hover {
      transform: translateY(-4px);
      border-color: rgba(232, 80, 107, 0.3);
      box-shadow: 0 8px 32px rgba(232, 80, 107, 0.08);
    }
    .agency-card-highlight {
      background: linear-gradient(135deg, rgba(232, 80, 107, 0.08), rgba(15, 52, 96, 0.08));
      border: 2px solid rgba(232, 80, 107, 0.3);
      position: relative;
    }
    .agency-card-highlight:hover {
      border-color: rgba(232, 80, 107, 0.5);
    }
    .agency-popular-badge {
      position: absolute;
      top: -12px;
      left: 24px;
      background: var(--accent, #e8506b);
      color: #fff;
      font-size: 11px;
      font-weight: 700;
      padding: 4px 14px;
      border-radius: 100px;
    }
    .agency-step-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);
      gap: 0;
      position: relative;
    }
    .agency-step {
      padding: 32px 24px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      text-align: center;
      position: relative;
    }
    .agency-step:not(:last-child) {
      border-right: none;
    }
    .agency-step:hover {
      border-color: rgba(232, 80, 107, 0.25);
    }
    .agency-step-connector {
      position: absolute;
      top: 50%;
      right: -12px;
      z-index: 2;
      width: 24px;
      height: 2px;
      background: linear-gradient(90deg, var(--accent, #e8506b), transparent);
    }
    .agency-step:last-child .agency-step-connector { display: none; }
    .agency-step-icon {
      width: 40px;
      height: 40px;
      background: linear-gradient(135deg, rgba(232, 80, 107, 0.15), rgba(232, 80, 107, 0.05));
      border: 1px solid rgba(232, 80, 107, 0.2);
      border-radius: 10px;
      display: flex;
      align-items: center;
      justify-content: center;
      margin: 0 auto 8px;
    }
    .agency-step-icon svg {
      width: 18px;
      height: 18px;
      color: var(--accent, #e8506b);
    }
    .agency-step-num {
      font-size: 11px;
      font-weight: 800;
      letter-spacing: 2px;
      color: var(--accent, #e8506b);
      margin-bottom: 8px;
      font-family: 'JetBrains Mono', monospace;
    }
    .agency-step h3 {
      font-size: 15px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 6px;
    }
    .agency-step p {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.5;
    }
    .agency-pricing-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 16px;
    }
    .agency-price-card {
      display: flex;
      flex-direction: column;
      padding: 32px 24px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      transition: transform 0.3s cubic-bezier(0.34, 1.56, 0.64, 1), border-color 0.3s, box-shadow 0.3s;
    }
    .agency-price-card:hover {
      transform: translateY(-4px);
      border-color: rgba(232, 80, 107, 0.3);
      box-shadow: 0 8px 32px rgba(232, 80, 107, 0.08);
    }
    .agency-price-card-highlight {
      background: linear-gradient(135deg, rgba(232, 80, 107, 0.08), rgba(15, 52, 96, 0.08));
      border: 2px solid rgba(232, 80, 107, 0.3);
      position: relative;
    }
    .agency-price-card-highlight:hover {
      border-color: rgba(232, 80, 107, 0.5);
    }
    .agency-price-name {
      font-size: 20px;
      font-weight: 700;
      color: #fff;
      margin-bottom: 4px;
    }
    .agency-price-desc {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.5);
      margin-bottom: 16px;
    }
    .agency-price-amount {
      font-size: 2.25rem;
      font-weight: 800;
      color: #fff;
      margin-bottom: 2px;
    }
    .agency-price-amount span {
      font-size: 0.875rem;
      color: rgba(255, 255, 255, 0.4);
      font-weight: 400;
    }
    .agency-price-note {
      font-size: 12px;
      color: rgba(255, 255, 255, 0.35);
      margin-bottom: 24px;
    }
    .agency-price-features {
      flex: 1;
      margin-bottom: 24px;
    }
    .agency-price-features li {
      display: flex;
      align-items: flex-start;
      gap: 10px;
      font-size: 14px;
      color: rgba(255, 255, 255, 0.6);
      padding: 6px 0;
    }
    .agency-price-features li svg {
      width: 18px;
      height: 18px;
      color: var(--accent, #e8506b);
      flex-shrink: 0;
      margin-top: 1px;
    }
    .agency-addon-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 12px;
    }
    .agency-addon-card {
      padding: 20px;
      background: rgba(255, 255, 255, 0.04);
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 12px;
      transition: all 0.2s;
      text-decoration: none;
      display: block;
    }
    .agency-addon-card:hover {
      border-color: rgba(232, 80, 107, 0.4);
      transform: translateY(-2px);
    }
    .agency-addon-card h3 {
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 4px;
      transition: color 0.2s;
    }
    .agency-addon-card:hover h3 {
      color: var(--accent, #e8506b);
    }
    .agency-addon-card p {
      font-size: 13px;
      color: rgba(255, 255, 255, 0.5);
    }
    .agency-faq-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);
      gap: 24px;
    }
    .agency-faq-item h3 {
      font-size: 15px;
      font-weight: 600;
      color: #fff;
      margin-bottom: 6px;
    }
    .agency-faq-item p {
      font-size: 14px;
      color: rgba(255, 255, 255, 0.6);
      line-height: 1.6;
    }
    .agency-faq-item a {
      color: var(--accent, #e8506b);
      text-decoration: underline;
      text-underline-offset: 2px;
    }
    .agency-faq-item a:hover {
      color: #f0617a;
    }
    .agency-cta-section {
      background: linear-gradient(135deg, rgba(232, 80, 107, 0.08), rgba(15, 52, 96, 0.08));
      border: 1px solid rgba(232, 80, 107, 0.2);
      border-radius: 16px;
      padding: 48px;
      text-align: center;
    }
    .agency-domain-card {
      background: linear-gradient(135deg, rgba(255, 255, 255, 0.04), rgba(10, 10, 18, 0.5));
      border: 1px solid rgba(255, 255, 255, 0.06);
      border-radius: 16px;
      padding: 40px;
    }
    .agency-domain-input {
      width: 100%;
      background: rgba(26, 26, 46, 0.8);
      border: 1px solid rgba(255, 255, 255, 0.1);
      border-radius: 8px;
      padding: 12px 16px 12px 40px;
      color: #fff;
      font-size: 15px;
      transition: border-color 0.2s;
    }
    .agency-domain-input:focus {
      outline: none;
      border-color: var(--accent, #e8506b);
      box-shadow: 0 0 0 3px rgba(232, 80, 107, 0.1);
    }
    .agency-domain-input::placeholder {
      color: rgba(255, 255, 255, 0.3);
    }
    @media (max-width: 768px) {
      .agency-stats { grid-template-columns: repeat(2, 1fr); }
      .agency-step-grid { grid-template-columns: 1fr; }
      .agency-step:not(:last-child) { border-right: 1px solid rgba(255, 255, 255, 0.06); border-bottom: none; }
      .agency-step-connector { display: none !important; }
      .agency-pricing-grid { grid-template-columns: 1fr; }
      .agency-addon-grid { grid-template-columns: 1fr; }
      .agency-faq-grid { grid-template-columns: 1fr; }
      .agency-cta-section { padding: 32px 24px; }
      .agency-domain-card { padding: 24px; }
    }
    @media (max-width: 480px) {
      .agency-stats { grid-template-columns: repeat(2, 1fr); gap: 8px; }
      .agency-stat { padding: 16px 12px; }
    }
  </style>

  <!-- Hero -->
  <section class="agency-hero">
    <div class="agency-hero-content">
      <div class="agency-badge">
        <span class="agency-badge-dot"></span>
        Built with AI — Delivered in 48 hours
      </div>
      <h1 class="agency-title">
        Your Website,<br>
        <span class="agency-title-gradient">Your Way</span>
      </h1>
      <p class="agency-sub">
        One place to buy your domain, build your site, and manage everything.
        No tech skills needed. No multiple vendors. No hidden fees.
      </p>
      <div class="agency-cta-row">
        <a href="#pricing" class="agency-btn-primary">See Plans</a>
        <a href="#domain" class="agency-btn-secondary">Buy a Domain</a>
      </div>
    </div>
  </section>

  <section class="max-w-6xl mx-auto px-4 pb-16">
    <!-- Stats -->
    <div class="agency-stats">
      <div class="agency-stat">
        <div class="agency-stat-num">48<span style="font-size:1rem;">hr</span></div>
        <div class="agency-stat-label">Average build time</div>
      </div>
      <div class="agency-stat">
        <div class="agency-stat-num">12+</div>
        <div class="agency-stat-label">Sites hosted</div>
      </div>
      <div class="agency-stat">
        <div class="agency-stat-num">9</div>
        <div class="agency-stat-label">Active clients</div>
      </div>
      <div class="agency-stat">
        <div class="agency-stat-num">100<span style="font-size:1rem;">%</span></div>
        <div class="agency-stat-label">White-label delivery</div>
      </div>
    </div>

    <!-- How It Works -->
    <div style="margin-bottom: 80px;">
      <h2 class="agency-section-title">How It Works</h2>
      <p class="agency-section-desc">Four simple steps from idea to live website.</p>
      <div class="agency-step-grid">
        <div class="agency-step">
          <div class="agency-step-connector"></div>
          <div class="agency-step-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M21 12a9 9 0 01-9 9m9-9a9 9 0 00-9-9m9 9H3m9 9a9 9 0 01-9-9m9 9c1.657 0 3-4.03 3-9s-1.343-9-3-9m0 18c-1.657 0-3-4.03-3-9s1.343-9 3-9m-9 9a9 9 0 019-9"/></svg>
          </div>
          <div class="agency-step-num">STEP 1</div>
          <h3>Buy Your Domain</h3>
          <p>Search and register your domain through our link. Or bring your own.</p>
        </div>
        <div class="agency-step">
          <div class="agency-step-connector"></div>
          <div class="agency-step-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.663 17h4.673M12 3v1m6.364 1.636l-.707.707M21 12h-1M4 12H3m3.343-5.657l-.707-.707m2.828 9.9a5 5 0 117.072 0l-.548.547A3.374 3.374 0 0014 18.469V19a2 2 0 11-4 0v-.531c0-.895-.356-1.754-.988-2.386l-.548-.547z"/></svg>
          </div>
          <div class="agency-step-num">STEP 2</div>
          <h3>Choose Your Path</h3>
          <p>We build it for you, or use Bolt.new to build it yourself with AI.</p>
        </div>
        <div class="agency-step">
          <div class="agency-step-connector"></div>
          <div class="agency-step-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M11 3.055A9.001 9.001 0 1020.945 13H11V3.055z"/><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20.488 9H15V3.512A9.025 9.025 0 0120.488 9z"/></svg>
          </div>
          <div class="agency-step-num">STEP 3</div>
          <h3>Get Your Portal</h3>
          <p>White-label dashboard to manage your site, email, and billing.</p>
        </div>
        <div class="agency-step">
          <div class="agency-step-icon">
            <svg fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M5 13l4 4L19 7"/></svg>
          </div>
          <div class="agency-step-num">STEP 4</div>
          <h3>Go Live</h3>
          <p>Site deployed on SiteGround with SSL, CDN, backups, and monitoring.</p>
        </div>
      </div>
    </div>

    <!-- Domain Search -->
    <div id="domain" class="agency-domain-card" style="margin-bottom: 80px;">
      <div style="display: flex; flex-wrap: wrap; align-items: flex-start; justify-content: space-between; gap: 16px; margin-bottom: 24px;">
        <div>
          <h2 class="agency-section-title" style="text-align: left; margin-bottom: 6px;">Step 1: Get Your Domain</h2>
          <p style="color: rgba(255,255,255,0.6); font-size: 15px;">Search for available domains. We use SiteGround for registration — you get a great price, we get a small commission.</p>
        </div>
        <div style="background: rgba(232,80,107,0.1); border: 1px solid rgba(232,80,107,0.2); border-radius: 8px; padding: 8px 16px; text-align: center; flex-shrink: 0;">
          <p style="font-size: 12px; color: rgba(255,255,255,0.5); margin: 0;">Domains starting at</p>
          <p style="font-size: 1.5rem; font-weight: 700; color: var(--accent, #e8506b); margin: 0;">$10<span style="font-size: 0.8rem; color: rgba(255,255,255,0.4);">/yr</span></p>
        </div>
      </div>
      <div style="display: flex; gap: 12px; margin-bottom: 20px; flex-wrap: wrap;">
        <div style="flex: 1; position: relative; min-width: 200px;">
          <svg style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); width: 18px; height: 18px; color: rgba(255,255,255,0.3);" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"/></svg>
          <input type="text" placeholder="yourbusiness.com" class="agency-domain-input" />
        </div>
        <a href="https://www.siteground.com/go/a3sob40itj" target="_blank" class="agency-btn-primary" style="white-space: nowrap;">Search on SiteGround →</a>
      </div>
      <div style="display: grid; grid-template-columns: repeat(3, 1fr); gap: 12px; font-size: 14px;">
        <div style="display: flex; align-items: flex-start; gap: 8px; color: rgba(255,255,255,0.5);">
          <svg style="width: 16px; height: 16px; color: var(--accent, #e8506b); flex-shrink: 0; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong style="color: rgba(255,255,255,0.7);">$10-15/year</strong> for .com through SiteGround. No markup.</span>
        </div>
        <div style="display: flex; align-items: flex-start; gap: 8px; color: rgba(255,255,255,0.5);">
          <svg style="width: 16px; height: 16px; color: var(--accent, #e8506b); flex-shrink: 0; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong style="color: rgba(255,255,255,0.7);">Already have a domain?</strong> We'll point it to your new site.</span>
        </div>
        <div style="display: flex; align-items: flex-start; gap: 8px; color: rgba(255,255,255,0.5);">
          <svg style="width: 16px; height: 16px; color: var(--accent, #e8506b); flex-shrink: 0; margin-top: 2px;" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"/></svg>
          <span><strong style="color: rgba(255,255,255,0.7);">Buy through our link</strong> and we earn a commission that keeps prices low.</span>
        </div>
      </div>
    </div>

    <!-- Step 2: Choose Your Path -->
    <div style="margin-bottom: 80px;">
      <h2 class="agency-section-title">Step 2: Choose Your Path</h2>
      <p class="agency-section-desc">Two ways to get your site built. Pick the one that fits you best.</p>
      <div style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px;">
        <!-- We Build -->
        <div class="agency-card-highlight" style="padding: 32px;">
          <div class="agency-popular-badge">MOST POPULAR</div>
