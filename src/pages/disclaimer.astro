---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = "Disclaimer | CC3PO Insights";
const description = "Disclaimer for CC3PO Insights blog and content.";
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} />
  <style>
    .legal-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 100px 24px 60px;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #d4d4d8;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      padding: 10px 20px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      margin-bottom: 24px;
      transition: all 0.2s;
    }
    .back-link:hover { background: rgba(107,53,255,.1); border-color: rgba(107,53,255,.3); color: #fff; }
    .legal-page h1 {
      color: #e94560;
      font-size: clamp(28px, 5vw, 32px);
      margin-bottom: 8px;
    }
    .legal-page .last-updated {
      color: #888;
      font-size: 14px;
      margin-bottom: 40px;
    }
    .legal-page section { margin-bottom: 32px; }
    .legal-page h2 {
      color: #fafafa;
      font-size: 20px;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    .legal-page p, .legal-page li {
      color: #d4d4d8;
      line-height: 1.8;
    }
    .legal-page ul {
      margin-left: 24px;
      margin-bottom: 12px;
    }
    .legal-page li { margin-bottom: 8px; }
    .legal-page a {
      color: #4fc3f7;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .legal-page a:hover { color: #e94560; }
    .legal-page strong { color: #fafafa; }
    .legal-divider {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    /* Warning callout - dark theme safe */
    .warning-callout {
      background: rgba(255, 193, 7, 0.1);
      border: 1px solid rgba(255, 193, 7, 0.3);
      border-left: 4px solid #ffc107;
      padding: 20px;
      margin-bottom: 24px;
      border-radius: 0 12px 12px 0;
    }
    .warning-callout strong {
      display: block;
      margin-bottom: 8px;
      color: #ffc107;
    }
    .warning-callout p {
      color: #d4d4d8;
      margin: 0;
      line-height: 1.6;
    }
    @media (max-width: 768px) {
      .legal-page {
        padding: 80px 16px 60px;
      }
      .legal-page h1 { font-size: 24px; }
      .legal-page h2 { font-size: 18px; }
    }
  </style>
</head>
<body style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: #0a0a0b; color: #fafafa; line-height: 1.6; margin: 0; padding: 0; overflow-x: hidden;">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content" class="legal-page">
    <a href="/" class="back-link">← Back to Blog</a>
    
    <h1>Disclaimer</h1>
    <p class="last-updated">Last Updated: April 23, 2026</p>
    
    <div class="warning-callout">
      <strong>⚠️ IMPORTANT: PLEASE READ THIS DISCLAIMER CAREFULLY</strong>
      <p>The content on CC3PO Insights is provided for informational and educational purposes only. By using this blog, you acknowledge and agree to the following disclaimers.</p>
    </div>
    
    <section>
      <h2>1. General Disclaimer</h2>
      <p>All content on this blog is provided "as is" without warranty of any kind. CC3PO makes no representations or warranties about:</p>
      <ul>
        <li>Accuracy, completeness, or suitability of the information</li>
        <li>Results that may be obtained from using the information</li>
        <li>Freedom from errors or omissions</li>
      </ul>
    </section>
    
    <section>
      <h2>2. Technical Guidance Disclaimer</h2>
      <p>Technical tutorials and guides are provided for educational purposes. Results may vary based on:</p>
      <ul>
        <li>Your specific environment and configuration</li>
        <li>Version differences in software or tools</li>
        <li>Third-party dependencies and integrations</li>
        <li>Your level of technical expertise</li>
      </ul>
      <p><strong>Always back up your data before implementing technical changes.</strong></p>
    </section>
    
    <section>
      <h2>3. No Professional Advice</h2>
      <p>The content on this blog does not constitute:</p>
      <ul>
        <li>Legal advice</li>
        <li>Financial advice</li>
        <li>Medical advice</li>
        <li>Professional certification or endorsement</li>
      </ul>
      <p>For professional matters, consult qualified professionals in those fields.</p>
    </section>
    
    <section>
      <h2>4. Third-Party References</h2>
      <p>Articles may reference third-party tools, services, or websites. We are not responsible for:</p>
      <ul>
        <li>Availability or reliability of third-party services</li>
        <li>Changes to third-party APIs or functionality</li>
        <li>Third-party privacy practices or policies</li>
        <li>Damages from using third-party services</li>
      </ul>
    </section>
    
    <section>
      <h2>5. Limitation of Liability</h2>
      <p><strong>TO THE MAXIMUM EXTENT PERMITTED BY LAW:</strong></p>
      <ul>
        <li>CC3PO shall not be liable for any direct, indirect, incidental, special, or consequential damages</li>
        <li>We are not liable for data loss, system failures, or security breaches</li>
        <li>You use this blog and its content at your own risk</li>
      </ul>
    </section>
    
    <section>
      <h2>6. Contact Information</h2>
      <p>For questions about this Disclaimer:</p>
      <ul>
        <li>Email: <a href="mailto:legal@cc3po.com">legal@cc3po.com</a></li>
        <li>Main Site: <a href="https://cc3po.com">cc3po.com</a></li>
        <li>Services: <a href="https://offers.cc3po.com">offers.cc3po.com</a></li>
      </ul>
    </section>
    
    <div class="legal-divider">
      <a href="/" class="back-link">← Back to Blog</a>
    </div>
  </main>
  <Footer />
</body>
</html>