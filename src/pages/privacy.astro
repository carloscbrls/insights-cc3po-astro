---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';

const title = "Privacy Policy | CC3PO Insights";
const description = "Privacy Policy for CC3PO Insights blog and content.";
---

<!doctype html>
<html lang="en">
<head>
  <BaseHead title={title} description={description} />
  <style>
    .legal-page {
      max-width: 800px;
      margin: 0 auto;
      padding: 100px 24px 60px;
    }
    .back-link {
      display: inline-flex;
      align-items: center;
      gap: 8px;
      color: #d4d4d8;
      font-size: 14px;
      font-weight: 500;
      text-decoration: none;
      padding: 10px 20px;
      background: rgba(255,255,255,0.05);
      border: 1px solid rgba(255,255,255,0.08);
      border-radius: 12px;
      margin-bottom: 24px;
      transition: all 0.2s;
    }
    .back-link:hover { background: rgba(107,53,255,.1); border-color: rgba(107,53,255,.3); color: #fff; }
    .legal-page h1 {
      color: #e94560;
      font-size: clamp(28px, 5vw, 32px);
      margin-bottom: 8px;
    }
    .legal-page .last-updated {
      color: #888;
      font-size: 14px;
      margin-bottom: 40px;
    }
    .legal-page section { margin-bottom: 32px; }
    .legal-page h2 {
      color: #fafafa;
      font-size: 20px;
      margin-top: 32px;
      margin-bottom: 12px;
    }
    .legal-page p, .legal-page li {
      color: #d4d4d8;
      line-height: 1.8;
    }
    .legal-page ul {
      margin-left: 24px;
      margin-bottom: 12px;
    }
    .legal-page li { margin-bottom: 8px; }
    .legal-page a {
      color: #4fc3f7;
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .legal-page a:hover { color: #e94560; }
    .legal-page strong { color: #fafafa; }
    .legal-divider {
      margin-top: 48px;
      padding-top: 24px;
      border-top: 1px solid rgba(255,255,255,0.06);
    }
    @media (max-width: 768px) {
      .legal-page {
        padding: 80px 16px 60px;
      }
      .legal-page h1 { font-size: 24px; }
      .legal-page h2 { font-size: 18px; }
    }
  </style>
</head>
<body style="font-family: 'Inter', -apple-system, BlinkMacSystemFont, sans-serif; background: #0a0a0b; color: #fafafa; line-height: 1.6; margin: 0; padding: 0; overflow-x: hidden;">
  <a href="#main-content" class="skip-link">Skip to main content</a>
  <Header />
  <main id="main-content" class="legal-page">
    <a href="/" class="back-link">← Back to Blog</a>
    
    <h1>Privacy Policy</h1>
    <p class="last-updated">Last Updated: April 23, 2026</p>
    
    <section>
      <h2>1. Information We Collect</h2>
      <p>When you visit CC3PO Insights, we may collect:</p>
      <ul>
        <li><strong>Usage Data:</strong> Pages visited, time spent, search queries</li>
        <li><strong>Device Information:</strong> Browser type, device type, screen resolution</li>
        <li><strong>Email Address:</strong> If you subscribe to our newsletter</li>
        <li><strong>Cookies:</strong> Session cookies for functionality</li>
      </ul>
    </section>
    
    <section>
      <h2>2. How We Use Information</h2>
      <p>We use collected information to:</p>
      <ul>
        <li>Improve content quality and relevance</li>
        <li>Analyze which topics are most helpful</li>
        <li>Send email updates (if subscribed)</li>
        <li>Provide technical support when requested</li>
      </ul>
    </section>
    
    <section>
      <h2>3. Email Subscriptions</h2>
      <p>If you subscribe to our newsletter:</p>
      <ul>
        <li>We store your email address securely</li>
        <li>We send blog updates and related content</li>
        <li>We do not sell or share your email with third parties</li>
        <li>You can unsubscribe at any time via link in emails</li>
      </ul>
    </section>
    
    <section>
      <h2>4. Cookies and Tracking</h2>
      <p>We use cookies for:</p>
      <ul>
        <li><strong>Session Management:</strong> Remembering your preferences</li>
        <li><strong>Analytics:</strong> Understanding how content is used</li>
        <li><strong>Functionality:</strong> Search and navigation</li>
      </ul>
      <p style="margin-top: 12px;">You can disable cookies in your browser settings. The blog will remain accessible.</p>
    </section>
    
    <section>
      <h2>5. Contact Information</h2>
      <p>For questions about this Privacy Policy:</p>
      <ul>
        <li>Email: <a href="mailto:privacy@cc3po.com">privacy@cc3po.com</a></li>
        <li>Main Site: <a href="https://cc3po.com/privacy-policy/">cc3po.com/privacy-policy/</a></li>
      </ul>
    </section>
    
    <div class="legal-divider">
      <a href="/" class="back-link">← Back to Blog</a>
    </div>
  </main>
  <Footer />
</body>
</html>