---
import Layout from '../../layouts/Layout.astro';
import PostCard from '../../components/PostCard.astro';
import { getPosts, authorsWithPosts } from '../../lib/blog';

export async function getStaticPaths() {
  const all = await getPosts();
  return authorsWithPosts(all).map((a) => ({ params: { author: a.slug }, props: { author: a } }));
}

const { author } = Astro.props;
---

<Layout title={`${author.name} — CC3PO Insights`} description={`Posts by ${author.name} on CC3PO Insights.`}>
<section class="cc-section">
  <div class="cc-container">
    <div class="cc-section-label">Author</div>
    <div class="cc-section-header">
      <h1 class="cc-section-title">{author.name}</h1>
      {author.role && <p class="cc-section-desc">{author.role}</p>}
    </div>
    {author.slug === 'quill' && (
      <p class="cc-section-desc"><a href="https://dontloseyourway.com/?utm_source=insights&utm_medium=author_page&utm_campaign=dlyw-story">Don't Lose Your Way</a> — A quiet space for reflection. This space exists for people who almost gave up — and stayed.</p>
    )}
    <div class="cc-posts-grid">
      {author.posts.map((post) => <PostCard post={post} />)}
    </div>
    <p class="cc-team-more"><a href="/archive/">Browse the full archive →</a> · <a href="/">Back to the homepage →</a></p>
  </div>
</section>
</Layout>
